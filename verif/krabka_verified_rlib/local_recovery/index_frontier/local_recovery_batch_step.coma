type t_Option_i64 = None'2 | Some'2 Int64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX'0: Int64.t = (9223372036854775807: Int64.t)

let restore_batch_step (minimum_base: Int64.t) (base: Int64.t) (last_delta: Int32.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:restore_batch_step ensures] [%#srecord_coordinates] match result with
      | Some'2 next -> ge_log_Int (Int32.to_int last_delta) 0
      /\ ge_log_Int (Int64.to_int base) (Int64.to_int minimum_base)
      /\ Int64.to_int next = Int64.to_int base + Int32.to_int last_delta + 1
      /\ gt_log_Int (Int64.to_int next) (Int64.to_int base) /\ Int64.to_int next <= Int64.to_int const_MAX'0
      | None'2 -> Int32.to_int last_delta < 0
      \/ Int64.to_int base < Int64.to_int minimum_base
      \/ gt_log_Int (Int64.to_int base + Int32.to_int last_delta + 1) (Int64.to_int const_MAX'0)
      end}
    (! return {result}) ]

