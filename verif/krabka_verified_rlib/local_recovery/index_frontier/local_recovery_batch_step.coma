type t_Option_LocalRecoveryStep = None | Some t_LocalRecoveryStep

type t_Option_u64 = None'0 | Some'0 UInt64.t

constant const_MIN: UInt64.t = (0: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let checked_add (self_: UInt64.t) (rhs: UInt64.t) (return (x: t_Option_u64)) = any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None'0)
      = (UInt64.t'int self_ + UInt64.t'int rhs < UInt64.t'int const_MIN
      \/ gt_log_Int (UInt64.t'int self_ + UInt64.t'int rhs) (UInt64.t'int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: UInt64.t. result = Some'0 r
      -> UInt64.t'int r = UInt64.t'int self_ + UInt64.t'int rhs)}
    (! return {result}) ]

type t_Option_Infallible = None'1 | Some'1 ()

type t_ControlFlow_Option_Infallible_u64 = Continue UInt64.t | Break t_Option_Infallible

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Option_Infallible (_1: t_Option_Infallible)

axiom inv_axiom [@rewrite]: forall x: t_Option_Infallible [inv_Option_Infallible x]. inv_Option_Infallible x
    = match x with
      | None'1 -> true
      | Some'1 f0 -> inv_Infallible f0
      end

predicate inv_ControlFlow_Option_Infallible_u64 (_1: t_ControlFlow_Option_Infallible_u64)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Option_Infallible_u64 [inv_ControlFlow_Option_Infallible_u64 x]. inv_ControlFlow_Option_Infallible_u64 x
    = match x with
      | Continue f0 -> true
      | Break f0 -> inv_Option_Infallible f0
      end

let branch_Option_u64 (self_: t_Option_u64) (return (x: t_ControlFlow_Option_Infallible_u64)) = any
  [ return (result: t_ControlFlow_Option_Infallible_u64) ->
  {[@stop_split] [@expl:branch_Option_u64 ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Option_Infallible_u64 result)
    /\ ([@stop_split] [@expl:branch ensures] [%#sops] match self_ with
      | Some'0 v -> result = Continue v
      | None'0 -> result = Break (None'1)
      end)}
    (! return {result}) ]

let elim_Break (_x: t_ControlFlow_Option_Infallible_u64) (return (f0: t_Option_Infallible)) = any
  [ _k (f0: t_Option_Infallible) -> {Break f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

let from_residual_Option_LocalRecoveryStep (residual: t_Option_Infallible) (return (x: t_Option_LocalRecoveryStep)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] [%#sops'0] inv_Option_Infallible residual}
  any
  [ return (result: t_Option_LocalRecoveryStep) -> {[@stop_split] [@expl:from_residual ensures] [%#sops'1] result
    = None}
