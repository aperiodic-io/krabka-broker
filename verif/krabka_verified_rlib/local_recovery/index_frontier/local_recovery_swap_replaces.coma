(* #"/workspace/crates/verified/src/local_recovery/index_frontier.rs" 54 0 58 9 *)

let%span sindex_frontier = "/workspace/crates/verified/src/local_recovery/index_frontier.rs" 59 4 59 87
let%span sindex_frontier'0 = "/workspace/crates/verified/src/local_recovery/index_frontier.rs" 59 33 59 87
let%span sindex_frontier'1 = "/workspace/crates/verified/src/local_recovery/index_frontier.rs" 51 10 52 66

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let local_recovery_swap_replaces [#"/workspace/crates/verified/src/local_recovery/index_frontier.rs" 54 0 58 9]
  (swap_base: Int64.t) (swap_next: Int64.t) (segment_base: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_8 <- segment_base = swap_base ] s1 | s1 = any [ br0 -> {_8 = false} (! bb2) | br1 -> {_8} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- [%#sindex_frontier] true ] s1 | s1 = return {_ret} ]
  | bb2 = s0
    [ s0 = [ &_11 <- Int64.lt swap_base segment_base ] s1
    | s1 = any [ br0 -> {_11 = false} (! bb4) | br1 -> {_11} (! bb3) ] ]
  | bb3 = s0 [ s0 = [ &_ret <- Int64.lt segment_base swap_next ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#sindex_frontier'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & swap_base: Int64.t = swap_base
  | & swap_next: Int64.t = swap_next
  | & segment_base: Int64.t = segment_base
  | & _8: bool = Any.any_l ()
  | & _11: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:local_recovery_swap_replaces ensures] [%#sindex_frontier'1] result
    = (Int64.to_int segment_base = Int64.to_int swap_base
    \/ Int64.to_int swap_base < Int64.to_int segment_base /\ Int64.to_int segment_base < Int64.to_int swap_next)}
    (! return {result}) ]
