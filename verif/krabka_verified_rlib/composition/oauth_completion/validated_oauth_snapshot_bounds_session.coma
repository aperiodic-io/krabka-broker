type t_JwksCacheFacts = {
  generation_before: UInt64.t;
  generation_after: UInt64.t;
  last_successful_fetch_ms: Int64.t;
  now_ms: Int64.t;
  expiry_enabled: bool;
  expiry_ms: Int64.t }

type t_Option_JwksCacheFacts = None | Some t_JwksCacheFacts

let elim_Some (_x: t_Option_JwksCacheFacts) (return (f0: t_JwksCacheFacts)) = any
  [ _k (f0: t_JwksCacheFacts) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_JwksCacheDecision = Reject | Admit

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

let jwks_cache_admission (facts: t_JwksCacheFacts) (return (x: t_JwksCacheDecision)) = any
  [ return (result: t_JwksCacheDecision) -> {[@stop_split] [@expl:jwks_cache_admission ensures] [%#sjwks] (result
      = Admit)
    = (ComputerDivision.mod (UInt64.t'int facts.generation_before) 2 = 0
    /\ UInt64.t'int facts.generation_before = UInt64.t'int facts.generation_after
    /\ (not facts.expiry_enabled
    \/ ge_log_Int (Int64.to_int facts.expiry_ms) 0
    /\ gt_log_Int (Int64.to_int facts.last_successful_fetch_ms) 0
    /\ ge_log_Int (Int64.to_int facts.now_ms) (Int64.to_int facts.last_successful_fetch_ms)
    /\ Int64.to_int facts.now_ms - Int64.to_int facts.last_successful_fetch_ms <= Int64.to_int facts.expiry_ms))}
    (! return {result}) ]

type t_OAuthSessionDecision = Reject'0 | Admit'0 Int64.t Int64.t

type tup2_i64_u64 = { f0: Int64.t; f1: UInt64.t }

type t_OAuthExpiryPresence = Missing | Present

type t_OAuthSessionCap = Disabled | Enabled

type t_OAuthAuthenticationKind = Initial | Reauthentication

type t_OAuthPrincipalMatch = Matches | Differs

type t_OAuthSessionFacts = {
  expiry'0: t_OAuthExpiryPresence;
  token_expires_at_ms'0: Int64.t;
  now_ms'0: Int64.t;
  cap'0: t_OAuthSessionCap;
  cap_ms'0: Int64.t;
  authentication'0: t_OAuthAuthenticationKind;
  principal'0: t_OAuthPrincipalMatch }

let oauth_validation_admission (started_ms: Int64.t) (completed_ms: Int64.t) (cache: t_Option_JwksCacheFacts)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:oauth_validation_admission ensures] [%#scompletion] result
    = (ge_log_Int (Int64.to_int started_ms) 0
    /\ ge_log_Int (Int64.to_int completed_ms) (Int64.to_int started_ms)
    /\ match cache with
      | None -> true
      | Some facts -> ComputerDivision.mod (UInt64.t'int facts.generation_before) 2 = 0
      /\ UInt64.t'int facts.generation_before = UInt64.t'int facts.generation_after
      /\ (not facts.expiry_enabled
      \/ ge_log_Int (Int64.to_int facts.expiry_ms) 0
      /\ gt_log_Int (Int64.to_int facts.last_successful_fetch_ms) 0
      /\ ge_log_Int (Int64.to_int completed_ms) (Int64.to_int facts.last_successful_fetch_ms)
      /\ Int64.to_int completed_ms - Int64.to_int facts.last_successful_fetch_ms <= Int64.to_int facts.expiry_ms)
      end)}
    (! return {result}) ]

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate oauth_session_admissible_at [#"/workspace/crates/verified/src/oauth.rs" 56 0 56 85] (facts: t_OAuthSessionFacts) (now: int) =
  [%#soauth'0] facts.expiry'0 = Present
  /\ gt_log_Int (Int64.to_int facts.token_expires_at_ms'0) now
  /\ Int64.to_int facts.token_expires_at_ms'0 - now <= Int64.to_int const_MAX
  /\ (facts.cap'0 = Disabled \/ gt_log_Int (Int64.to_int facts.cap_ms'0) 0)
  /\ (facts.authentication'0 = Initial \/ facts.principal'0 = Matches)

predicate oauth_session_admissible [#"/workspace/crates/verified/src/oauth.rs" 76 0 76 65] (facts: t_OAuthSessionFacts) =
  [%#soauth'1] oauth_session_admissible_at facts (Int64.to_int facts.now_ms'0)

function oauth_session_lifetime [#"/workspace/crates/verified/src/oauth.rs" 86 0 86 62] (facts: t_OAuthSessionFacts) : int
 = [%#soauth'2] let token_lifetime = Int64.to_int facts.token_expires_at_ms'0
  - Int64.to_int facts.now_ms'0 in if facts.cap'0 = Enabled /\ Int64.to_int facts.cap_ms'0 < token_lifetime then
    Int64.to_int facts.cap_ms'0
  else
    token_lifetime


let oauth_session_admission (facts: t_OAuthSessionFacts) (return (x: t_OAuthSessionDecision)) = any
  [ return (result: t_OAuthSessionDecision) ->
  {[@stop_split] [@expl:oauth_session_admission ensures] [%#soauth] match result with
      | Reject'0 -> not oauth_session_admissible facts
      | Admit'0 session_lifetime_ms effective_expires_at_ms -> oauth_session_admissible facts
      /\ Int64.to_int session_lifetime_ms = oauth_session_lifetime facts
      /\ Int64.to_int effective_expires_at_ms = Int64.to_int facts.now_ms'0 + Int64.to_int session_lifetime_ms
      end}
    (! return {result}) ]

predicate completed_snapshot_admissible [#"/workspace/crates/verified/src/composition/oauth_completion.rs" 19 0 23 9] (cache: t_Option_JwksCacheFacts) (started_ms: Int64.t) (completed: tup2_i64_u64) =
  [%#soauth_completion'5] ge_log_Int (Int64.to_int started_ms) 0
  /\ ge_log_Int (Int64.to_int completed.f0) (Int64.to_int started_ms)
  /\ match cache with
    | None -> true
    | Some c -> ComputerDivision.mod (UInt64.t'int c.generation_before) 2 = 0
    /\ UInt64.t'int c.generation_before = UInt64.t'int c.generation_after
    /\ UInt64.t'int c.generation_before = UInt64.t'int completed.f1
    /\ (not c.expiry_enabled
    \/ ge_log_Int (Int64.to_int c.expiry_ms) 0
    /\ gt_log_Int (Int64.to_int c.last_successful_fetch_ms) 0
    /\ ge_log_Int (Int64.to_int started_ms) (Int64.to_int c.last_successful_fetch_ms)
    /\ Int64.to_int completed.f0 - Int64.to_int c.last_successful_fetch_ms <= Int64.to_int c.expiry_ms)
    end

