  | & now: Int64.t = now
  | & _8: t_Option_usize = Any.any_l ()
  | & index: UInt64.t = Any.any_l ()
  | & _13: Int64.t = Any.any_l ()
  | & _14: UInt64.t = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _16: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:segment_maximum_proves_delivery ensures] [%#sdelivery'4] result
