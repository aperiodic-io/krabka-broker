type t_Option_usize = None | Some UInt64.t

let earliest_max_timestamp_index (timestamps: Slice64.slice Int64.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:earliest_max_timestamp_index ensures] [%#stimestamp] match result with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view timestamps)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view timestamps)
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i)
          <= Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))
        /\ (forall i'0: int. 0 <= i'0 /\ i'0 < UInt64.t'int index
          -> Int64.to_int (Seq.get (Slice64.view timestamps) i'0)
          < Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))))
      | None -> Seq.length (Slice64.view timestamps) = 0
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_usize) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let scheduled_delivery_visible (scheduled: bool) (uncertainty_ms: Int64.t) (activation_ms: Int64.t) (now_ms: Int64.t)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:scheduled_delivery_visible ensures] [%#sdelivery'5] result
    = (not scheduled
    \/ ge_log_Int (Int64.to_int uncertainty_ms) 0
    /\ Int64.to_int activation_ms + Int64.to_int uncertainty_ms <= Int64.to_int const_MAX
    /\ Int64.to_int activation_ms + Int64.to_int uncertainty_ms <= Int64.to_int now_ms)}
    (! return {result}) ]

