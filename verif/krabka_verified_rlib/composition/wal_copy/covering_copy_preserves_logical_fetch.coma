      | Complete done' -> ge_log_Int (Int64.to_int requested) 0
      /\ ge_log_Int (Int64.to_int wal_start) 0
      /\ ge_log_Int (Int64.to_int local_start) 0
      /\ Int64.to_int wal_start = frontier /\ Int64.to_int local_start = frontier /\ Int64.to_int done' = frontier
