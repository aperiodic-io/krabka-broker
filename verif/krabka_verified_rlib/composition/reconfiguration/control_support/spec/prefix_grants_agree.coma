use creusot.int.UInt64
use seq.Seq
use creusot.int.Int64
use int.Int

type tup2_bool_bool = { f0: bool; f1: bool }

type tup2_i64_i64 = { f0'0: Int64.t; f1'0: Int64.t }

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate has_node [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 32 0 32 63] (nodes: Seq.seq UInt64.t) (count: int) (node: UInt64.t) =
  [%#sspec'9] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

predicate expected_member [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 56 0 62 9] (nodes: Seq.seq UInt64.t) (count: int) (kind: t_VoterChangeKind) (target: UInt64.t) (node: UInt64.t) =
  [%#sspec'10] match kind with
    | Add -> has_node nodes count node \/ node = target
    | Remove -> has_node nodes count node /\ node <> target
    | Update | FinalizeKraftVersion -> has_node nodes count node
    end

predicate membership_matches_change [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 143 0 148 9] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (kind: t_VoterChangeKind) (node: UInt64.t) =
  [%#sspec'4] forall id: UInt64.t. has_node next (Seq.length next) id
    = expected_member old' (Seq.length old') kind node id

function grant_count [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 83 0 90 8] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (votes: Seq.seq tup2_bool_bool) (node: UInt64.t) (new: bool) (count: int) : int

axiom grant_count_def:
  forall old': Seq.seq UInt64.t, next: Seq.seq UInt64.t, votes: Seq.seq tup2_bool_bool, node: UInt64.t, new: bool, count: int [grant_count old' next votes node new count]. grant_count old' next votes node new count
    = ([%#sspec'6] if count <= 0 then
      0
    else
      grant_count old' next votes node new (count - 1)
      + (if new then
        if (Seq.get votes (count - 1)).f1
        /\ (if count - 1 < Seq.length old' then
          has_node next (Seq.length next) (Seq.get old' (count - 1))
        else
          not has_node old' (Seq.length old') node /\ has_node next (Seq.length next) node
        ) then
          1
        else
          0

      else
        if count - 1 < Seq.length old' /\ (Seq.get votes (count - 1)).f0 then 1 else 0
      )
    )

function prefix_count [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 28 0 36 8] (old': Seq.seq UInt64.t) (reports: Seq.seq tup2_i64_i64) (kind: t_VoterChangeKind) (node: UInt64.t) (end': int) (new: bool) (count: int) : int

axiom prefix_count_def:
  forall old': Seq.seq UInt64.t, reports: Seq.seq tup2_i64_i64, kind: t_VoterChangeKind, node: UInt64.t, end': int, new: bool, count: int [prefix_count old' reports kind node end' new count]. prefix_count old' reports kind node end' new count
    = ([%#sspec'8] if count <= 0 then
      0
    else
      prefix_count old' reports kind node end' new (count - 1)
      + (if count - 1 < Seq.length old' then
        if new then
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'0) end'
          /\ expected_member old' (Seq.length old') kind node (Seq.get old' (count - 1)) then
            1
          else
            0

        else
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f0'0) end' then 1 else 0

      else
        if new
        /\ ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'0) end'
        /\ not has_node old' (Seq.length old') node /\ expected_member old' (Seq.length old') kind node node then
          1
        else
          0

      )
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant old' : Seq.seq UInt64.t

constant next : Seq.seq UInt64.t

constant votes : Seq.seq tup2_bool_bool

constant reports : Seq.seq tup2_i64_i64

constant kind : t_VoterChangeKind

constant node : UInt64.t

constant end' : int

constant new : bool

constant count : int

function prefix_grants_agree [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 78 0 88 1] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (votes: Seq.seq tup2_bool_bool) (reports: Seq.seq tup2_i64_i64) (kind: t_VoterChangeKind) (node: UInt64.t) (end': int) (new: bool) (count: int) : ()

goal vc_prefix_grants_agree: ([%#sspec'0] 0 <= count
    /\ count <= Seq.length votes /\ Seq.length votes = Seq.length reports)
  -> ([%#sspec'1] forall i: int. 0 <= i /\ i < Seq.length votes
      -> (Seq.get votes i).f0 = ge_log_Int (Int64.to_int (Seq.get reports i).f0'0) end'
      /\ (Seq.get votes i).f1 = ge_log_Int (Int64.to_int (Seq.get reports i).f1'0) end')
  -> ([%#sspec'2] membership_matches_change old' next kind node)
  -> (if gt_log_Int count 0 then
    (([@stop_split] [@expl:prefix_grants_agree requires] ([@stop_split] [@expl:prefix_grants_agree requires #0] [%#sspec'0] 0
            <= count - 1
          /\ count - 1 <= Seq.length votes /\ Seq.length votes = Seq.length reports)
        /\ ([@stop_split] [@expl:prefix_grants_agree requires #1] [%#sspec'1] forall i: int. 0 <= i
              /\ i < Seq.length votes
            -> (Seq.get votes i).f0 = ge_log_Int (Int64.to_int (Seq.get reports i).f0'0) end'
            /\ (Seq.get votes i).f1 = ge_log_Int (Int64.to_int (Seq.get reports i).f1'0) end')
        /\ ([@stop_split] [@expl:prefix_grants_agree requires #2] [%#sspec'2] membership_matches_change old' next kind node))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sspec] count) ([%#sspec] count - 1)))
    /\ (([@stop_split] [@expl:prefix_grants_agree ensures] [%#sspec'3] grant_count old' next votes node new (count - 1)
      = prefix_count old' reports kind node end' new (count - 1))
    -> (let _ = prefix_grants_agree old' next votes reports kind node end' new (count
    - 1) in [@stop_split] [@expl:prefix_grants_agree ensures] [%#sspec'3] grant_count old' next votes node new count
    = prefix_count old' reports kind node end' new count))
  else
    [@stop_split] [@expl:prefix_grants_agree ensures] [%#sspec'3] grant_count old' next votes node new count
    = prefix_count old' reports kind node end' new count
  )
