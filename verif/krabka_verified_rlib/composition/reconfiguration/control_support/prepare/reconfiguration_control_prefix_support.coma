predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

type tup2_u64_u64 = { f0'1: UInt64.t; f1'1: UInt64.t }

predicate pairwise_u64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq UInt64.t) (relation: Map.map tup2_u64_u64 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0'1 = Seq.get values i; f1'1 = Seq.get values j }

predicate distinct_u64 [#"/workspace/crates/verified/src/sequence.rs" 6 0 6 42] (values: Seq.seq UInt64.t) =
  [%#ssequence] pairwise_u64 values (fun (__0: tup2_u64_u64) -> let {f0'1 = left; f1'1 = right} = __0 in left <> right)

predicate valid_old [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 38 0 38 41] (nodes: Seq.seq UInt64.t) =
  [%#sspec'21] gt_log_Int (Seq.length nodes) 0 /\ distinct_u64 nodes

predicate has_node [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 32 0 32 63] (nodes: Seq.seq UInt64.t) (count: int) (node: UInt64.t) =
  [%#sspec'17] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

predicate membership_coherent [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 44 0 49 9] (nodes: Seq.seq UInt64.t) (node: UInt64.t) (membership'0: t_TargetMembership) (kind'0: t_VoterChangeKind) =
  [%#sspec'22] kind'0 = FinalizeKraftVersion \/ has_node nodes (Seq.length nodes) node = (membership'0 <> Absent)

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_Option_VoterReconfigurationDecision = None'0 | Some'0 t_VoterReconfigurationDecision

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate voter_set_removes [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 42 0 42 87] (membership'0: t_TargetMembership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'2] membership'0 = PresentSameDirectory /\ gt_log_Int (UInt64.t'int voters.voter_count) 1

predicate update_key_matches [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 59 0 59 63] (membership'0: t_TargetMembership) =
  [%#sadmitted_plan'3] membership'0 = PresentUnknownDirectory \/ membership'0 = PresentSameDirectory

function voter_reconfiguration_rejection [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 82 0 87 41] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) : t_Option_VoterReconfigurationDecision
 = [%#sadmitted_plan'0] if not leadership.is_leader then
    Some'0 (NotLeader)
  else
    if not leadership.no_pending_change then
      Some'0 (InProgress)
    else
      if not leadership.epoch_committed then
        Some'0 (EpochUncommitted)
      else
        if not voters.latest_controls_committed then
          Some'0 (InProgress)
        else
          if UInt64.t'int voters.voter_count = 0 then
            Some'0 (EmptyCurrentVoterSet)
          else
            if gt_log_Int (UInt16.t'int voters.kraft_version) 1 then
              Some'0 (InvalidVersionTransition)
            else
              match request.kind with
                | Add -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'0 (UnsupportedKraftVersion)
                else
                  if target.membership <> Absent then
                    Some'0 (DuplicateVoter)
                  else
                    if not target.version_compatible then
                      Some'0 (IncompatibleVoter)
                    else
                      if not target.caught_up then
                        Some'0 (VoterNotCaughtUp)
                      else
                        if UInt64.t'int voters.voter_count = UInt64.t'int const_MAX then
                          Some'0 (InvalidVersionTransition)
                        else
                          None'0





                | Remove -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'0 (UnsupportedKraftVersion)
                else
                  if not voter_set_removes target.membership voters then Some'0 (VoterNotFound) else None'0

                | Update -> if not target.version_compatible then
                  Some'0 (IncompatibleVoter)
                else
                  if target.membership = Absent then
                    Some'0 (VoterNotFound)
                  else
                    if not update_key_matches target.membership then Some'0 (DirectoryMismatch) else None'0


                | FinalizeKraftVersion -> if UInt16.t'int voters.kraft_version <> 0
                \/ UInt16.t'int request.requested_kraft_version <> 1 then
                  Some'0 (InvalidVersionTransition)
                else
                  if not voters.all_voters_support_requested then Some'0 (IncompatibleVoter) else None'0

                end







predicate reconfiguration_admitted [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 13 0 20 9] (old': Seq.seq UInt64.t) (node: UInt64.t) (leadership: t_ReconfigurationLeadership) (context: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) =
  [%#sspec'12] valid_old old'
  /\ membership_coherent old' node target.membership request.kind
  /\ match voter_reconfiguration_rejection leadership context request target with
    | None'0 -> true
    | Some'0 _ -> false
    end

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 158 0 162 9] (voters: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan] match kind'0 with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

predicate may_reconfigure [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 14 0 14 94] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'1] leadership.is_leader
  /\ leadership.no_pending_change /\ leadership.epoch_committed /\ voters.latest_controls_committed

predicate admitted_membership [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 129 0 135 9] (context: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) (leadership: t_ReconfigurationLeadership) (next: Seq.seq UInt64.t) =
  [%#sspec'13] admitted_plan context kind'0 plan
  /\ may_reconfigure leadership context
  /\ Seq.length next = UInt64.t'int plan.next_voter_count /\ gt_log_Int (Seq.length next) 0

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec'3] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate expected_member [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 56 0 62 9] (nodes: Seq.seq UInt64.t) (count: int) (kind'0: t_VoterChangeKind) (target: UInt64.t) (node: UInt64.t) =
  [%#sspec'20] match kind'0 with
    | Add -> has_node nodes count node \/ node = target
    | Remove -> has_node nodes count node /\ node <> target
    | Update | FinalizeKraftVersion -> has_node nodes count node
    end

predicate membership_matches_change [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 143 0 148 9] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (kind'0: t_VoterChangeKind) (node: UInt64.t) =
  [%#sspec'8] forall id: UInt64.t. has_node next (Seq.length next) id
    = expected_member old' (Seq.length old') kind'0 node id

predicate single_change_shape [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 113 0 118 9] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (kind'0: t_VoterChangeKind) (node: UInt64.t) =
  [%#sspec'14] Seq.length old' - 1 <= Seq.length next
  /\ Seq.length next <= Seq.length old' + 1 /\ membership_matches_change old' next kind'0 node /\ distinct_u64 next

let constructed_voter_reconfiguration (old': Slice64.slice UInt64.t) (leadership: t_ReconfigurationLeadership)
  (context: t_CurrentVoterSet) (request: t_VoterChangeRequest) (node: UInt64.t) (target: t_TargetVoter)
  (return (x: t_Option_tup2_VoterReconfigurationPlan_Vec_u64_Global)) =
{[@stop_split] [@expl:constructed_voter_reconfiguration requires] [%#smembership] UInt64.t'int context.voter_count
  = Seq.length (Slice64.view old')}
  any
  [ return (result: t_Option_tup2_VoterReconfigurationPlan_Vec_u64_Global) ->
  {[@stop_split] [@expl:constructed_voter_reconfiguration ensures] ([@stop_split] [@expl:constructed_voter_reconfiguration ensures #0] [%#smembership'0] (result
        <> None)
      = reconfiguration_admitted (Slice64.view old') node leadership context request target)
    /\ ([@stop_split] [@expl:constructed_voter_reconfiguration ensures #1] [%#smembership'1] match result with
      | None -> true
      | Some {f0'0 = plan; f1'0 = next} -> admitted_membership context request.kind plan leadership (view_Vec_u64_Global next)
      /\ single_change_shape (Slice64.view old') (view_Vec_u64_Global next) request.kind node
      /\ match request.kind with
        | Add -> Seq.length (view_Vec_u64_Global next) = Seq.length (Slice64.view old') + 1
        | Remove -> Seq.length (view_Vec_u64_Global next) + 1 = Seq.length (Slice64.view old')
        | Update | FinalizeKraftVersion -> Seq.length (view_Vec_u64_Global next) = Seq.length (Slice64.view old')
        end
      end)}
    (! return {result}) ]

type t_Option_Infallible = None'1 | Some'1 ()

type t_ControlFlow_Option_Infallible_tup2_VoterReconfigurationPlan_Vec_u64_Global =
  | Continue tup2_VoterReconfigurationPlan_Vec_u64_Global
