predicate control_inputs_coherent [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 112 0 116 9] (old': Seq.seq UInt64.t) (context: t_CurrentVoterSet) (reports: Seq.seq tup2_i64_i64) =
  [%#sspec] UInt64.t'int context.voter_count = Seq.length old' /\ Seq.length reports = Seq.length old' + 1

type tup2_u64_TargetVoter = { f0'5: UInt64.t; f1'5: t_TargetVoter }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

type tup2_u64_u64 = { f0'6: UInt64.t; f1'6: UInt64.t }

predicate pairwise_u64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq UInt64.t) (relation: Map.map tup2_u64_u64 bool) =
  [%#ssequence'1] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0'6 = Seq.get values i; f1'6 = Seq.get values j }

predicate distinct_u64 [#"/workspace/crates/verified/src/sequence.rs" 6 0 6 42] (values: Seq.seq UInt64.t) =
  [%#ssequence] pairwise_u64 values (fun (__0: tup2_u64_u64) -> let {f0'6 = left; f1'6 = right} = __0 in left <> right)

predicate valid_old [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 38 0 38 41] (nodes: Seq.seq UInt64.t) =
  [%#sspec'11] gt_log_Int (Seq.length nodes) 0 /\ distinct_u64 nodes

predicate has_node [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 32 0 32 63] (nodes: Seq.seq UInt64.t) (count: int) (node: UInt64.t) =
  [%#sspec'9] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

predicate membership_coherent [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 44 0 49 9] (nodes: Seq.seq UInt64.t) (node: UInt64.t) (membership'0: t_TargetMembership) (kind'0: t_VoterChangeKind) =
  [%#sspec'12] kind'0 = FinalizeKraftVersion \/ has_node nodes (Seq.length nodes) node = (membership'0 <> Absent)

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_Option_VoterReconfigurationDecision = None'1 | Some'1 t_VoterReconfigurationDecision

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate voter_set_removes [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 42 0 42 87] (membership'0: t_TargetMembership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'1] membership'0 = PresentSameDirectory /\ gt_log_Int (UInt64.t'int voters.voter_count) 1

predicate update_key_matches [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 59 0 59 63] (membership'0: t_TargetMembership) =
  [%#sadmitted_plan'2] membership'0 = PresentUnknownDirectory \/ membership'0 = PresentSameDirectory

function voter_reconfiguration_rejection [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 82 0 87 41] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) : t_Option_VoterReconfigurationDecision
 = [%#sadmitted_plan'0] if not leadership.is_leader then
    Some'1 (NotLeader)
  else
    if not leadership.no_pending_change then
      Some'1 (InProgress)
    else
      if not leadership.epoch_committed then
        Some'1 (EpochUncommitted)
      else
        if not voters.latest_controls_committed then
          Some'1 (InProgress)
        else
          if UInt64.t'int voters.voter_count = 0 then
            Some'1 (EmptyCurrentVoterSet)
          else
            if gt_log_Int (UInt16.t'int voters.kraft_version) 1 then
              Some'1 (InvalidVersionTransition)
            else
              match request.kind with
                | Add -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'1 (UnsupportedKraftVersion)
                else
                  if target.membership <> Absent then
                    Some'1 (DuplicateVoter)
                  else
                    if not target.version_compatible then
                      Some'1 (IncompatibleVoter)
                    else
                      if not target.caught_up then
                        Some'1 (VoterNotCaughtUp)
                      else
                        if UInt64.t'int voters.voter_count = UInt64.t'int const_MAX then
                          Some'1 (InvalidVersionTransition)
                        else
                          None'1





                | Remove -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'1 (UnsupportedKraftVersion)
                else
                  if not voter_set_removes target.membership voters then Some'1 (VoterNotFound) else None'1

                | Update -> if not target.version_compatible then
                  Some'1 (IncompatibleVoter)
                else
                  if target.membership = Absent then
                    Some'1 (VoterNotFound)
                  else
                    if not update_key_matches target.membership then Some'1 (DirectoryMismatch) else None'1


                | FinalizeKraftVersion -> if UInt16.t'int voters.kraft_version <> 0
                \/ UInt16.t'int request.requested_kraft_version <> 1 then
                  Some'1 (InvalidVersionTransition)
                else
                  if not voters.all_voters_support_requested then Some'1 (IncompatibleVoter) else None'1

                end







predicate control_request_admitted [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 95 0 101 9] (old': Seq.seq UInt64.t) (state: tup2_ReconfigurationLeadership_CurrentVoterSet) (request: t_VoterChangeRequest) (node: UInt64.t) (target: t_TargetVoter) =
  [%#sspec'7] valid_old old'
  /\ membership_coherent old' node target.membership request.kind
  /\ match voter_reconfiguration_rejection state.f0'0 state.f1'0 request target with
    | Some'1 _ -> false
    | None'1 -> true
    end

function control_record_count [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 9 0 9 71] (version: UInt16.t) (kind'0: t_VoterChangeKind) : int
 = [%#sspec'1] match kind'0 with
    | FinalizeKraftVersion -> 2
    | Update -> if UInt16.t'int version = 0 then 0 else 1
    | Add | Remove -> 1
    end

predicate control_supported_request [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 137 0 143 9] (old': Seq.seq UInt64.t) (state: tup2_ReconfigurationLeadership_CurrentVoterSet) (request: t_VoterChangeRequest) (candidate: tup2_u64_TargetVoter) (support: bool) =
  [%#sspec'0] control_request_admitted old' state request candidate.f0'5 candidate.f1'5
  /\ (control_record_count state.f1'0.kraft_version request.kind = 0 \/ support)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX'0: Int64.t = (9223372036854775807: Int64.t)

predicate expected_member [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 56 0 62 9] (nodes: Seq.seq UInt64.t) (count: int) (kind'0: t_VoterChangeKind) (target: UInt64.t) (node: UInt64.t) =
  [%#sspec'10] match kind'0 with
    | Add -> has_node nodes count node \/ node = target
    | Remove -> has_node nodes count node /\ node <> target
    | Update | FinalizeKraftVersion -> has_node nodes count node
    end

function prefix_count [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 28 0 36 8] (old': Seq.seq UInt64.t) (reports: Seq.seq tup2_i64_i64) (kind'0: t_VoterChangeKind) (node: UInt64.t) (end': int) (new: bool) (count: int) : int

axiom prefix_count_def:
  forall old': Seq.seq UInt64.t, reports: Seq.seq tup2_i64_i64, kind'0: t_VoterChangeKind, node: UInt64.t, end': int, new: bool, count: int [prefix_count old' reports kind'0 node end' new count]. prefix_count old' reports kind'0 node end' new count
    = ([%#sspec'6] if count <= 0 then
      0
    else
      prefix_count old' reports kind'0 node end' new (count - 1)
      + (if count - 1 < Seq.length old' then
        if new then
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'1) end'
          /\ expected_member old' (Seq.length old') kind'0 node (Seq.get old' (count - 1)) then
            1
          else
            0

        else
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f0'1) end' then 1 else 0

      else
        if new
        /\ ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'1) end'
        /\ not has_node old' (Seq.length old') node /\ expected_member old' (Seq.length old') kind'0 node node then
          1
        else
          0

      )
    )

function next_size [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 19 0 19 58] (count: int) (kind'0: t_VoterChangeKind) : int
 = [%#sspec'8] match kind'0 with
    | Add -> count + 1
    | Remove -> count - 1
    | _ -> count
