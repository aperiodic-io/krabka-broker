type tup3_u64_u64_u64 = { f0: UInt64.t; f1: UInt64.t; f2: UInt64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type tup2_u64_u64 = { f0'0: UInt64.t; f1'0: UInt64.t }

let len_tup2_u64_u64 (self_: Slice64.slice tup2_u64_u64) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

function deep_model_u64 [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

meta "rewrite_def" function deep_model_u64

let max_u64 (self_: UInt64.t) (o: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:max_u64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] ge_log_Int (deep_model_u64 result) (deep_model_u64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] ge_log_Int (deep_model_u64 result) (deep_model_u64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_u64 self_ <= deep_model_u64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_u64 o < deep_model_u64 self_ -> result = self_)}
    (! return {result}) ]

function capped [#"/workspace/crates/verified/src/throttle.rs" 37 0 37 61] (available: int) (refill: int) (burst: int) : int
 = [%#sthrottle'3] if available + refill <= burst then available + refill else burst

let quota_refill (available: UInt64.t) (debt: UInt64.t) (fraction: UInt64.t) (elapsed: UInt64.t) (rate: UInt64.t)
  (burst: UInt64.t) (return (x: tup3_u64_u64_u64)) =
{[@stop_split] [@expl:quota_refill requires] ([@stop_split] [@expl:quota_refill requires #0] [%#srefill] UInt64.t'int fraction
    < 1000000000)
  /\ ([@stop_split] [@expl:quota_refill requires #1] [%#srefill'0] UInt64.t'int available <= UInt64.t'int burst
  /\ (UInt64.t'int available = 0 \/ UInt64.t'int debt = 0))}
  any
  [ return (result: tup3_u64_u64_u64) ->
  {[@stop_split] [@expl:quota_refill ensures] ([@stop_split] [@expl:quota_refill ensures #0] [%#srefill'1] UInt64.t'int result.f0
        <= UInt64.t'int burst
      /\ (UInt64.t'int result.f0 = 0 \/ UInt64.t'int result.f1 = 0))
    /\ ([@stop_split] [@expl:quota_refill ensures #1] [%#srefill'2] UInt64.t'int result.f2 < 1000000000)
    /\ ([@stop_split] [@expl:quota_refill ensures #2] [%#srefill'3] let credit = ComputerDivision.div (UInt64.t'int elapsed
        * UInt64.t'int rate
      + UInt64.t'int fraction) 1000000000 in UInt64.t'int result.f1
      = (if credit <= UInt64.t'int debt then UInt64.t'int debt - credit else 0))
    /\ ([@stop_split] [@expl:quota_refill ensures #3] [%#srefill'4] let credit = ComputerDivision.div (UInt64.t'int elapsed
        * UInt64.t'int rate
      + UInt64.t'int fraction) 1000000000 in let paid = if credit <= UInt64.t'int debt then
        credit
      else
        UInt64.t'int debt
       in UInt64.t'int result.f0 = capped (UInt64.t'int available) (credit - paid) (UInt64.t'int burst))
    /\ ([@stop_split] [@expl:quota_refill ensures #4] [%#srefill'5] UInt64.t'int result.f2
      = (if UInt64.t'int result.f0 = UInt64.t'int burst /\ UInt64.t'int result.f1 = 0 then
        0
      else
        ComputerDivision.mod (UInt64.t'int elapsed * UInt64.t'int rate + UInt64.t'int fraction) 1000000000
      ))
    /\ ([@stop_split] [@expl:quota_refill ensures #5] [%#srefill'6] let balance = (UInt64.t'int available
          - UInt64.t'int debt)
        * 1000000000
      + UInt64.t'int fraction
    + UInt64.t'int elapsed * UInt64.t'int rate in (UInt64.t'int result.f0 - UInt64.t'int result.f1) * 1000000000
      + UInt64.t'int result.f2
    = (if balance <= UInt64.t'int burst * 1000000000 then balance else UInt64.t'int burst * 1000000000))}
    (! return {result}) ]

let from_u128 (small: UInt64.t) (return (x: UInt128.t)) = any
  [ return (result: UInt128.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = UInt128.of_int (UInt64.t'int small)}
    (! return {result}) ]

let quota_whole_request (requested: UInt64.t) (total: UInt64.t) (units_per_token: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:quota_whole_request requires] [%#srequest] gt_log_Int (UInt64.t'int units_per_token) 0}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:quota_whole_request ensures] ([@stop_split] [@expl:quota_whole_request ensures #0] [%#srequest'0] UInt64.t'int result
        <= UInt64.t'int total
      /\ ComputerDivision.mod (UInt64.t'int result) (UInt64.t'int units_per_token) = 0)
    /\ ([@stop_split] [@expl:quota_whole_request ensures #1] [%#srequest'1] ComputerDivision.div (UInt64.t'int result) (UInt64.t'int units_per_token)
      = (if UInt64.t'int requested <= ComputerDivision.div (UInt64.t'int total) (UInt64.t'int units_per_token) then
        UInt64.t'int requested
      else
        ComputerDivision.div (UInt64.t'int total) (UInt64.t'int units_per_token)
      ))
    /\ ([@stop_split] [@expl:quota_whole_request ensures #2] [%#srequest'2] UInt64.t'int result
    = (if UInt64.t'int requested <= ComputerDivision.div (UInt64.t'int total) (UInt64.t'int units_per_token) then
        UInt64.t'int requested
      else
        ComputerDivision.div (UInt64.t'int total) (UInt64.t'int units_per_token)
      )
    * UInt64.t'int units_per_token)}
    (! return {result}) ]

function lemma_div_monotone [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 47 0 47 60] (low: int) (high: int) (divisor: int) : ()

axiom lemma_div_monotone_spec: forall low: int, high: int, divisor: int. ([%#smin_insync_is_site_loss_safe] 0 <= low
      /\ low <= high /\ ge_log_Int divisor 1)
    -> ([%#smin_insync_is_site_loss_safe'0] ComputerDivision.div low divisor <= ComputerDivision.div high divisor)

type t_AvailableTokens = { f0'1: UInt64.t }

type t_RefillTokens = { f0'2: UInt64.t }

type t_BurstCapacity = { f0'3: UInt64.t }

type t_RequestedTokens = { f0'4: UInt64.t }

type t_GrantedTokens = { f0'5: UInt64.t }

type t_NewAvailable = { f0'6: UInt64.t }

type tup2_GrantedTokens_NewAvailable = { f0'7: t_GrantedTokens; f1'7: t_NewAvailable }

let plan_consume (available: t_AvailableTokens) (refill: t_RefillTokens) (burst: t_BurstCapacity)
  (requested: t_RequestedTokens) (return (x: tup2_GrantedTokens_NewAvailable)) = any
  [ return (result: tup2_GrantedTokens_NewAvailable) ->
  {[@stop_split] [@expl:plan_consume ensures] ([@stop_split] [@expl:plan_consume ensures #0] [%#sthrottle] UInt64.t'int result.f0'7.f0'5
      <= UInt64.t'int requested.f0'4)
    /\ ([@stop_split] [@expl:plan_consume ensures #1] [%#sthrottle'0] UInt64.t'int result.f1'7.f0'6
      <= UInt64.t'int burst.f0'3)
    /\ ([@stop_split] [@expl:plan_consume ensures #2] [%#sthrottle'1] UInt64.t'int result.f0'7.f0'5
        + UInt64.t'int result.f1'7.f0'6
      = capped (UInt64.t'int available.f0'1) (UInt64.t'int refill.f0'2) (UInt64.t'int burst.f0'3))
    /\ ([@stop_split] [@expl:plan_consume ensures #3] [%#sthrottle'2] UInt64.t'int result.f0'7.f0'5
    = (if UInt64.t'int requested.f0'4
    <= capped (UInt64.t'int available.f0'1) (UInt64.t'int refill.f0'2) (UInt64.t'int burst.f0'3) then
      UInt64.t'int requested.f0'4
    else
      capped (UInt64.t'int available.f0'1) (UInt64.t'int refill.f0'2) (UInt64.t'int burst.f0'3)
    ))}
    (! return {result}) ]

type tup2_Int_Int = { f0'8: int; f1'8: int }

type tup3_Int_Int_Int = { f0'9: int; f1'9: int; f2'9: int }

function lemma_refill_grant_ledger [#"/workspace/crates/verified/src/composition/consume_trace.rs" 130 0 136 1] (granted: int) (previous: tup2_Int_Int) (refilled: tup3_Int_Int_Int) (consumed: tup2_Int_Int) (credit: int) : ()
 = [%#sconsume_trace'71] ()

axiom lemma_refill_grant_ledger_spec:
  forall granted: int, previous: tup2_Int_Int, refilled: tup3_Int_Int_Int, consumed: tup2_Int_Int, credit: int. ([%#sconsume_trace'68] refilled.f0'9
            * 1000000000
          + refilled.f1'9
        + refilled.f2'9
      = previous.f0'8 * 1000000000 + previous.f1'8 + credit)
    -> ([%#sconsume_trace'69] consumed.f0'8 + consumed.f1'8 = refilled.f0'9)
    -> ([%#sconsume_trace'70] (granted + consumed.f0'8 + consumed.f1'8) * 1000000000 + refilled.f1'9 + refilled.f2'9
    = (granted + previous.f0'8) * 1000000000 + previous.f1'8 + credit)

type tup4_u64_u64_u64_u64 = { f0'10: UInt64.t; f1'10: UInt64.t; f2'10: UInt64.t; f3'10: UInt64.t }

