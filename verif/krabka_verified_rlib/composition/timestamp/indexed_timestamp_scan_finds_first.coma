predicate has_value_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq Int64.t) (out: Slice64.slice Int64.t) =
  [%#sslice'3] Seq.([..]) seq (UInt64.t'int self.start) (Seq.length seq) = Slice64.view out

