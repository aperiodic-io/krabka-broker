  {[@stop_split] [@expl:validated_remote_and_local_time_starts_agree ensures] [%#stimestamp] match result with
      | Err () -> not time_archive_valid (Slice64.view entries) (Int64.to_int max_relative)
      | Ok {f0'0 = count; f1'0 = remote; f2'0 = local} -> time_archive_valid (Slice64.view entries) (Int64.to_int max_relative)
