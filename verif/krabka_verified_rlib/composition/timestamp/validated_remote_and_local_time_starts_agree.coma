use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.int.Int64
use creusot.int.UInt32
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type tup2_i64_u32 = { f0: Int64.t; f1: UInt32.t }

let len_tup2_i64_u32 (self_: Slice64.slice tup2_i64_u32) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_tup2_i64_u32 = None | Some tup2_i64_u32

let restore_time_index_entry_valid (previous: t_Option_tup2_i64_u32) (timestamp: Int64.t) (relative_offset: UInt32.t)
  (max_relative: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:restore_time_index_entry_valid ensures] [%#srestore_producer_ids_strict] result
    = (UInt32.t'int relative_offset <= Int64.to_int max_relative
    /\ match previous with
      | Some {f0 = previous_timestamp; f1 = previous_relative} -> Int64.to_int previous_timestamp
        <= Int64.to_int timestamp
      /\ UInt32.t'int previous_relative < UInt32.t'int relative_offset
      | None -> true
      end)}
    (! return {result}) ]

type tup3_usize_u32_u32 = { f0'0: UInt64.t; f1'0: UInt32.t; f2'0: UInt32.t }

type t_Result_tup3_usize_u32_u32_unit = Ok tup3_usize_u32_u32 | Err ()

let remote_time_index_candidate_count (entries: Slice64.slice tup2_i64_u32) (target_timestamp: Int64.t)
  (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:remote_time_index_candidate_count ensures] ([@stop_split] [@expl:remote_time_index_candidate_count ensures #0] [%#sremote_time_index_candidate_count] UInt64.t'int result
      <= Seq.length (Slice64.view entries))
    /\ ([@stop_split] [@expl:remote_time_index_candidate_count ensures #1] [%#sremote_time_index_candidate_count'0] forall i: int. 0
            <= i
          /\ i < UInt64.t'int result
        -> Int64.to_int (Seq.get (Slice64.view entries) i).f0 < Int64.to_int target_timestamp)
    /\ ([@stop_split] [@expl:remote_time_index_candidate_count ensures #2] [%#sremote_time_index_candidate_count'1] forall i: int. 1
            <= i
          /\ i < UInt64.t'int result
        -> UInt32.t'int (Seq.get (Slice64.view entries) (i - 1)).f1
        < UInt32.t'int (Seq.get (Slice64.view entries) i).f1)
    /\ ([@stop_split] [@expl:remote_time_index_candidate_count ensures #3] [%#sremote_time_index_candidate_count'2] UInt64.t'int result
      < Seq.length (Slice64.view entries)
    -> gt_log_Int (UInt64.t'int result) 0
      /\ UInt32.t'int (Seq.get (Slice64.view entries) (UInt64.t'int result)).f1
      <= UInt32.t'int (Seq.get (Slice64.view entries) (UInt64.t'int result - 1)).f1
    \/ ge_log_Int (Int64.to_int (Seq.get (Slice64.view entries) (UInt64.t'int result)).f0) (Int64.to_int target_timestamp))}
    (! return {result}) ]

let time_index_scan_start (entries: Slice64.slice tup2_i64_u32) (target_timestamp: Int64.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:time_index_scan_start requires] [%#slog_index] forall i: int, j: int. 0 <= i
      /\ i < j /\ j < Seq.length (Slice64.view entries)
    -> Int64.to_int (Seq.get (Slice64.view entries) i).f0 <= Int64.to_int (Seq.get (Slice64.view entries) j).f0}
  any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:time_index_scan_start ensures] ([@stop_split] [@expl:time_index_scan_start ensures #0] [%#slog_index'0] (exists i: int. 0
            <= i
          /\ i < Seq.length (Slice64.view entries)
          /\ Int64.to_int (Seq.get (Slice64.view entries) i).f0 < Int64.to_int target_timestamp)
      -> (exists i: int. 0 <= i
        /\ i < Seq.length (Slice64.view entries)
        /\ Int64.to_int (Seq.get (Slice64.view entries) i).f0 < Int64.to_int target_timestamp
        /\ UInt32.t'int result = UInt32.t'int (Seq.get (Slice64.view entries) i).f1
        /\ (forall j: int. i < j /\ j < Seq.length (Slice64.view entries)
          -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view entries) j).f0) (Int64.to_int target_timestamp))))
    /\ ([@stop_split] [@expl:time_index_scan_start ensures #1] [%#slog_index'1] (forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view entries)
        -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view entries) i).f0) (Int64.to_int target_timestamp))
    -> UInt32.t'int result = 0)}
    (! return {result}) ]

predicate time_rows_ordered [#"/workspace/crates/verified/src/composition/timestamp.rs" 231 0 231 70] (entries: Seq.seq tup2_i64_u32) (count: int) =
  [%#stimestamp'3] forall left: int, right: int. 0 <= left /\ left < right /\ right < count
    -> Int64.to_int (Seq.get entries left).f0 <= Int64.to_int (Seq.get entries right).f0
    /\ UInt32.t'int (Seq.get entries left).f1 < UInt32.t'int (Seq.get entries right).f1

predicate time_archive_valid [#"/workspace/crates/verified/src/composition/timestamp.rs" 142 0 142 78] (entries: Seq.seq tup2_i64_u32) (max_relative: int) =
  [%#stimestamp'0] (forall i: int. 0 <= i /\ i < Seq.length entries
      -> UInt32.t'int (Seq.get entries i).f1 <= max_relative)
  /\ time_rows_ordered entries (Seq.length entries)

predicate time_cursor_matches [#"/workspace/crates/verified/src/composition/timestamp.rs" 21 0 21 94] (entries: Seq.seq tup2_i64_u32) (cursor: tup3_usize_u32_u32) =
  [%#stimestamp'1] cursor.f1'0 = cursor.f2'0
  /\ UInt64.t'int cursor.f0'0 <= Seq.length entries
  /\ cursor.f1'0
  = (if UInt64.t'int cursor.f0'0 = 0 then (0: UInt32.t) else (Seq.get entries (UInt64.t'int cursor.f0'0 - 1)).f1)

predicate timestamp_archive_prefix [#"/workspace/crates/verified/src/composition/timestamp.rs" 239 0 239 97] (entries: Seq.seq tup2_i64_u32) (target: int) (count: int) =
  [%#stimestamp'2] (forall i: int. 0 <= i /\ i < count -> Int64.to_int (Seq.get entries i).f0 < target)
  /\ (count < Seq.length entries -> ge_log_Int (Int64.to_int (Seq.get entries count).f0) target)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let validated_remote_and_local_time_starts_agree [#"/workspace/crates/verified/src/composition/timestamp.rs" 150 0 177 1]
  (entries: Slice64.slice tup2_i64_u32) (max_relative: Int64.t) (target: Int64.t)
  (return (x: t_Result_tup3_usize_u32_u32_unit)) = (! bb0
  [ bb0 = s0 [ s0 = [ &i <- [%#stimestamp] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 =
      {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#stimestamp] Seq.length (Slice64.view entries)
      - UInt64.t'int i)}
      bb1invariant
    | bb1invariant = {[@expl:loop invariant #0] [%#stimestamp] UInt64.t'int i <= Seq.length (Slice64.view entries)}
      {[@expl:loop invariant #1] [%#stimestamp] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> UInt32.t'int (Seq.get (Slice64.view entries) j).f1 <= Int64.to_int max_relative}
      {[@expl:loop invariant #2] [%#stimestamp] forall j: int, k: int. 0 <= j /\ j < k /\ k < UInt64.t'int i
        -> Int64.to_int (Seq.get (Slice64.view entries) j).f0 <= Int64.to_int (Seq.get (Slice64.view entries) k).f0
        /\ UInt32.t'int (Seq.get (Slice64.view entries) j).f1 < UInt32.t'int (Seq.get (Slice64.view entries) k).f1}
      (! [ &variant_old_bb1 <- [%#stimestamp] Seq.length (Slice64.view entries) - UInt64.t'int i ] s0)
      [ s0 = len_tup2_i64_u32 [%#stimestamp] {entries} (fun (_x: UInt64.t) -> [ &_27 <- _x ] s1)
      | s1 = [ &_25 <- UInt64.lt i _27 ] s2
      | s2 = any [ br0 -> {_25 = false} (! bb13) | br1 -> {_25} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_30 <- i = ([%#stimestamp] (0: UInt64.t)) ] s1
        | s1 = any [ br0 -> {_30 = false} (! bb6) | br1 -> {_30} (! bb5) ] ]
      | bb5 = s0 [ s0 = [ &previous <- None ] s1 | s1 = bb8 ]
      | bb6 = s0
        [ s0 = UInt64.sub [%#stimestamp] {i} {[%#stimestamp] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_33 <- _x ] s1)
        | s1 = [ &_35 <- Slice64.length entries ] s2
        | s2 = [ &_36 <- UInt64.lt _33 _35 ] s3
        | s3 = {[@expl:index in bounds] [%#stimestamp] _36} s4
        | s4 = Slice64.get [%#stimestamp] <tup2_i64_u32> {entries} {_33} (fun (r: tup2_i64_u32) -> [ &_32 <- r ] s5)
        | s5 = [ &previous <- Some _32 ] s6
        | s6 = bb8 ]
      | bb8 = s0
        [ s0 = [ &_39 <- i ] s1
        | s1 = [ &_40 <- Slice64.length entries ] s2
        | s2 = [ &_41 <- UInt64.lt _39 _40 ] s3
        | s3 = {[@expl:index in bounds] [%#stimestamp] _41} s4
        | s4 = Slice64.get [%#stimestamp] <tup2_i64_u32> {entries} {_39}
            (fun (r: tup2_i64_u32) -> [ &timestamp <- r.f0 ] s5)
        | s5 = Slice64.get [%#stimestamp] <tup2_i64_u32> {entries} {_39}
            (fun (r: tup2_i64_u32) -> [ &relative <- r.f1 ] s6)
        | s6 = restore_time_index_entry_valid [%#stimestamp] {previous} {timestamp} {relative} {max_relative}
            (fun (_x: bool) -> [ &_43 <- _x ] s7)
        | s7 = any [ br0 -> {_43 = false} (! bb12) | br1 -> {_43} (! bb11) ] ]
      | bb11 = s0
        [ s0 = UInt64.add [%#stimestamp] {i} {[%#stimestamp] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb12 = s0 [ s0 = [ &_ret <- Err _49 ] s1 | s1 = return {_ret} ]
  | bb13 = s0
    [ s0 = remote_time_index_candidate_count [%#stimestamp] {entries} {target}
        (fun (_x: UInt64.t) -> [ &count <- _x ] s1)
    | s1 = [ &_55 <- count = ([%#stimestamp] (0: UInt64.t)) ] s2
    | s2 = any [ br0 -> {_55 = false} (! bb16) | br1 -> {_55} (! bb15) ] ]
  | bb15 = s0 [ s0 = [ &remote <- [%#stimestamp] (0: UInt32.t) ] s1 | s1 = bb18 ]
  | bb16 = s0
    [ s0 = UInt64.sub [%#stimestamp] {count} {[%#stimestamp] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_57 <- _x ] s1)
    | s1 = [ &_59 <- Slice64.length entries ] s2
    | s2 = [ &_60 <- UInt64.lt _57 _59 ] s3
    | s3 = {[@expl:index in bounds] [%#stimestamp] _60} s4
    | s4 = Slice64.get [%#stimestamp] <tup2_i64_u32> {entries} {_57} (fun (r: tup2_i64_u32) -> [ &remote <- r.f1 ] s5)
    | s5 = bb18 ]
  | bb18 = s0
    [ s0 = time_index_scan_start [%#stimestamp] {entries} {target} (fun (_x: UInt32.t) -> [ &local <- _x ] s1)
    | s1 = [ &_64 <- { f0'0 = count; f1'0 = remote; f2'0 = local } ] s2
    | s2 = [ &_ret <- Ok _64 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_tup3_usize_u32_u32_unit = Any.any_l ()
  | & entries: Slice64.slice tup2_i64_u32 = entries
  | & max_relative: Int64.t = max_relative
  | & target: Int64.t = target
  | & i: UInt64.t = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & previous: t_Option_tup2_i64_u32 = Any.any_l ()
  | & _30: bool = Any.any_l ()
  | & _32: tup2_i64_u32 = Any.any_l ()
  | & _33: UInt64.t = Any.any_l ()
