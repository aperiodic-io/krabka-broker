  | & _32: t_RangeToInclusive_usize = Any.any_l ()
  | & _34: t_Option_usize = Any.any_l ()
  | & index: UInt64.t = Any.any_l ()
  | & _38: Int64.t = Any.any_l ()
  | & _39: UInt64.t = Any.any_l ()
  | & _40: UInt64.t = Any.any_l ()
  | & _41: bool = Any.any_l ()
  | & _42: UInt32.t = Any.any_l ()
  | & _43: UInt64.t = Any.any_l ()
  | & _44: UInt64.t = Any.any_l ()
