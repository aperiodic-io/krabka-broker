type t_RangeToInclusive_usize = { end': UInt64.t }

predicate in_bounds_RangeToInclusive_usize (self: t_RangeToInclusive_usize) (seq: Seq.seq Int64.t) =
  [%#sslice'1] UInt64.t'int self.end' < Seq.length seq

predicate has_value_RangeToInclusive_usize (self: t_RangeToInclusive_usize) (seq: Seq.seq Int64.t) (out: Slice64.slice Int64.t) =
  [%#sslice'2] Seq.([..]) seq 0 (UInt64.t'int self.end' + 1) = Slice64.view out

let index_slice_i64 (self_: Slice64.slice Int64.t) (ix: t_RangeToInclusive_usize) (return (x: Slice64.slice Int64.t)) =
{[@stop_split] [@expl:index requires] [%#sslice] in_bounds_RangeToInclusive_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice Int64.t) ->
  {[@stop_split] [@expl:index ensures] [%#sslice'0] has_value_RangeToInclusive_usize ix (Slice64.view self_) result}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

let earliest_max_timestamp_index (timestamps: Slice64.slice Int64.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:earliest_max_timestamp_index ensures] [%#stimestamp'11] match result with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view timestamps)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view timestamps)
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i)
          <= Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))
        /\ (forall i'0: int. 0 <= i'0 /\ i'0 < UInt64.t'int index
          -> Int64.to_int (Seq.get (Slice64.view timestamps) i'0)
          < Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))))
      | None -> Seq.length (Slice64.view timestamps) = 0
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_usize) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type tup2_i64_u32 = { f0: Int64.t; f1: UInt32.t }

type tup2_u32_u32 = { f0'0: UInt32.t; f1'0: UInt32.t }

predicate pairwise_u32 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq UInt32.t) (relation: Map.map tup2_u32_u32 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0'0 = Seq.get values i; f1'0 = Seq.get values j }

predicate strictly_increasing_u32 [#"/workspace/crates/verified/src/sequence.rs" 13 0 13 73] (values: Seq.seq UInt32.t) =
  [%#ssequence] pairwise_u32 values (fun (__0: tup2_u32_u32) -> let {f0'0 = left; f1'0 = right} = __0 in UInt32.t'int left
  < UInt32.t'int right)

predicate record_offsets_ordered [#"/workspace/crates/verified/src/composition/timestamp.rs" 12 0 12 63] (offsets: Seq.seq UInt32.t) =
  [%#stimestamp'12] strictly_increasing_u32 offsets

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let running_maximum_index_entry [#"/workspace/crates/verified/src/composition/timestamp.rs" 39 0 44 15]
  (offsets: Slice64.slice UInt32.t) (timestamps: Slice64.slice Int64.t) (indexed: UInt64.t) (through: UInt64.t)
