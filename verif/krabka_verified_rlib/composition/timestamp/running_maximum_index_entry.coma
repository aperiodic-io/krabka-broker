  | bb5 = {false} any ]
  [ & _ret: tup2_i64_u32 = Any.any_l ()
  | & offsets: Slice64.slice UInt32.t = offsets
  | & timestamps: Slice64.slice Int64.t = timestamps
  | & indexed: UInt64.t = indexed
  | & through: UInt64.t = through
