    | s1 = [ &_39 <- index ] s2
    | s2 = [ &_40 <- Slice64.length prefix ] s3
    | s3 = [ &_41 <- UInt64.lt _39 _40 ] s4
    | s4 = {[@expl:index in bounds] [%#stimestamp'2] _41} s5
    | s5 = Slice64.get [%#stimestamp'2] <Int64.t> {prefix} {_39} (fun (r: Int64.t) -> [ &_38 <- r ] s6)
    | s6 = [ &_43 <- indexed ] s7
    | s7 = [ &_44 <- Slice64.length offsets ] s8
    | s8 = [ &_45 <- UInt64.lt _43 _44 ] s9
    | s9 = {[@expl:index in bounds] [%#stimestamp'3] _45} s10
    | s10 = Slice64.get [%#stimestamp'3] <UInt32.t> {offsets} {_43} (fun (r: UInt32.t) -> [ &_42 <- r ] s11)
    | s11 = [ &_ret <- { f0 = _38; f1 = _42 } ] s12
