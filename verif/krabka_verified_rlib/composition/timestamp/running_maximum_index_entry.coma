    /\ UInt64.t'int through < Seq.length (Slice64.view timestamps))
  /\ ([@stop_split] [@expl:running_maximum_index_entry requires #2] [%#stimestamp'6] record_offsets_ordered (Slice64.view offsets))}
  (! bb0
  [ bb0 = s0
