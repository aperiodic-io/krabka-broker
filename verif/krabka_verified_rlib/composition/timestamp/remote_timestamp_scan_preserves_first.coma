    /\ ([@stop_split] [@expl:remote_timestamp_scan_preserves_first ensures #6] [%#stimestamp'23] first_timestamp_match (Slice64.view timestamps) (Int64.to_int target) result.f2'2)}
    (! return {result}) ]
