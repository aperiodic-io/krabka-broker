let restored_aborts_remain_bounded_when_fetch_shrinks (entries: Slice64.slice t_RestoreAbortedTxn)
  (segment: t_RestoreSegmentExtent) (w: t_FetchWatermarks) (fetch_start: Int64.t) (cut: Int64.t)
  (return (x: t_Option_Vec_usize_Global)) = any
  [ return (result: t_Option_Vec_usize_Global) ->
  {[@stop_split] [@expl:restored_aborts_remain_bounded_when_fetch_shrinks ensures] [%#srestored_aborts] match result with
      | None -> not restored_abort_index_valid (Slice64.view entries) segment
      | Some selected -> restored_abort_index_valid (Slice64.view entries) segment
      /\ Seq.length (view_Vec_usize_Global selected) <= Seq.length (Slice64.view entries)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global selected)
          -> UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i) < Seq.length (Slice64.view entries))
      /\ strictly_increasing_usize (view_Vec_usize_Global selected)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
          -> contains_source_index (view_Vec_usize_Global selected) i
          = abort_intersects_fetch (Seq.get (Slice64.view entries) i) (Int64.to_int fetch_start) (MinMax.min (MinMax.min (MinMax.min (Int64.to_int w.hw) (Int64.to_int w.lso)) (Int64.to_int w.deliverable)) (Int64.to_int cut)))
      /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global selected)
        -> abort_intersects_fetch (Seq.get (Slice64.view entries) (UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i))) (Int64.to_int fetch_start) (MinMax.min (MinMax.min (MinMax.min (Int64.to_int w.hw) (Int64.to_int w.lso)) (Int64.to_int w.deliverable)) (Int64.to_int cut))
        /\ abort_intersects_fetch (Seq.get (Slice64.view entries) (UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i))) (Int64.to_int fetch_start) (MinMax.min (MinMax.min (Int64.to_int w.hw) (Int64.to_int w.lso)) (Int64.to_int w.deliverable))
        /\ Int64.to_int (Seq.get (Slice64.view entries) (UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i))).start_offset
          < Int64.to_int w.hw
        /\ Int64.to_int (Seq.get (Slice64.view entries) (UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i))).start_offset
          < Int64.to_int w.lso
        /\ Int64.to_int (Seq.get (Slice64.view entries) (UInt64.t'int (Seq.get (view_Vec_usize_Global selected) i))).start_offset
        < Int64.to_int w.deliverable)
      end}
    (! return {result}) ]

