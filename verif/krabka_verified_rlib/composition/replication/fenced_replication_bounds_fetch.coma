      <= Int64.to_int frontier)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #1] [%#sfuture_log_swap_admission'1] Int64.to_int result
      <= Int64.to_int new_end)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #2] [%#sfuture_log_swap_admission'2] Int64.to_int result
      = Int64.to_int frontier
