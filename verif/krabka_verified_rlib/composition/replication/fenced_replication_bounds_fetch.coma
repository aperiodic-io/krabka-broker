constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let local_append_coordinates (expected_base: Int64.t) (supplied_base: Int64.t) (last_offset_delta: Int32.t)
  (return (x: t_Option_tup2_i64_i64)) = any
  [ return (result: t_Option_tup2_i64_i64) ->
  {[@stop_split] [@expl:local_append_coordinates ensures] [%#sfuture_log_swap_admission] match result with
      | Some {f0 = last; f1 = next} -> ge_log_Int (Int64.to_int expected_base) 0
      /\ ge_log_Int (Int64.to_int supplied_base) (Int64.to_int expected_base)
      /\ ge_log_Int (Int32.to_int last_offset_delta) 0
      /\ Int64.to_int last = Int64.to_int supplied_base + Int32.to_int last_offset_delta
      /\ Int64.to_int next = Int64.to_int last + 1
      /\ Int64.to_int supplied_base <= Int64.to_int last /\ Int64.to_int last < Int64.to_int next
      | None -> Int64.to_int expected_base < 0
      \/ Int64.to_int supplied_base < Int64.to_int expected_base
      \/ Int32.to_int last_offset_delta < 0
      \/ gt_log_Int (Int64.to_int supplied_base + Int32.to_int last_offset_delta) (Int64.to_int const_MAX)
      \/ gt_log_Int (Int64.to_int supplied_base + Int32.to_int last_offset_delta + 1) (Int64.to_int const_MAX)
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_tup2_i64_i64) (return (f0'0: tup2_i64_i64)) = any
  [ _k (f0'0: tup2_i64_i64) -> {Some f0'0 = _x} (! return {f0'0})
