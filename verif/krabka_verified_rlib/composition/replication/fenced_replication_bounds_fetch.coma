predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

let replica_fetch_mutation (facts: t_ReplicaFetchFacts) (return (x: t_ReplicaFetchMutation)) = any
  [ return (result: t_ReplicaFetchMutation) -> {[@stop_split] [@expl:replica_fetch_mutation ensures] [%#sfetch] result
    = (if replica_fetch_fenced facts then
