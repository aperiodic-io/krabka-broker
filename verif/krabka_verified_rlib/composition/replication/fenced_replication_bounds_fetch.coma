let advance_high_watermark (previous: Int64.t) (requested: Int64.t) (log_end'0: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:advance_high_watermark ensures] ([@stop_split] [@expl:advance_high_watermark ensures #0] [%#smetadata_record_offset_deltas] ge_log_Int (Int64.to_int result) (Int64.to_int previous))
    /\ ([@stop_split] [@expl:advance_high_watermark ensures #1] [%#smetadata_record_offset_deltas'0] Int64.to_int previous
        <= Int64.to_int log_end'0 -> Int64.to_int result <= Int64.to_int log_end'0)
    /\ ([@stop_split] [@expl:advance_high_watermark ensures #2] [%#smetadata_record_offset_deltas'1] Int64.to_int result
    = (if Int64.to_int requested <= Int64.to_int log_end'0 then
      if ge_log_Int (Int64.to_int previous) (Int64.to_int requested) then
        Int64.to_int previous
      else
        Int64.to_int requested

    else
      if ge_log_Int (Int64.to_int previous) (Int64.to_int log_end'0) then
        Int64.to_int previous
