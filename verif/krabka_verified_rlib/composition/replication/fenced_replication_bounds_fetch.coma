function offset_min [#"/workspace/crates/verified/src/broker/fetch.rs" 119 0 119 40] (a: int) (b: int) : int =
  [%#sfetch'9] if a <= b then a else b

function fetch_limit_model [#"/workspace/crates/verified/src/broker/fetch.rs" 131 0 131 92] (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) : int
 = [%#sfetch'10] if is_follower then
    Int64.to_int w.log_end
  else
    if read_committed then
      offset_min (offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)) (Int64.to_int w.lso)
    else
      offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)



let fetch_visibility (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) (fetch_offset: Int64.t)
  (return (x: t_FetchVisibility)) = any
  [ return (result: t_FetchVisibility) ->
  {[@stop_split] [@expl:fetch_visibility ensures] ([@stop_split] [@expl:fetch_visibility ensures #0] [%#sfetch'0] result.out_of_range
      = (Int64.to_int fetch_offset < Int64.to_int w.log_start
      \/ gt_log_Int (Int64.to_int fetch_offset) (Int64.to_int w.log_end)))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #1] [%#sfetch'1] result.empty
      = (not result.out_of_range
      /\ ge_log_Int (Int64.to_int fetch_offset) (if is_follower then
        Int64.to_int w.log_end
      else
        offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)
      )))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #2] [%#sfetch'2] Int64.to_int result.limit_offset
      = fetch_limit_model is_follower read_committed w)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #3] [%#sfetch'3] not is_follower
      -> Int64.to_int result.limit_offset <= Int64.to_int w.hw
      /\ Int64.to_int result.limit_offset <= Int64.to_int w.deliverable
      /\ (read_committed -> Int64.to_int result.limit_offset <= Int64.to_int w.lso))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #4] [%#sfetch'4] result.read_committed_aborts
      = (read_committed /\ not is_follower))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #5] [%#sfetch'5] Int64.to_int result.effective_lso
      = (if result.read_committed_aborts then
        offset_min (Int64.to_int w.lso) (Int64.to_int w.hw)
      else
        Int64.to_int w.lso
      ))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #6] [%#sfetch'6] result.response_hw = w.hw)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #7] [%#sfetch'7] Int64.to_int result.response_lso
    = offset_min (Int64.to_int w.lso) (Int64.to_int w.hw))}
    (! return {result}) ]

