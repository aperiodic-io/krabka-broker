type t_ReplicaFetchMutation = Reject | Retry | Truncate | Append

predicate replica_fetch_fenced [#"/workspace/crates/verified/src/broker/fetch.rs" 12 0 12 61] (facts: t_ReplicaFetchFacts) =
  [%#sfetch'8] Int32.to_int facts.request_leader_epoch <> Int32.to_int facts.current_leader_epoch
