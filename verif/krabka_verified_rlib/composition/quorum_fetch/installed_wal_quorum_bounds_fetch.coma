    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_FetchWatermarks = { log_start: Int64.t; hw: Int64.t; lso: Int64.t; log_end: Int64.t; deliverable: Int64.t }

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let min_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:min_i64 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_i64 result
      <= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_i64 result <= deep_model_i64 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_i64 self_ < deep_model_i64 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_i64 o <= deep_model_i64 self_ -> result = o)}
    (! return {result}) ]

let push_i64 (self_: MutBorrow.t t_Vec_i64_Global) (v: Int64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'1] view_Vec_i64_Global self_.final
    = Seq.snoc (view_Vec_i64_Global self_.current) v}
    (! return {result}) ]

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 173 0 173 62] (log_end'0: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'8] if k = 0 then log_end'0 else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 182 0 182 97] (log_end'0: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end'0: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end'0 s v limit leader_counts]. count_ge_prefix log_end'0 s v limit leader_counts
    = ([%#sfailover'7] if limit <= 0 then
      0
    else
      count_ge_prefix log_end'0 s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end'0 s (limit - 1)) v then 1 else 0)
    )

function lemma_explicit_vote_count_equal [#"/workspace/crates/verified/src/consensus/failover.rs" 212 0 218 1] (log_end'0: int) (left: Seq.seq Int64.t) (right: Seq.seq Int64.t) (threshold: int) (limit: int) : ()

axiom lemma_explicit_vote_count_equal_spec:
  forall log_end'0: int, left: Seq.seq Int64.t, right: Seq.seq Int64.t, threshold: int, limit: int. ([%#sfailover'0] 0
        <= limit
      /\ limit <= Seq.length left + 1 /\ limit <= Seq.length right + 1)
    -> ([%#sfailover'1] forall i: int. 0 <= i /\ i < limit - 1
        -> ge_log_Int (Int64.to_int (Seq.get left i)) threshold = ge_log_Int (Int64.to_int (Seq.get right i)) threshold)
    -> ([%#sfailover'2] count_ge_prefix log_end'0 left threshold limit false
    = count_ge_prefix log_end'0 right threshold limit false)

function count_ge [#"/workspace/crates/verified/src/consensus/failover.rs" 197 0 197 78] (log_end'0: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end'0: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end'0 s v leader_counts]. count_ge log_end'0 s v leader_counts
    = ([%#sfailover'4] count_ge_prefix log_end'0 s v (Seq.length s + 1) leader_counts)

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp'4] ge_log_Int (deep_model_i64 result) (deep_model_i64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'5] ge_log_Int (deep_model_i64 result) (deep_model_i64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'6] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'7] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'8] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

let majority_size (voter_count: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:majority_size ensures] [%#sfailover'5] UInt64.t'int result
    = ComputerDivision.div (UInt64.t'int voter_count) 2 + 1}
    (! return {result}) ]

let deref_Vec_i64_Global (self_: t_Vec_i64_Global) (return (x: Slice64.slice Int64.t)) = any
  [ return (result: Slice64.slice Int64.t) -> {[@stop_split] [@expl:deref ensures] [%#svec'2] Slice64.view result
    = view_Vec_i64_Global self_}
    (! return {result}) ]

type tup2_i64_i64 = { f0'0: Int64.t; f1'0: Int64.t }

let quorum_commit_bounds_fetch (followers: Slice64.slice Int64.t) (majority: UInt64.t) (epoch_start: Int64.t)
  (current': Int64.t) (leader_counts: bool) (w: t_FetchWatermarks) (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:quorum_commit_bounds_fetch requires] ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #0] [%#squorum_fetch'42] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view followers) + 1)
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #1] [%#squorum_fetch'43] leader_counts
    \/ UInt64.t'int majority <= Seq.length (Slice64.view followers))
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #2] [%#squorum_fetch'44] Int64.to_int current'
    <= Int64.to_int w.log_end)
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #3] [%#squorum_fetch'45] forall i: int. 0 <= i
      /\ i < Seq.length (Slice64.view followers)
    -> Int64.to_int (Seq.get (Slice64.view followers) i) <= Int64.to_int w.log_end)}
  any
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:quorum_commit_bounds_fetch ensures] ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #0] [%#squorum_fetch'46] Int64.to_int current'
        <= Int64.to_int result.f0'0
      /\ Int64.to_int result.f0'0 <= Int64.to_int w.log_end)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #1] [%#squorum_fetch'47] Int64.to_int result.f1'0
      <= Int64.to_int result.f0'0)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #2] [%#squorum_fetch'48] Int64.to_int result.f1'0
      = MinMax.min (MinMax.min (Int64.to_int result.f0'0) (Int64.to_int w.lso)) (Int64.to_int w.deliverable))
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #3] [%#squorum_fetch'49] forall v: int. gt_log_Int v (Int64.to_int epoch_start)
          /\ ge_log_Int (count_ge (Int64.to_int w.log_end) (Slice64.view followers) v leader_counts) (UInt64.t'int majority)
        -> v <= Int64.to_int result.f0'0)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #4] [%#squorum_fetch'50] gt_log_Int (Int64.to_int result.f0'0) (Int64.to_int current')
    -> ge_log_Int (count_ge (Int64.to_int w.log_end) (Slice64.view followers) (Int64.to_int result.f1'0) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]

type t_Vec_tup2_u64_i64_Global

type tup2_u64_i64 = { f0'1: UInt64.t; f1'1: Int64.t }

function view_Vec_tup2_u64_i64_Global (self: t_Vec_tup2_u64_i64_Global) : Seq.seq tup2_u64_i64

axiom view_Vec_tup2_u64_i64_Global_spec:
  forall self: t_Vec_tup2_u64_i64_Global [view_Vec_tup2_u64_i64_Global self]. [%#svec'0] Seq.length (view_Vec_tup2_u64_i64_Global self)
    <= UInt64.t'int const_MAX

let new_tup2_u64_i64 (return (x: t_Vec_tup2_u64_i64_Global)) = any
