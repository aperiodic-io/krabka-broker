predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

predicate pairwise_u64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq UInt64.t) (relation: Map.map tup2_u64_u64 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0 = Seq.get values i; f1 = Seq.get values j }

predicate distinct_u64 [#"/workspace/crates/verified/src/sequence.rs" 6 0 6 42] (values: Seq.seq UInt64.t) =
  [%#ssequence] pairwise_u64 values (fun (__0: tup2_u64_u64) -> let {f0 = left; f1 = right} = __0 in left <> right)

let wal_voter_set_valid (voters: Slice64.slice UInt64.t) (local_node: UInt64.t) (expected: UInt64.t)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:wal_voter_set_valid ensures] [%#sselect_wal_voters] result
    = (gt_log_Int (UInt64.t'int expected) 0
    /\ Seq.length (Slice64.view voters) = UInt64.t'int expected
    /\ Seq.get (Slice64.view voters) 0 = local_node /\ distinct_u64 (Slice64.view voters))}
    (! return {result}) ]

type t_Vec_i64_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_i64_Global (self: t_Vec_i64_Global) : Seq.seq Int64.t

