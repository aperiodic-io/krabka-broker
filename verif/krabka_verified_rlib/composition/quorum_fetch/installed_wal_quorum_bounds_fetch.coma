  forall self: t_Vec_i64_Global [view_Vec_i64_Global self]. [%#svec'0] Seq.length (view_Vec_i64_Global self)
    <= UInt64.t'int const_MAX

let new_i64 (return (x: t_Vec_i64_Global)) = any
