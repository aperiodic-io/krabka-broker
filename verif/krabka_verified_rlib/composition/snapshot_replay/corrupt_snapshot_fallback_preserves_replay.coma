        = MinMax.max (Int64.to_int range.local_start) (Int64.to_int (Seq.get (Slice64.view offsets) (UInt64.t'int index)))
      /\ newest_readable_snapshot (Slice64.view offsets) (Slice64.view outcomes) (Int64.to_int range.log_start) (Int64.to_int cut) (UInt64.t'int index)
      | Err'1 index -> UInt64.t'int index < Seq.length (Slice64.view offsets)
      /\ Seq.get (Slice64.view outcomes) (UInt64.t'int index) = (2: UInt8.t)
      /\ Int64.to_int range.log_start < Int64.to_int (Seq.get (Slice64.view offsets) (UInt64.t'int index))
      /\ Int64.to_int (Seq.get (Slice64.view offsets) (UInt64.t'int index)) <= Int64.to_int cut
      /\ newest_readable_snapshot (Slice64.view offsets) (Slice64.view outcomes) (Int64.to_int range.log_start) (Int64.to_int cut) (UInt64.t'int index)
      end)}
    (! return {result}) ]
