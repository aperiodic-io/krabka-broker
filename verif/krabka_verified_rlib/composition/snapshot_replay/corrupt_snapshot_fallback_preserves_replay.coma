type t_Option_i64 = None'0 | Some'0 Int64.t

function kafka_replay_start [#"/workspace/crates/verified/src/producer_snapshot/snapshot_transaction_valid.rs" 48 0 48 83] (range: t_ProducerReloadRange) (snapshot: t_Option_i64) : int
 = [%#ssnapshot_transaction_valid'2] match snapshot with
    | Some'0 offset -> if ge_log_Int (Int64.to_int offset) (Int64.to_int range.local_start) then
      Int64.to_int offset
    else
      Int64.to_int range.local_start

    | None'0 -> if ge_log_Int (Int64.to_int range.log_start) (Int64.to_int range.local_start) then
      Int64.to_int range.log_start
    else
      Int64.to_int range.local_start

    end

let producer_snapshot_replay_start (range: t_ProducerReloadRange) (snapshot: t_Option_i64) (return (x: t_Option_i64)) =
any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:producer_snapshot_replay_start ensures] ([@stop_split] [@expl:producer_snapshot_replay_start ensures #0] [%#sreplay_start] (result
        <> None'0)
      = (ge_log_Int (Int64.to_int range.log_start) 0
      /\ Int64.to_int range.log_start <= Int64.to_int range.log_end
      /\ ge_log_Int (Int64.to_int range.local_start) 0
      /\ Int64.to_int range.local_start <= Int64.to_int range.log_end
      /\ match snapshot with
        | Some'0 offset -> kafka_reload_keeps (Int64.to_int offset) (Int64.to_int range.log_start) (Int64.to_int range.log_end)
        | None'0 -> true
        end))
    /\ ([@stop_split] [@expl:producer_snapshot_replay_start ensures #1] [%#sreplay_start'0] forall start: Int64.t. result
        = Some'0 start -> Int64.to_int start = kafka_replay_start range snapshot)}
    (! return {result}) ]

