      | EarliestLocal -> Int64.to_int timestamp = - 4 /\ ge_log_Int (Int16.to_int version) 8
      | LatestTiered -> Int64.to_int timestamp = - 5 /\ ge_log_Int (Int16.to_int version) 9
      | EarliestPendingUpload -> Int64.to_int timestamp = - 6 /\ ge_log_Int (Int16.to_int version) 11
      | Timestamp -> ge_log_Int (Int64.to_int timestamp) 0
      | Unsupported -> Int64.to_int timestamp < - 6
      \/ Int64.to_int timestamp = - 6 /\ Int16.to_int version < 11
      \/ Int64.to_int timestamp = - 5 /\ Int16.to_int version < 9
      \/ Int64.to_int timestamp = - 4 /\ Int16.to_int version < 8
      \/ Int64.to_int timestamp = - 3 /\ Int16.to_int version < 7
