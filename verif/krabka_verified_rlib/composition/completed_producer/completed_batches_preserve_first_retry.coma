          /\ not completion_source_selected (view_Vec_usize_Global result.f1) i
        -> five_completions_above (Slice64.view ends) incoming (view_Vec_usize_Global result.f1) (Int64.to_int (Seq.get (Slice64.view ends) i)))
    /\ ([@stop_split] [@expl:producer_completion_window ensures #5] [%#scompletion'7] result.f0
        /\ not (exists j: int. 0 <= j
          /\ j < Seq.length (view_Vec_usize_Global result.f1)
          /\ completion_offset (Slice64.view ends) incoming (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j))
          = Int64.to_int incoming)
      -> five_completions_above (Slice64.view ends) incoming (view_Vec_usize_Global result.f1) (Int64.to_int incoming))
    /\ ([@stop_split] [@expl:producer_completion_window ensures #6] [%#scompletion'8] not result.f0
    -> Seq.length (view_Vec_usize_Global result.f1) = Seq.length (Slice64.view ends)
    /\ (forall j: int. 0 <= j /\ j < Seq.length (Slice64.view ends)
