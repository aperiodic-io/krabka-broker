let producer_completion_window (current': t_Option_i16) (epoch: Int16.t) (ends: Slice64.slice Int64.t)
  (incoming: Int64.t) (return (x: tup2_bool_Vec_usize_Global)) =
{[@stop_split] [@expl:producer_completion_window requires] ([@stop_split] [@expl:producer_completion_window requires #0] [%#scompletion] Seq.length (Slice64.view ends)
    <= 5)
  /\ ([@stop_split] [@expl:producer_completion_window requires #1] [%#scompletion'0] current' = None
    -> Seq.length (Slice64.view ends) = 0)
  /\ ([@stop_split] [@expl:producer_completion_window requires #2] [%#scompletion'1] strictly_increasing_i64 (Slice64.view ends))}
  any
  [ return (result: tup2_bool_Vec_usize_Global) ->
  {[@stop_split] [@expl:producer_completion_window ensures] ([@stop_split] [@expl:producer_completion_window ensures #0] [%#scompletion'2] result.f0
      = completion_epoch_accepts current' epoch)
    /\ ([@stop_split] [@expl:producer_completion_window ensures #1] [%#scompletion'3] completion_window_bounded (view_Vec_usize_Global result.f1) result.f0)
    /\ ([@stop_split] [@expl:producer_completion_window ensures #2] [%#scompletion'4] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_usize_Global result.f1)
        -> UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j) <= Seq.length (Slice64.view ends)
        /\ (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j) < Seq.length (Slice64.view ends)
          -> current' <> None
          /\ match current' with
            | Some value -> Int16.to_int epoch <= Int16.to_int value
            | None -> false
            end)
        /\ (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j) = Seq.length (Slice64.view ends)
        -> result.f0
        /\ not match current' with
          | Some value -> value = epoch
          /\ (exists i: int. 0 <= i /\ i < Seq.length (Slice64.view ends) /\ Seq.get (Slice64.view ends) i = incoming)
          | None -> false
          end))
    /\ ([@stop_split] [@expl:producer_completion_window ensures #3] [%#scompletion'5] forall i: int, j: int. 0 <= i
          /\ i < j /\ j < Seq.length (view_Vec_usize_Global result.f1)
        -> completion_offset (Slice64.view ends) incoming (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) i))
        < completion_offset (Slice64.view ends) incoming (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j)))
    /\ ([@stop_split] [@expl:producer_completion_window ensures #4] [%#scompletion'6] forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view ends)
          /\ match current' with
              | Some value -> Int16.to_int epoch <= Int16.to_int value
              | None -> false
