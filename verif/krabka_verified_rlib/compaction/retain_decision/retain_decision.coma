use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

type t_BatchMeta = { is_control: bool; producer_id: Int64.t; existing_horizon: t_Option_i64 }

type t_TxnDataState = NotTransactional | DataSurvives | DataFullyGone

type t_RetainDecision = Keep | SetHorizon Int64.t | Delete

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function compute_horizon_model [#"/workspace/crates/verified/src/compaction/retain_decision.rs" 37 0 37 74] (now_ms: Int64.t) (delete_retention_ms: Int64.t) : int
 = [%#sretain_decision'9] if gt_log_Int (Int64.to_int now_ms
  + Int64.to_int delete_retention_ms) 9223372036854775807 then
    9223372036854775807
  else
    if Int64.to_int now_ms + Int64.to_int delete_retention_ms < - 9223372036854775807 - 1 then
      - 9223372036854775807 - 1
    else
      Int64.to_int now_ms + Int64.to_int delete_retention_ms



predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate horizon_decision_matches [#"/workspace/crates/verified/src/compaction/retain_decision.rs" 61 0 61 110] (existing: t_Option_i64) (now: Int64.t) (retention: Int64.t) (decision: t_RetainDecision) =
  [%#sretain_decision'8] match existing with
    | None -> exists h: Int64.t. decision = SetHorizon h /\ Int64.to_int h = compute_horizon_model now retention
    | Some h -> decision = (if ge_log_Int (Int64.to_int now) (Int64.to_int h) then Delete else Keep)
    end

let horizon_retention (existing: t_Option_i64) (now_ms: Int64.t) (delete_retention_ms: Int64.t)
  (return (x: t_RetainDecision)) = any
  [ return (result: t_RetainDecision) ->
  {[@stop_split] [@expl:horizon_retention ensures] [%#sretain_decision'7] horizon_decision_matches existing now_ms delete_retention_ms result}
    (! return {result}) ]

type t_RecordMeta = { has_key: bool; has_value: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let retain_decision [#"/workspace/crates/verified/src/compaction/retain_decision.rs" 101 0 108 19] (rec': t_RecordMeta)
  (batch: t_BatchMeta) (is_newest_for_key: bool) (txn: t_TxnDataState) (now_ms: Int64.t) (delete_retention_ms: Int64.t)
  (return (x: t_RetainDecision)) = (! bb0
  [ bb0 = any [ br0 -> {batch.is_control = false} (! bb7) | br1 -> {batch.is_control} (! bb1) ]
  | bb1 = any
    [ br0 -> {txn = NotTransactional} (! bb5)
    | br1 -> {txn = DataSurvives} (! bb5)
    | br2 -> {txn = DataFullyGone} (! bb3) ]
  | bb3 = s0
    [ s0 = horizon_retention [%#sretain_decision] {batch.existing_horizon} {now_ms} {delete_retention_ms}
        (fun (_x: t_RetainDecision) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ]
  | bb5 = s0 [ s0 = [ &_ret <- Keep ] s1 | s1 = return {_ret} ]
  | bb7 = any [ br0 -> {rec'.has_key = false} (! bb9) | br1 -> {rec'.has_key} (! bb8) ]
  | bb8 = any [ br0 -> {is_newest_for_key = false} (! bb11) | br1 -> {is_newest_for_key} (! bb10) ]
  | bb10 = any [ br0 -> {rec'.has_value = false} (! bb13) | br1 -> {rec'.has_value} (! bb12) ]
  | bb12 = s0 [ s0 = [ &_ret <- Keep ] s1 | s1 = return {_ret} ]
  | bb13 = s0
    [ s0 = horizon_retention [%#sretain_decision'0] {batch.existing_horizon} {now_ms} {delete_retention_ms}
        (fun (_x: t_RetainDecision) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- Delete ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- Delete ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_RetainDecision = Any.any_l ()
  | & rec': t_RecordMeta = rec'
  | & batch: t_BatchMeta = batch
  | & is_newest_for_key: bool = is_newest_for_key
  | & txn: t_TxnDataState = txn
  | & now_ms: Int64.t = now_ms
  | & delete_retention_ms: Int64.t = delete_retention_ms ])
  [ return (result: t_RetainDecision) ->
  {[@stop_split] [@expl:retain_decision ensures] ([@stop_split] [@expl:retain_decision ensures #0] [%#sretain_decision'1] batch.is_control
        /\ (txn = DataSurvives \/ txn = NotTransactional) -> result = Keep)
    /\ ([@stop_split] [@expl:retain_decision ensures #1] [%#sretain_decision'2] batch.is_control /\ txn = DataFullyGone
      -> horizon_decision_matches batch.existing_horizon now_ms delete_retention_ms result)
    /\ ([@stop_split] [@expl:retain_decision ensures #2] [%#sretain_decision'3] not batch.is_control /\ not rec'.has_key
      -> result = Delete)
    /\ ([@stop_split] [@expl:retain_decision ensures #3] [%#sretain_decision'4] not batch.is_control
        /\ rec'.has_key /\ not is_newest_for_key -> result = Delete)
    /\ ([@stop_split] [@expl:retain_decision ensures #4] [%#sretain_decision'5] not batch.is_control
        /\ rec'.has_key /\ is_newest_for_key /\ rec'.has_value -> result = Keep)
    /\ ([@stop_split] [@expl:retain_decision ensures #5] [%#sretain_decision'6] not batch.is_control
      /\ rec'.has_key /\ is_newest_for_key /\ not rec'.has_value
    -> horizon_decision_matches batch.existing_horizon now_ms delete_retention_ms result)}
    (! return {result}) ]
