use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_RetainDecision = Keep | SetHorizon Int64.t | Delete

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function compute_horizon_model [#"/workspace/crates/verified/src/compaction/retain_decision.rs" 37 0 37 74] (now_ms: Int64.t) (delete_retention_ms: Int64.t) : int
 = [%#sretain_decision'3] if gt_log_Int (Int64.to_int now_ms
  + Int64.to_int delete_retention_ms) 9223372036854775807 then
    9223372036854775807
  else
    if Int64.to_int now_ms + Int64.to_int delete_retention_ms < - 9223372036854775807 - 1 then
      - 9223372036854775807 - 1
    else
      Int64.to_int now_ms + Int64.to_int delete_retention_ms



let compute_horizon (now_ms: Int64.t) (delete_retention_ms: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:compute_horizon ensures] [%#sretain_decision'1] Int64.to_int result
    = compute_horizon_model now_ms delete_retention_ms}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate horizon_decision_matches [#"/workspace/crates/verified/src/compaction/retain_decision.rs" 61 0 61 110] (existing: t_Option_i64) (now: Int64.t) (retention: Int64.t) (decision: t_RetainDecision) =
  [%#sretain_decision'2] match existing with
    | None -> exists h: Int64.t. decision = SetHorizon h /\ Int64.to_int h = compute_horizon_model now retention
    | Some h -> decision = (if ge_log_Int (Int64.to_int now) (Int64.to_int h) then Delete else Keep)
    end

