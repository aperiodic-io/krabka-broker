use creusot.int.UInt64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate keeps_extra_quota [#"/workspace/crates/verified/src/uniform_assignor/select_least_loaded.rs" 33 0 38 9] (minimum_quota: int) (extras_left: int) (owned: int) (members_left: int) =
  [%#sselect_least_loaded'0] gt_log_Int extras_left 0 /\ (gt_log_Int owned minimum_quota \/ members_left <= extras_left)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant minimum_quota : int

constant extra_quotas : int

constant owned : Seq.seq UInt64.t

constant index : int

function extras_left_before [#"/workspace/crates/verified/src/uniform_assignor/select_least_loaded.rs" 50 0 55 8] (minimum_quota: int) (extra_quotas: int) (owned: Seq.seq UInt64.t) (index: int) : int

goal vc_extras_left_before: if index <= 0 then
    true
  else
    ([@expl:variant decreases] well_founded_relation_Int ([%#sselect_least_loaded] index) ([%#sselect_least_loaded] index
      - 1))
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sselect_least_loaded] index) ([%#sselect_least_loaded] index
