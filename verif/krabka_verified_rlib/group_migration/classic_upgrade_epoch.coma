  | bb1 = any [ br0 -> {every_subscription_decodable = false} (! bb2) | br1 -> {every_subscription_decodable} (! bb3) ]
  | bb3 = s0
    [ s0 = [ &_14 <- Int32.lt generation ([%#sgroup_migration] (0: Int32.t)) ] s1
    | s1 = any [ br0 -> {_14 = false} (! bb5) | br1 -> {_14} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_13 <- [%#sgroup_migration'0] (0: Int32.t) ] s1 | s1 = bb6 ]
  | bb5 = s0 [ s0 = [ &_13 <- generation ] s1 | s1 = bb6 ]
  | bb6 = s0 [ s0 = [ &_ret <- Some _13 ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_i32 = Any.any_l ()
  | & consumer_protocol: bool = consumer_protocol
  | & every_subscription_decodable: bool = every_subscription_decodable
  | & generation: Int32.t = generation
  | & _13: Int32.t = Any.any_l ()
  | & _14: bool = Any.any_l () ])
  [ return (result: t_Option_i32) ->
  {[@stop_split] [@expl:classic_upgrade_epoch ensures] ([@stop_split] [@expl:classic_upgrade_epoch ensures #0] [%#sgroup_migration'1] (result
        <> None)
      = (consumer_protocol /\ every_subscription_decodable))
    /\ ([@stop_split] [@expl:classic_upgrade_epoch ensures #1] [%#sgroup_migration'2] forall epoch: Int32.t. result
        = Some epoch -> migration_epoch_matches (Int32.to_int generation) (Int32.to_int epoch))}
    (! return {result}) ]
