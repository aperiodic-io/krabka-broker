use creusot.int.Int64
use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

type t_Option_usize = None | Some UInt64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate stamp_range_arrays_parallel [#"/workspace/crates/verified/src/stamp.rs" 141 0 141 76] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) =
  [%#sstamp'12] Seq.length bases = Seq.length lasts

predicate stamp_cursor_in_bounds [#"/workspace/crates/verified/src/stamp.rs" 134 0 134 79] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (index: int) =
  [%#sstamp'10] index <= Seq.length bases /\ stamp_range_arrays_parallel bases lasts

predicate sorted_disjoint [#"/workspace/crates/verified/src/stamp.rs" 13 0 13 64] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) =
  [%#sstamp'11] Seq.length bases = Seq.length lasts
  /\ (forall i: int. 0 <= i /\ i < Seq.length bases -> Int64.to_int (Seq.get bases i) <= Int64.to_int (Seq.get lasts i))
  /\ (forall i: int. 1 <= i /\ i < Seq.length bases
    -> Int64.to_int (Seq.get lasts (i - 1)) < Int64.to_int (Seq.get bases i))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let stamp_range_insertion_index [#"/workspace/crates/verified/src/stamp.rs" 55 0 60 18] (bases: Slice64.slice Int64.t)
  (lasts: Slice64.slice Int64.t) (new_base: Int64.t) (new_last: Int64.t) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:stamp_range_insertion_index requires] [%#sstamp'8] sorted_disjoint (Slice64.view bases) (Slice64.view lasts)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_14 <- Int64.gt new_base new_last ] s1
    | s1 = any [ br0 -> {_14 = false} (! bb2) | br1 -> {_14} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &index <- [%#sstamp] (0: UInt64.t) ] s1 | s1 = bb3 ]
  | bb3 = bb3invariant
    [ bb3 =
      {[@expl:loop variant] well_founded_relation_Int variant_old_bb3 ([%#sstamp'0] Seq.length (Slice64.view bases)
      - UInt64.t'int index)}
      bb3invariant
    | bb3invariant =
      {[@expl:loop invariant #0] [%#sstamp'3] stamp_cursor_in_bounds (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index)}
      {[@expl:loop invariant #1] [%#sstamp'2] forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view lasts) i) < Int64.to_int new_base}
      (! [ &variant_old_bb3 <- [%#sstamp'0] Seq.length (Slice64.view bases) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#sstamp'1] {bases} (fun (_x: UInt64.t) -> [ &_35 <- _x ] s1)
      | s1 = [ &_33 <- UInt64.lt index _35 ] s2
      | s2 = any [ br0 -> {_33 = false} (! bb13) | br1 -> {_33} (! bb6) ] ]
      [ bb6 = s0
        [ s0 = [ &_41 <- index ] s1
        | s1 = [ &_42 <- Slice64.length bases ] s2
        | s2 = [ &_43 <- UInt64.lt _41 _42 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'4] _43} s4
        | s4 = Slice64.get [%#sstamp'4] <Int64.t> {bases} {_41} (fun (r: Int64.t) -> [ &_40 <- r ] s5)
        | s5 = [ &_38 <- Int64.lt new_last _40 ] s6
        | s6 = any [ br0 -> {_38 = false} (! bb9) | br1 -> {_38} (! bb8) ] ]
      | bb9 = s0
        [ s0 = [ &_50 <- index ] s1
        | s1 = [ &_51 <- Slice64.length lasts ] s2
        | s2 = [ &_52 <- UInt64.lt _50 _51 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'5] _52} s4
        | s4 = Slice64.get [%#sstamp'5] <Int64.t> {lasts} {_50} (fun (r: Int64.t) -> [ &_49 <- r ] s5)
        | s5 = [ &_47 <- Int64.le new_base _49 ] s6
        | s6 = any [ br0 -> {_47 = false} (! bb12) | br1 -> {_47} (! bb11) ] ]
      | bb12 = s0
        [ s0 = UInt64.add [%#sstamp'7] {index} {[%#sstamp'6] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &index <- _x ] s1)
        | s1 = bb3 ] ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Some index ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- Some index ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & bases: Slice64.slice Int64.t = bases
  | & lasts: Slice64.slice Int64.t = lasts
  | & new_base: Int64.t = new_base
  | & new_last: Int64.t = new_last
  | & _14: bool = Any.any_l ()
  | & index: UInt64.t = Any.any_l ()
  | & _33: bool = Any.any_l ()
  | & _35: UInt64.t = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _40: Int64.t = Any.any_l ()
  | & _41: UInt64.t = Any.any_l ()
  | & _42: UInt64.t = Any.any_l ()
  | & _43: bool = Any.any_l ()
  | & _47: bool = Any.any_l ()
  | & _49: Int64.t = Any.any_l ()
  | & _50: UInt64.t = Any.any_l ()
  | & _51: UInt64.t = Any.any_l ()
  | & _52: bool = Any.any_l ()
  | & variant_old_bb3: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:stamp_range_insertion_index ensures] [%#sstamp'9] match result with
      | Some index -> UInt64.t'int index <= Seq.length (Slice64.view bases)
      /\ Int64.to_int new_base <= Int64.to_int new_last
      /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index
          -> Int64.to_int (Seq.get (Slice64.view lasts) i) < Int64.to_int new_base)
      /\ (UInt64.t'int index = Seq.length (Slice64.view bases)
      \/ Int64.to_int new_last < Int64.to_int (Seq.get (Slice64.view bases) (UInt64.t'int index)))
      | None -> gt_log_Int (Int64.to_int new_base) (Int64.to_int new_last)
      \/ (exists i: int. 0 <= i
        /\ i < Seq.length (Slice64.view bases)
        /\ Int64.to_int (Seq.get (Slice64.view bases) i) <= Int64.to_int new_last
        /\ Int64.to_int new_base <= Int64.to_int (Seq.get (Slice64.view lasts) i))
      end}
    (! return {result}) ]
