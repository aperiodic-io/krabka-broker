use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate no_covering_stamp_range [#"/workspace/crates/verified/src/stamp.rs" 161 0 161 93] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (count: int) (offset: int) =
  [%#sstamp'10] forall i: int. 0 <= i /\ i < count
    -> offset < Int64.to_int (Seq.get bases i) \/ Int64.to_int (Seq.get lasts i) < offset

predicate stamp_range_arrays_parallel [#"/workspace/crates/verified/src/stamp.rs" 141 0 141 76] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) =
  [%#sstamp'12] Seq.length bases = Seq.length lasts

predicate stamp_cursor_in_bounds [#"/workspace/crates/verified/src/stamp.rs" 134 0 134 79] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (index: int) =
  [%#sstamp'11] index <= Seq.length bases /\ stamp_range_arrays_parallel bases lasts

type t_Option_usize = None | Some UInt64.t

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let covering_stamp_range_index [#"/workspace/crates/verified/src/stamp.rs" 118 0 118 93] (bases: Slice64.slice Int64.t)
  (lasts: Slice64.slice Int64.t) (offset: Int64.t) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:covering_stamp_range_index requires] [%#sstamp'8] stamp_range_arrays_parallel (Slice64.view bases) (Slice64.view lasts)}
  (! bb0
  [ bb0 = s0 [ s0 = [ &index <- [%#sstamp] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 =
      {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#sstamp'0] Seq.length (Slice64.view bases)
      - UInt64.t'int index)}
      bb1invariant
    | bb1invariant =
      {[@expl:loop invariant #0] [%#sstamp'3] stamp_cursor_in_bounds (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index)}
      {[@expl:loop invariant #1] [%#sstamp'2] no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index) (Int64.to_int offset)}
      (! [ &variant_old_bb1 <- [%#sstamp'0] Seq.length (Slice64.view bases) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#sstamp'1] {bases} (fun (_x: UInt64.t) -> [ &_29 <- _x ] s1)
      | s1 = [ &_27 <- UInt64.lt index _29 ] s2
      | s2 = any [ br0 -> {_27 = false} (! bb12) | br1 -> {_27} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_34 <- index ] s1
        | s1 = [ &_35 <- Slice64.length bases ] s2
        | s2 = [ &_36 <- UInt64.lt _34 _35 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'4] _36} s4
        | s4 = Slice64.get [%#sstamp'4] <Int64.t> {bases} {_34} (fun (r: Int64.t) -> [ &_33 <- r ] s5)
        | s5 = [ &_32 <- Int64.le _33 offset ] s6
        | s6 = any [ br0 -> {_32 = false} (! bb11) | br1 -> {_32} (! bb6) ] ]
      | bb6 = s0
        [ s0 = [ &_41 <- index ] s1
        | s1 = [ &_42 <- Slice64.length lasts ] s2
        | s2 = [ &_43 <- UInt64.lt _41 _42 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'5] _43} s4
        | s4 = Slice64.get [%#sstamp'5] <Int64.t> {lasts} {_41} (fun (r: Int64.t) -> [ &_40 <- r ] s5)
        | s5 = [ &_38 <- Int64.le offset _40 ] s6
        | s6 = any [ br0 -> {_38 = false} (! bb11) | br1 -> {_38} (! bb8) ] ]
      | bb11 = s0
        [ s0 = UInt64.add [%#sstamp'7] {index} {[%#sstamp'6] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &index <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Some index ] s1 | s1 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & bases: Slice64.slice Int64.t = bases
  | & lasts: Slice64.slice Int64.t = lasts
  | & offset: Int64.t = offset
  | & index: UInt64.t = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & _29: UInt64.t = Any.any_l ()
  | & _32: bool = Any.any_l ()
  | & _33: Int64.t = Any.any_l ()
  | & _34: UInt64.t = Any.any_l ()
  | & _35: UInt64.t = Any.any_l ()
  | & _36: bool = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _40: Int64.t = Any.any_l ()
  | & _41: UInt64.t = Any.any_l ()
  | & _42: UInt64.t = Any.any_l ()
  | & _43: bool = Any.any_l ()
  | & variant_old_bb1: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:covering_stamp_range_index ensures] [%#sstamp'9] match result with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view bases)
      /\ Int64.to_int (Seq.get (Slice64.view bases) (UInt64.t'int index)) <= Int64.to_int offset
      /\ Int64.to_int offset <= Int64.to_int (Seq.get (Slice64.view lasts) (UInt64.t'int index))
      /\ no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index) (Int64.to_int offset)
      | None -> no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (Seq.length (Slice64.view bases)) (Int64.to_int offset)
      end}
    (! return {result}) ]
