use creusot.int.Int64
use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate watermark_inputs_bounded [#"/workspace/crates/verified/src/consensus/watermark.rs" 8 0 8 80] (current': int) (end': int) (followers: Seq.seq Int64.t) =
  [%#swatermark'14] current' <= end'
  /\ (forall k: int. 0 <= k /\ k < Seq.length followers -> Int64.to_int (Seq.get followers k) <= end')

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 173 0 173 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'3] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 182 0 182 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'2] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus/failover.rs" 197 0 197 78] (log_end: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end s v leader_counts]. count_ge log_end s v leader_counts
    = ([%#sfailover'0] count_ge_prefix log_end s v (Seq.length s + 1) leader_counts)

let recompute_high_watermark (log_end: Int64.t) (follower_offsets: Slice64.slice Int64.t) (majority: UInt64.t)
  (epoch_start_offset: Int64.t) (current_hwm: Int64.t) (leader_counts: bool) (return (x: Int64.t)) =
{[@stop_split] [@expl:recompute_high_watermark requires] ([@stop_split] [@expl:recompute_high_watermark requires #0] [%#swatermark'7] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1)
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #1] [%#swatermark'8] leader_counts
    \/ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets))
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #2] [%#swatermark'9] watermark_inputs_bounded (Int64.to_int current_hwm) (Int64.to_int log_end) (Slice64.view follower_offsets))}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:recompute_high_watermark ensures] ([@stop_split] [@expl:recompute_high_watermark ensures #0] [%#swatermark'10] ge_log_Int (Int64.to_int result) (Int64.to_int current_hwm))
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #1] [%#swatermark'11] Int64.to_int result
      <= Int64.to_int log_end)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #2] [%#swatermark'12] forall v: int. gt_log_Int v (Int64.to_int epoch_start_offset)
          /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) v leader_counts) (UInt64.t'int majority)
        -> v <= Int64.to_int result)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #3] [%#swatermark'13] gt_log_Int (Int64.to_int result) (Int64.to_int current_hwm)
    -> gt_log_Int (Int64.to_int result) (Int64.to_int epoch_start_offset)
    /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int result) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let majority_watermark [#"/workspace/crates/verified/src/consensus/watermark.rs" 145 0 150 8] (log_end: Int64.t)
  (follower_offsets: Slice64.slice Int64.t) (majority: UInt64.t) (current': Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:majority_watermark requires] ([@stop_split] [@expl:majority_watermark requires #0] [%#swatermark'1] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1)
  /\ ([@stop_split] [@expl:majority_watermark requires #1] [%#swatermark'2] watermark_inputs_bounded (Int64.to_int current') (Int64.to_int log_end) (Slice64.view follower_offsets))}
  (! bb0
  [ bb0 = s0
    [ s0 = recompute_high_watermark [%#swatermark'0] {log_end} {follower_offsets} {majority} {current'} {current'}
        {[%#swatermark] true} (fun (_x: Int64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & follower_offsets: Slice64.slice Int64.t = follower_offsets
  | & majority: UInt64.t = majority
  | & current': Int64.t = current' ])
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:majority_watermark ensures] ([@stop_split] [@expl:majority_watermark ensures #0] [%#swatermark'3] ge_log_Int (Int64.to_int result) (Int64.to_int current'))
    /\ ([@stop_split] [@expl:majority_watermark ensures #1] [%#swatermark'4] Int64.to_int result
      <= Int64.to_int log_end)
    /\ ([@stop_split] [@expl:majority_watermark ensures #2] [%#swatermark'5] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) v true) (UInt64.t'int majority)
        -> v <= Int64.to_int result)
    /\ ([@stop_split] [@expl:majority_watermark ensures #3] [%#swatermark'6] gt_log_Int (Int64.to_int result) (Int64.to_int current')
    -> ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int result) true) (UInt64.t'int majority))}
    (! return {result}) ]
