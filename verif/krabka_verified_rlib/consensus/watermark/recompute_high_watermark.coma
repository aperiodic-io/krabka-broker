let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 173 0 173 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 182 0 182 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'3] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus/failover.rs" 197 0 197 78] (log_end: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end s v leader_counts]. count_ge log_end s v leader_counts
    = ([%#sfailover'0] count_ge_prefix log_end s v (Seq.length s + 1) leader_counts)

let candidate_has_majority (log_end: Int64.t) (follower_offsets: Slice64.slice Int64.t) (cand: Int64.t)
  (majority: UInt64.t) (leader_counts: bool) (return (x: bool)) =
{[@stop_split] [@expl:candidate_has_majority requires] [%#swatermark'21] 1 <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:candidate_has_majority ensures] [%#swatermark'22] result
    = ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int cand) leader_counts) (UInt64.t'int majority)}
    (! return {result}) ]

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let lemma_hwm_member_maximal (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (best: Int64.t)
  (leader_counts: bool) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_member_maximal requires] ([@stop_split] [@expl:lemma_hwm_member_maximal requires #0] [%#slog_is_up_to_date] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1)
  /\ ([@stop_split] [@expl:lemma_hwm_member_maximal requires #1] [%#slog_is_up_to_date'0] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view s) + 1
      /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) leader_counts) (UInt64.t'int majority)
    -> hwm_member_at (Int64.to_int log_end) (Slice64.view s) k <= Int64.to_int best)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_member_maximal ensures] [%#slog_is_up_to_date'1] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
      -> v <= Int64.to_int best}
    (! return {result}) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] ge_log_Int (deep_model_i64 result) (deep_model_i64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] ge_log_Int (deep_model_i64 result) (deep_model_i64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

predicate watermark_inputs_bounded [#"/workspace/crates/verified/src/consensus/watermark.rs" 8 0 8 80] (current': int) (end': int) (followers: Seq.seq Int64.t) =
  [%#swatermark'23] current' <= end'
  /\ (forall k: int. 0 <= k /\ k < Seq.length followers -> Int64.to_int (Seq.get followers k) <= end')

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

