type t_Option_i64 = None | Some Int64.t

type tup2_Option_i64_Option_i64 = { f0: t_Option_i64; f1: t_Option_i64 }

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let retention_delete_target (last_offset: t_Option_i64) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:retention_delete_target ensures] [%#sdelete_target] match { f0 = last_offset; f1 = result } with
      | {f0 = None; f1 = result'0} -> result'0 = None
      | {f0 = Some last; f1 = None} -> Int64.to_int last = Int64.to_int const_MAX
      | {f0 = Some last; f1 = Some target} -> Int64.to_int last < Int64.to_int const_MAX
      /\ Int64.to_int target = Int64.to_int last + 1
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_i64) (return (f0'0: Int64.t)) = any
  [ _k (f0'0: Int64.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] ge_log_Int (deep_model_i64 result) (deep_model_i64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] ge_log_Int (deep_model_i64 result) (deep_model_i64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

type tup2_i64_bool = { f0'0: Int64.t; f1'0: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

