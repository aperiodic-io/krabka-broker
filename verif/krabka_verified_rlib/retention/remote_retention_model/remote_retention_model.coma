(* #"/workspace/crates/verified/src/retention/remote_retention_model.rs" 184 0 184 94 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sremote_retention_model = "/workspace/crates/verified/src/retention/remote_retention_model.rs" 183 10 183 28

use creusot.int.UInt64
use seq.Seq
use int.Int

type t_RemoteRetentionSegment = { log_start_breached: bool; time_expired: bool; size: UInt64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant segments : Seq.seq t_RemoteRetentionSegment

constant i : int

constant debt : int

function remote_retention_model [#"/workspace/crates/verified/src/retention/remote_retention_model.rs" 184 0 184 94] (segments: Seq.seq t_RemoteRetentionSegment) (i: int) (debt: int) : int

goal vc_remote_retention_model: if ge_log_Int i (Seq.length segments) then
    true
  else
    if (Seq.get segments i).log_start_breached then
      [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] Seq.length segments
      - i) ([%#sremote_retention_model] Seq.length segments - (i + 1))
    else
      if (Seq.get segments i).time_expired then
        if UInt64.t'int (Seq.get segments i).size <= debt then
          [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] Seq.length segments
          - i) ([%#sremote_retention_model] Seq.length segments - (i + 1))
        else
          [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] Seq.length segments
          - i) ([%#sremote_retention_model] Seq.length segments - (i + 1))

      else
        if gt_log_Int debt 0 then
          if UInt64.t'int (Seq.get segments i).size <= debt then
            [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] Seq.length segments
            - i) ([%#sremote_retention_model] Seq.length segments - (i + 1))
          else
            true

        else
          true
