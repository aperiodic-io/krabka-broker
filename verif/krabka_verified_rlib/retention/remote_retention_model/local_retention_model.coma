(* #"/workspace/crates/verified/src/retention/remote_retention_model.rs" 67 0 73 8 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sremote_retention_model = "/workspace/crates/verified/src/retention/remote_retention_model.rs" 66 10 66 19

use creusot.int.UInt64
use seq.Seq
use int.Int

type t_LocalRetentionSegment = { blocked: bool; expired: bool; size: UInt64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant segments : Seq.seq t_LocalRetentionSegment

constant limit : int

constant i : int

constant debt : int

constant sizing : bool

function local_retention_model [#"/workspace/crates/verified/src/retention/remote_retention_model.rs" 67 0 73 8] (segments: Seq.seq t_LocalRetentionSegment) (limit: int) (i: int) (debt: int) (sizing: bool) : int

goal vc_local_retention_model: if ge_log_Int i limit then
    true
  else
    if ge_log_Int i (Seq.length segments) then
      true
    else
      if (Seq.get segments i).blocked then
        true
      else
        if sizing then
          if UInt64.t'int (Seq.get segments i).size <= debt then
            [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] limit
            - i) ([%#sremote_retention_model] limit - (i + 1))
          else
            if (Seq.get segments i).expired then
              [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] limit
              - i) ([%#sremote_retention_model] limit - (i + 1))
            else
              true


        else
          if (Seq.get segments i).expired then
            [@expl:variant decreases] well_founded_relation_Int ([%#sremote_retention_model] limit
            - i) ([%#sremote_retention_model] limit - (i + 1))
          else
            true
