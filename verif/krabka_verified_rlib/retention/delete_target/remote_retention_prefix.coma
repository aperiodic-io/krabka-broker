predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_RemoteRetentionSegment = { blocked: bool; log_start_breached: bool; time_expired: bool; size: UInt64.t }

let len_RemoteRetentionSegment (self_: Slice64.slice t_RemoteRetentionSegment) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

function remote_retention_model [#"/workspace/crates/verified/src/retention/remote_retention_model.rs" 184 0 184 94] (segments: Seq.seq t_RemoteRetentionSegment) (i: int) (debt: int) : int

axiom remote_retention_model_def:
  forall segments: Seq.seq t_RemoteRetentionSegment, i: int, debt: int [remote_retention_model segments i debt]. remote_retention_model segments i debt
    = ([%#sremote_retention_model'0] if ge_log_Int i (Seq.length segments) \/ (Seq.get segments i).blocked then
      i
    else
      if (Seq.get segments i).log_start_breached then
        remote_retention_model segments (i + 1) debt
      else
        if (Seq.get segments i).time_expired then
          remote_retention_model segments (i + 1) (if UInt64.t'int (Seq.get segments i).size <= debt then
            debt - UInt64.t'int (Seq.get segments i).size
          else
            0
          )
        else
          if gt_log_Int debt 0 /\ UInt64.t'int (Seq.get segments i).size <= debt then
            remote_retention_model segments (i + 1) (debt - UInt64.t'int (Seq.get segments i).size)
          else
            i



    )

predicate remote_charge_funded [#"/workspace/crates/verified/src/retention.rs" 74 0 74 78] (debt: int) (charged: int) (next_charge: int) =
  [%#sretention] gt_log_Int debt 0 /\ charged < debt /\ next_charge <= debt

function remote_prefix_charge [#"/workspace/crates/verified/src/retention/remote_bytes.rs" 9 0 9 85] (segments: Seq.seq t_RemoteRetentionSegment) (count: int) : int

axiom remote_prefix_charge_def:
  forall segments: Seq.seq t_RemoteRetentionSegment, count: int [remote_prefix_charge segments count]. remote_prefix_charge segments count
    = ([%#sremote_bytes'0] if count <= 0 then
      0
    else
      remote_prefix_charge segments (count - 1)
      + (if (Seq.get segments (count - 1)).log_start_breached then
        0
      else
        UInt64.t'int (Seq.get segments (count - 1)).size
      )
    )

predicate retention_prefix_funded [#"/workspace/crates/verified/src/retention/delete_target.rs" 93 0 93 96] (segments: Seq.seq t_RemoteRetentionSegment) (debt: int) (count: int) =
  [%#sdelete_target'19] forall i: int. 0 <= i /\ i < count
    -> not (Seq.get segments i).blocked
    /\ ((Seq.get segments i).log_start_breached
    \/ (Seq.get segments i).time_expired
    \/ remote_charge_funded debt (remote_prefix_charge segments i) (remote_prefix_charge segments (i + 1)))

constant const_MIN: UInt64.t = (0: UInt64.t)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let saturating_sub (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:saturating_sub ensures] ([@stop_split] [@expl:saturating_sub ensures #0] [%#snum] ge_log_Int (UInt64.t'int self_
          - UInt64.t'int rhs) (UInt64.t'int const_MIN)
        /\ UInt64.t'int self_ - UInt64.t'int rhs <= UInt64.t'int const_MAX
      -> UInt64.t'int result = UInt64.t'int self_ - UInt64.t'int rhs)
    /\ ([@stop_split] [@expl:saturating_sub ensures #1] [%#snum'0] UInt64.t'int self_ - UInt64.t'int rhs
        < UInt64.t'int const_MIN -> UInt64.t'int result = UInt64.t'int const_MIN)
    /\ ([@stop_split] [@expl:saturating_sub ensures #2] [%#snum'1] gt_log_Int (UInt64.t'int self_
      - UInt64.t'int rhs) (UInt64.t'int const_MAX) -> UInt64.t'int result = UInt64.t'int const_MAX)}
    (! return {result}) ]

