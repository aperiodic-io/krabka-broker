predicate snapshot_entry_valid_model [#"/workspace/crates/verified/src/producer_snapshot/replay_start.rs" 14 0 14 98] (snapshot_offset: int) (entry: t_ProducerSnapshotEntryFacts) =
  [%#sreplay_start'18] ge_log_Int snapshot_offset 0
