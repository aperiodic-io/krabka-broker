  {[@stop_split] [@expl:upper_range_cursor ensures] ([@stop_split] [@expl:upper_range_cursor ensures #0] [%#slog_index'0] UInt64.t'int result
      <= Seq.length (Slice64.view entries))
    /\ ([@stop_split] [@expl:upper_range_cursor ensures #1] [%#slog_index'1] forall i: int. 0 <= i
          /\ i < UInt64.t'int result -> Int64.to_int (Seq.get (Slice64.view entries) i).f0 <= Int64.to_int target)
    /\ ([@stop_split] [@expl:upper_range_cursor ensures #2] [%#slog_index'2] forall i: int. UInt64.t'int result <= i
        /\ i < Seq.length (Slice64.view entries)
      -> not Int64.to_int (Seq.get (Slice64.view entries) i).f0 <= Int64.to_int target)}
