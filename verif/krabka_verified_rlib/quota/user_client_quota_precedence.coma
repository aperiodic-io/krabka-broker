(* #"/workspace/crates/verified/src/quota.rs" 169 0 169 93 *)

let%span squota = "/workspace/crates/verified/src/quota.rs" 131 10 132 60
let%span squota'0 = "/workspace/crates/verified/src/quota.rs" 133 10 135 78
let%span squota'1 = "/workspace/crates/verified/src/quota.rs" 136 10 139 63
let%span squota'2 = "/workspace/crates/verified/src/quota.rs" 140 10 142 78
let%span squota'3 = "/workspace/crates/verified/src/quota.rs" 143 10 146 65
let%span squota'4 = "/workspace/crates/verified/src/quota.rs" 147 10 151 65
let%span squota'5 = "/workspace/crates/verified/src/quota.rs" 152 10 154 65
let%span squota'6 = "/workspace/crates/verified/src/quota.rs" 155 10 158 67
let%span squota'7 = "/workspace/crates/verified/src/quota.rs" 159 10 167 67
let%span squota'8 = "/workspace/crates/verified/src/quota.rs" 115 16 117 57
let%span squota'9 = "/workspace/crates/verified/src/quota.rs" 123 16 126 59

use creusot.prelude.Any

type t_QuotaCandidatePresence = Absent | Present

type t_UserClientQuotaFacts = {
  exact_pair: t_QuotaCandidatePresence;
  exact_user_default_client: t_QuotaCandidatePresence;
  exact_user: t_QuotaCandidatePresence;
  default_user_exact_client: t_QuotaCandidatePresence;
  default_pair: t_QuotaCandidatePresence;
  default_user: t_QuotaCandidatePresence;
  exact_client: t_QuotaCandidatePresence;
  default_client: t_QuotaCandidatePresence }

type t_UserClientQuotaPrecedence =
  | ExactPair
  | ExactUserDefaultClient
  | ExactUser
  | DefaultUserExactClient
  | DefaultPair
  | DefaultUser
  | ExactClient
  | DefaultClient
  | None

predicate exact_user_quota_absent [#"/workspace/crates/verified/src/quota.rs" 114 0 114 67] (facts: t_UserClientQuotaFacts) =
  [%#squota'8] facts.exact_pair = Absent /\ facts.exact_user_default_client = Absent /\ facts.exact_user = Absent

predicate all_user_quota_absent [#"/workspace/crates/verified/src/quota.rs" 122 0 122 61] (facts: t_UserClientQuotaFacts) =
  [%#squota'9] exact_user_quota_absent facts
  /\ facts.default_user_exact_client = Absent /\ facts.default_pair = Absent /\ facts.default_user = Absent

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let user_client_quota_precedence [#"/workspace/crates/verified/src/quota.rs" 169 0 169 93]
  (facts: t_UserClientQuotaFacts) (return (x: t_UserClientQuotaPrecedence)) = (! bb0
  [ bb0 = any [ br0 -> {facts.exact_pair = Absent} (! bb1) | br1 -> {facts.exact_pair = Present} (! bb3) ]
  | bb1 = s0 [ s0 = [ &_30 <- false ] s1 | s1 = bb4 ]
  | bb3 = s0 [ s0 = [ &_30 <- true ] s1 | s1 = bb4 ]
  | bb4 = any [ br0 -> {_30 = false} (! bb6) | br1 -> {_30} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_ret <- ExactPair ] s1 | s1 = return {_ret} ]
  | bb6 = any
    [ br0 -> {facts.exact_user_default_client = Absent} (! bb7)
    | br1 -> {facts.exact_user_default_client = Present} (! bb9) ]
  | bb7 = s0 [ s0 = [ &_32 <- false ] s1 | s1 = bb10 ]
  | bb9 = s0 [ s0 = [ &_32 <- true ] s1 | s1 = bb10 ]
  | bb10 = any [ br0 -> {_32 = false} (! bb12) | br1 -> {_32} (! bb11) ]
  | bb11 = s0 [ s0 = [ &_ret <- ExactUserDefaultClient ] s1 | s1 = return {_ret} ]
  | bb12 = any [ br0 -> {facts.exact_user = Absent} (! bb13) | br1 -> {facts.exact_user = Present} (! bb15) ]
  | bb13 = s0 [ s0 = [ &_34 <- false ] s1 | s1 = bb16 ]
  | bb15 = s0 [ s0 = [ &_34 <- true ] s1 | s1 = bb16 ]
  | bb16 = any [ br0 -> {_34 = false} (! bb18) | br1 -> {_34} (! bb17) ]
  | bb17 = s0 [ s0 = [ &_ret <- ExactUser ] s1 | s1 = return {_ret} ]
  | bb18 = any
    [ br0 -> {facts.default_user_exact_client = Absent} (! bb19)
    | br1 -> {facts.default_user_exact_client = Present} (! bb21) ]
  | bb19 = s0 [ s0 = [ &_36 <- false ] s1 | s1 = bb22 ]
  | bb21 = s0 [ s0 = [ &_36 <- true ] s1 | s1 = bb22 ]
  | bb22 = any [ br0 -> {_36 = false} (! bb24) | br1 -> {_36} (! bb23) ]
  | bb23 = s0 [ s0 = [ &_ret <- DefaultUserExactClient ] s1 | s1 = return {_ret} ]
  | bb24 = any [ br0 -> {facts.default_pair = Absent} (! bb25) | br1 -> {facts.default_pair = Present} (! bb27) ]
  | bb25 = s0 [ s0 = [ &_38 <- false ] s1 | s1 = bb28 ]
  | bb27 = s0 [ s0 = [ &_38 <- true ] s1 | s1 = bb28 ]
  | bb28 = any [ br0 -> {_38 = false} (! bb30) | br1 -> {_38} (! bb29) ]
  | bb29 = s0 [ s0 = [ &_ret <- DefaultPair ] s1 | s1 = return {_ret} ]
  | bb30 = any [ br0 -> {facts.default_user = Absent} (! bb31) | br1 -> {facts.default_user = Present} (! bb33) ]
  | bb31 = s0 [ s0 = [ &_40 <- false ] s1 | s1 = bb34 ]
  | bb33 = s0 [ s0 = [ &_40 <- true ] s1 | s1 = bb34 ]
  | bb34 = any [ br0 -> {_40 = false} (! bb36) | br1 -> {_40} (! bb35) ]
  | bb35 = s0 [ s0 = [ &_ret <- DefaultUser ] s1 | s1 = return {_ret} ]
  | bb36 = any [ br0 -> {facts.exact_client = Absent} (! bb37) | br1 -> {facts.exact_client = Present} (! bb39) ]
  | bb37 = s0 [ s0 = [ &_42 <- false ] s1 | s1 = bb40 ]
  | bb39 = s0 [ s0 = [ &_42 <- true ] s1 | s1 = bb40 ]
  | bb40 = any [ br0 -> {_42 = false} (! bb42) | br1 -> {_42} (! bb41) ]
  | bb41 = s0 [ s0 = [ &_ret <- ExactClient ] s1 | s1 = return {_ret} ]
  | bb42 = any [ br0 -> {facts.default_client = Absent} (! bb43) | br1 -> {facts.default_client = Present} (! bb45) ]
  | bb43 = s0 [ s0 = [ &_44 <- false ] s1 | s1 = bb46 ]
  | bb45 = s0 [ s0 = [ &_44 <- true ] s1 | s1 = bb46 ]
  | bb46 = any [ br0 -> {_44 = false} (! bb48) | br1 -> {_44} (! bb47) ]
  | bb47 = s0 [ s0 = [ &_ret <- DefaultClient ] s1 | s1 = return {_ret} ]
  | bb48 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_UserClientQuotaPrecedence = Any.any_l ()
  | & facts: t_UserClientQuotaFacts = facts
  | & _30: bool = Any.any_l ()
  | & _32: bool = Any.any_l ()
  | & _34: bool = Any.any_l ()
  | & _36: bool = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _40: bool = Any.any_l ()
  | & _42: bool = Any.any_l ()
  | & _44: bool = Any.any_l () ])
  [ return (result: t_UserClientQuotaPrecedence) ->
  {[@stop_split] [@expl:user_client_quota_precedence ensures] ([@stop_split] [@expl:user_client_quota_precedence ensures #0] [%#squota] (result
        = ExactPair)
      = (facts.exact_pair = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #1] [%#squota'0] (result = ExactUserDefaultClient)
      = (facts.exact_pair = Absent /\ facts.exact_user_default_client = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #2] [%#squota'1] (result = ExactUser)
      = (facts.exact_pair = Absent /\ facts.exact_user_default_client = Absent /\ facts.exact_user = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #3] [%#squota'2] (result = DefaultUserExactClient)
      = (exact_user_quota_absent facts /\ facts.default_user_exact_client = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #4] [%#squota'3] (result = DefaultPair)
      = (exact_user_quota_absent facts /\ facts.default_user_exact_client = Absent /\ facts.default_pair = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #5] [%#squota'4] (result = DefaultUser)
      = (exact_user_quota_absent facts
      /\ facts.default_user_exact_client = Absent /\ facts.default_pair = Absent /\ facts.default_user = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #6] [%#squota'5] (result = ExactClient)
      = (all_user_quota_absent facts /\ facts.exact_client = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #7] [%#squota'6] (result = DefaultClient)
      = (all_user_quota_absent facts /\ facts.exact_client = Absent /\ facts.default_client = Present))
    /\ ([@stop_split] [@expl:user_client_quota_precedence ensures #8] [%#squota'7] (result = None)
    = (not (facts.exact_pair = Present
    \/ facts.exact_user_default_client = Present
    \/ facts.exact_user = Present
    \/ facts.default_user_exact_client = Present
    \/ facts.default_pair = Present
    \/ facts.default_user = Present \/ facts.exact_client = Present \/ facts.default_client = Present)))}
    (! return {result}) ]
