use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_OAuthExpiryPresence = Missing | Present

type t_OAuthSessionCap = Disabled | Enabled

type t_OAuthAuthenticationKind = Initial | Reauthentication

type t_OAuthPrincipalMatch = Matches | Differs

type t_OAuthSessionFacts = {
  expiry: t_OAuthExpiryPresence;
  token_expires_at_ms: Int64.t;
  now_ms: Int64.t;
  cap: t_OAuthSessionCap;
  cap_ms: Int64.t;
  authentication: t_OAuthAuthenticationKind;
  principal: t_OAuthPrincipalMatch }

type t_OAuthSessionDecision = Reject | Admit Int64.t Int64.t

type tup2_OAuthAuthenticationKind_OAuthPrincipalMatch = { f0: t_OAuthAuthenticationKind; f1: t_OAuthPrincipalMatch }

type t_Option_i64 = None | Some Int64.t

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let checked_sub (self_: Int64.t) (rhs: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:checked_sub ensures] ([@stop_split] [@expl:checked_sub ensures #0] [%#snum] (result = None)
      = (Int64.to_int self_ - Int64.to_int rhs < Int64.to_int const_MIN
      \/ gt_log_Int (Int64.to_int self_ - Int64.to_int rhs) (Int64.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_sub ensures #1] [%#snum'0] forall r: Int64.t. result = Some r
      -> Int64.to_int r = Int64.to_int self_ - Int64.to_int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_i64) (return (f0'0: Int64.t)) = any
  [ _k (f0'0: Int64.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum'3] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let min_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:min_i64 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_i64 result
      <= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_i64 result <= deep_model_i64 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_i64 self_ < deep_model_i64 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_i64 o <= deep_model_i64 self_ -> result = o)}
    (! return {result}) ]

let checked_add (self_: Int64.t) (rhs: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum'1] (result = None)
      = (Int64.to_int self_ + Int64.to_int rhs < Int64.to_int const_MIN
      \/ gt_log_Int (Int64.to_int self_ + Int64.to_int rhs) (Int64.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'2] forall r: Int64.t. result = Some r
      -> Int64.to_int r = Int64.to_int self_ + Int64.to_int rhs)}
    (! return {result}) ]

predicate oauth_session_admissible_at [#"/workspace/crates/verified/src/oauth.rs" 56 0 56 85] (facts: t_OAuthSessionFacts) (now: int) =
  [%#soauth'6] facts.expiry = Present
  /\ gt_log_Int (Int64.to_int facts.token_expires_at_ms) now
  /\ Int64.to_int facts.token_expires_at_ms - now <= Int64.to_int const_MAX
  /\ (facts.cap = Disabled \/ gt_log_Int (Int64.to_int facts.cap_ms) 0)
  /\ (facts.authentication = Initial \/ facts.principal = Matches)

predicate oauth_session_admissible [#"/workspace/crates/verified/src/oauth.rs" 76 0 76 65] (facts: t_OAuthSessionFacts) =
  [%#soauth'4] oauth_session_admissible_at facts (Int64.to_int facts.now_ms)

function oauth_session_lifetime [#"/workspace/crates/verified/src/oauth.rs" 86 0 86 62] (facts: t_OAuthSessionFacts) : int
 = [%#soauth'5] let token_lifetime = Int64.to_int facts.token_expires_at_ms - Int64.to_int facts.now_ms in if facts.cap
    = Enabled
  /\ Int64.to_int facts.cap_ms < token_lifetime then
    Int64.to_int facts.cap_ms
  else
    token_lifetime


