predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function sum_prefix [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 9 0 9 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#squorum_survives_any_single_site_loss'14] if limit <= 0 then
      0
    else
      sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1))
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function lemma_sum_prefix_step [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 35 0 35 53] (s: Seq.seq Int64.t) (limit: int) : ()
 = [%#squorum_survives_any_single_site_loss'17] ()

axiom lemma_sum_prefix_step_spec: forall s: Seq.seq Int64.t, limit: int. ([%#squorum_survives_any_single_site_loss'15] 1
        <= limit
      /\ limit <= Seq.length s)
    -> ([%#squorum_survives_any_single_site_loss'16] sum_prefix s limit
    = sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))

function lemma_sum_prefix_nonnegative [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 46 0 46 60] (s: Seq.seq Int64.t) (limit: int) : ()

axiom lemma_sum_prefix_nonnegative_def:
  forall s: Seq.seq Int64.t, limit: int [lemma_sum_prefix_nonnegative s limit]. ([%#squorum_survives_any_single_site_loss'8] 0
        <= limit
      /\ limit <= Seq.length s)
    -> ([%#squorum_survives_any_single_site_loss'9] forall k: int. 0 <= k /\ k < limit
        -> ge_log_Int (Int64.to_int (Seq.get s k)) 0)
    -> lemma_sum_prefix_nonnegative s limit
    = ([%#squorum_survives_any_single_site_loss'11] if gt_log_Int limit 0 then
      let _ = lemma_sum_prefix_nonnegative s (limit - 1) in let _ = lemma_sum_prefix_step s limit in ()
    else
      ()
    )

axiom lemma_sum_prefix_nonnegative_spec:
  forall s: Seq.seq Int64.t, limit: int. ([%#squorum_survives_any_single_site_loss'8] 0 <= limit
      /\ limit <= Seq.length s)
    -> ([%#squorum_survives_any_single_site_loss'9] forall k: int. 0 <= k /\ k < limit
        -> ge_log_Int (Int64.to_int (Seq.get s k)) 0)
    -> ([%#squorum_survives_any_single_site_loss'10] ge_log_Int (sum_prefix s limit) 0)

function sum_all [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 24 0 24 34] (s: Seq.seq Int64.t) : int
 = [%#squorum_survives_any_single_site_loss'12] sum_prefix s (Seq.length s)

