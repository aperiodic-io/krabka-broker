let lemma_two_sites_never_survive [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 68 0 68 61]
  (voters_per_site: Slice64.slice Int64.t) (return (x: ())) =
{[@stop_split] [@expl:lemma_two_sites_never_survive requires] ([@stop_split] [@expl:lemma_two_sites_never_survive requires #0] [%#squorum_survives_any_single_site_loss'4] Seq.length (Slice64.view voters_per_site)
    = 2)
