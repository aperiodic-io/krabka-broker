        <= k
      /\ k < 2 -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) k)) 0)}
  (! bb0
  [ bb0 = s0
    [ s0 =
      {[@expl:assertion] [%#squorum_survives_any_single_site_loss] let _ = lemma_sum_prefix_nonnegative (Slice64.view voters_per_site) (Seq.length (Slice64.view voters_per_site)) in ge_log_Int (sum_all (Slice64.view voters_per_site)) 0}
      s1
    | s1 = {[@expl:assertion] [%#squorum_survives_any_single_site_loss'0] sum_prefix (Slice64.view voters_per_site) 1
      = Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)}
      s2
    | s2 = {[@expl:assertion] [%#squorum_survives_any_single_site_loss'1] sum_all (Slice64.view voters_per_site)
      = Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)
      + Int64.to_int (Seq.get (Slice64.view voters_per_site) 1)}
      s3
    | s3 =
      {[@expl:assertion] [%#squorum_survives_any_single_site_loss'2] ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)) (Int64.to_int (Seq.get (Slice64.view voters_per_site) 1))
      -> 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) 0))
      <= sum_all (Slice64.view voters_per_site)}
      s4
    | s4 =
      {[@expl:assertion] [%#squorum_survives_any_single_site_loss'3] ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) 1)) (Int64.to_int (Seq.get (Slice64.view voters_per_site) 0))
      -> 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) 1))
      <= sum_all (Slice64.view voters_per_site)}
      s5
    | s5 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & voters_per_site: Slice64.slice Int64.t = voters_per_site ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_two_sites_never_survive ensures] [%#squorum_survives_any_single_site_loss'6] exists k: int. 0
        <= k
      /\ k < Seq.length (Slice64.view voters_per_site)
      /\ 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) k))
      <= sum_all (Slice64.view voters_per_site)}
    (! return {result}) ]
