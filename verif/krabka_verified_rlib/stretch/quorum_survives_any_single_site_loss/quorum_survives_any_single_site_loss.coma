function sum_prefix [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 9 0 9 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#squorum_survives_any_single_site_loss'29] if limit <= 0 then
      0
    else
      sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1))
    )

function sum_all [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 24 0 24 34] (s: Seq.seq Int64.t) : int
