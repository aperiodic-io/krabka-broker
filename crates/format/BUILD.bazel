load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files([
    "Cargo.toml",
    "tests/fixtures/bootstrap.records.bin",
])

crate_library(name = "format")

# `bazel run //crates/format:krabka-format -- --log-dir /var/lib/krabka --standalone ...`
crate_binary(
    name = "krabka-format",
    crate_root = "src/main.rs",
    lib = ":format",
)

crate_tests(
    compile_data = ["tests/fixtures/bootstrap.records.bin"],
    # `format_smoke` runs the binary and reads back what it wrote.
    data = [":krabka-format"],
    env = {"CARGO_BIN_EXE_krabka-format": "$(rootpath :krabka-format)"},
    lib = "format",
)
