load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "remote-storage")

# `krabka-worm-verify verify` — audits a WORM archive with read-only credentials.
crate_binary(
    name = "krabka-worm-verify",
    crate_root = "src/bin/worm-verify.rs",
    lib = ":remote-storage",
)

crate_tests(
    compile_data = glob(["tests/fixtures/*.bin"]),
    # `worm_verify_cli` runs the binary against an archive it writes.
    data = [":krabka-worm-verify"],
    # `gcs_emulator` drives the native GCS backend's read, delete and
    # WORM-startup paths against `fake-gcs-server`, so it needs the emulator
    # image. //bazel/images pins it by digest and
    # loads it before the suite runs. `jvm_tiered_storage` drives a real Kafka.
    docker = {
        "gcs_emulator": ["fake_gcs_server"],
        "jvm_tiered_storage": ["apache_kafka_4_0_0"],
    },
    env = {"CARGO_BIN_EXE_krabka-worm-verify": "$(rootpath :krabka-worm-verify)"},
    lib = "remote-storage",
)
