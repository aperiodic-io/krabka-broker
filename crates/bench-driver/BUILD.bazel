load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "bench-driver")

# What `bench/manifests/driver/job-template.yaml` runs in the cluster.
crate_binary(
    name = "krabka-bench-driver",
    crate_root = "src/main.rs",
    lib = ":bench-driver",
)

# Starts a local krabka cluster from the release binaries and runs one scenario
# against it; see `src/local_main.rs`.
crate_binary(
    name = "krabka-bench-local",
    crate_root = "src/local_main.rs",
    lib = ":bench-driver",
)

# The aggregator. `bench/justfile`'s report recipes run this one.
crate_binary(
    name = "krabka-bench-report",
    crate_root = "src/report_main.rs",
    lib = ":bench-driver",
)

crate_tests(
    # `scenario_files` loads every checked-in scenario through the driver's own
    # loader, and `report_cli` runs the report binary the way an operator does.
    data = [
        ":krabka-bench-report",
        "//bench:scenarios",
    ],
    env = {"CARGO_BIN_EXE_krabka-bench-report": "$(rootpath :krabka-bench-report)"},
    lib = "bench-driver",
    # `scenario_files` is `harness = false`: datatest-stable supplies its own.
    no_harness = ["scenario_files"],
)
