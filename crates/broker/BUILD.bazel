load("//bazel:defs.bzl", "crate_bench", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# No rule claims a bench source: benches are a Cargo-only concern here, declared
# by a `[[bench]]` section and nothing else. CI's container-suite selection still
# feeds the change's touched `crates/**` paths to `rdeps`, which takes a target
# set, and one path Bazel does not know fails the whole query. Exporting them
# makes them targets that reach nothing, which is the true answer.
exports_files(glob(["benches/*.rs"]))

crate_library(name = "broker")

# The broker server. `bazel run //crates/broker:krabka-broker -- --help`.
crate_binary(
    name = "krabka-broker",
    crate_root = "src/bin/broker.rs",
    lib = ":broker",
)

# The six criterion benches in `benches/`. `bazel build //...` compiles them and
# `bazel test //...` lints them. `ci.yml`'s nightly `bench` job runs them.
crate_bench(lib = "broker")

crate_tests(
    # TLS certificates, Kerberos keytabs and captured Kafka frames. The TLS
    # material is `include_str!`ed by the suites that serve it and the keytabs
    # are opened at run time, so both lists are needed.
    compile_data = glob(["tests/fixtures/**"]) + ["//crates/format:tests/fixtures/bootstrap.records.bin"],
    # Measure elapsed wall-clock time and assert a bound on it, so they are
    # timing-sensitive the way //crates/raft's engine simulation is: they pass in
    # the test run and fail under coverage instrumentation, which is a statement
    # about the instrumentation rather than about the code. `diskless_e2e` and
    # `sharegroup_backlog` assert on a committed high-watermark across three
    # brokers; `diskless_e2e` boots three such clusters at once, one per case,
    # and every case gates on a quorum-committed watermark inside a bounded
    # deadline.
    #
    # `durability` and `leader_election` each kill a broker and time the acks=-1
    # produce that the resulting ISR shrink unblocks. The wait cannot finish
    # before `replica_lag_time_max` elapses and must complete a few seconds
    # after it, and instrumentation stretches only the second half: `durability`
    # allows five seconds for a ~2s shrink, which leaves three for a detection
    # loop the profiler has slowed down. `ip_quotas` asserts the opposite
    # baseline -- five unthrottled connections inside 500ms -- which is bounded
    # by scheduling rather than by a timer, and so is the shape instrumentation
    # stretches most.
    #
    # `stretch_cluster` is `durability` again across three sites: it stops a
    # site's broker and then retries an acks=all produce against a 30-second
    # deadline, which the controller can only satisfy once it has committed the
    # ISR shrink for the replicas that went with the site. The same second half
    # is what stretches -- it passed the uninstrumented `test` step and both
    # local runs (~30s) on the commit whose `coverage` run failed it at 72s,
    # with the coverage job running ~140 suites in parallel on four cores.
    #
    # `deliver_at_time` measures elapsed time too and is deliberately absent:
    # its bound only separates a long poll woken by the delivery advance (~2s)
    # from one that waited out its 20s `max.wait.ms`. That wake is timer-driven,
    # so instrumentation does not move it.
    #
    # `compaction` joins the list on the same evidence recorded above for
    # `stretch_cluster`: it passed the uninstrumented `test` step and repeated
    # local runs of the commit whose `coverage` run failed it. It waits on the
    # cleaner through `wait_for_metrics`, and that 30-second
    # `TEST_AWAITER_TIMEOUT` does not stretch when the background loop it is
    # waiting for is slowed by the profiler -- one bounded wait on a delayed
    # loop, the same shape as `durability`. Its per-test log was not captured
    # before the tag went on, so that mechanism is read off the code rather
    # than off a failure message; if it fails again, read the log first.
    #
    # `auth_handlers` was briefly on this list and was removed: its failure was
    # not an instrumentation artifact at all. `oauthbearer_sessions.rs` minted
    # tokens with `now_unix_secs() + 1`, and since that helper truncates to
    # whole seconds the handshake had between zero and one second to finish
    # before the token it was presenting expired. Under load it lost that race
    # and the broker rejected the token, which is a racy test rather than a
    # slow one. The tokens now carry enough life for the open and the tests
    # wait out whatever remains, so the suite belongs in the ordinary set.
    #
    # `tiered_storage_multi_broker` is the shape this list already describes,
    # and it joins on that rather than on a failure message. It boots three
    # brokers per case, kills the leader, and then gates on state the survivors
    # must commit through the quorum inside a bounded deadline -- a minute for
    # the copy and the follower catch-up, thirty seconds for the reassignment.
    # That is `diskless_e2e`'s three-broker watermark and `durability`'s
    # post-kill wait in one suite, and the profiler stretches the same second
    # half of it.
    #
    # The evidence is weaker than the entries above and is recorded as such.
    # Two `coverage` runs on the pull request that added this suite each failed
    # one suite out of 208, and a different one each time -- `break_glass`, then
    # `transaction_version` -- while `coverage` was green on `main`. Both pass
    # locally, both pass run concurrently with this suite, and both pass with
    # that trio running under eight spinners on the same four cores the runner
    # has. Neither per-test log could be read: BuildBuddy wants a login and the
    # job uploads no test-log artifact. So the mechanism here is the one
    # `stretch_cluster` records -- ~140 suites in parallel on four cores -- read
    # off this suite's cost and its 69.6s wall clock rather than off a message,
    # and the two casualties are left untagged because nothing yet says they
    # are anything but starved. If either fails again once this suite is out of
    # the lane, that reading was wrong: read its log before tagging it.
    #
    # `elect_leaders` is `leader_election`'s shape again: a 3-broker cluster
    # driven over the wire, gated on `wait_for_image` waits for the resulting
    # partition state to land in the controller's committed metadata image.
    # On the run that surfaced it (PR #1098, a listener-scope routing change
    # that touches neither leader election nor metadata propagation) the whole
    # target first failed the Bazel test-size timeout, then on re-run two
    # individual cases -- `auto_rebalance_restores_preferred_leader` and
    # `preferred_election_via_wire_returns_success` -- failed the 30s
    # `TEST_AWAITER_TIMEOUT` bound inside `wait_for_image`, each reporting the
    # image still short of the target offset rather than a wrong one. Both are
    # convergence waits, not assertion failures, so the fix is the same one
    # `leader_election` already has: give the suite the CPU a raft quorum needs
    # to commit under contention instead of loosening what it checks.
    #
    # Leaving the lane costs no coverage. Of the 118 `//crates/broker` targets
    # in that run only four emit a `coverage.dat` -- `broker_test`,
    # `cli_smoke_test`, `config_reference_test` and `krabka-broker_test` -- and
    # this suite, like the other 114, contributes none. It still runs on every
    # pull request, in the `test` step that exists for this tag.
    cpu_heavy = [
        "compaction",
        "diskless_e2e",
        "durability",
        "elect_leaders",
        "ip_quotas",
        "leader_election",
        "sharegroup_backlog",
        "stretch_cluster",
        "tiered_storage_multi_broker",
    ],
    # The generated config schema and reference, and the example configs, are
    # checked in under //docs. `config_reference`, `docgen_contract` and
    # `example_broker_toml` read them back and compare or parse them, so a
    # schema change that is not regenerated fails here as well as in the docs
    # job.
    data = glob(["tests/fixtures/**"]) + [
        ":krabka-broker",
        "//docs:config-reference.md",
        "//docs:config-schema.json",
        "//docs:examples/broker-single-node.toml",
        "//docs:examples/broker-three-node-quorum.toml",
        # `metrics_contract` reads the published dashboard, the alert rules and
        # the checked-in `/metrics` body; `support::manifest_dir()` resolves
        # them under `$TEST_SRCDIR/$TEST_WORKSPACE/docs/operations`.
        "//docs/operations:contract",
    ],
    # The runnable example only needs normal dependencies. Keeping the live
    # Schema Registry dev dependency out also avoids loading its older
    # krabka-audit beside this workspace's crate under coverage instrumentation.
    doc_test_dev_deps = False,
    docker = {
        # One image, used twice: as the client that reads krabka's advertised
        # table and as the Kafka broker that table is compared against.
        "api_versions_differential": ["apache_kafka_4_3_1"],
        # The JVM console consumer that reads the acknowledged ledger back at
        # the end of the fault schedule, for the byte differential against a
        # client this project does not write.
        "diskless_jepsen": ["cp_kafka_7_4_0"],
        # The `fetch.min.bytes` floor, sent as identical bytes to krabka and to
        # a stock broker of the newest pinned release. The hermetic half of the
        # same exchange is `fetch_min_bytes`, which needs no image.
        "fetch_min_bytes_jvm": ["apache_kafka_4_3_1"],
        "jvm_acceptance_cli": [
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        # transactional_tv2 compiles the JVM producer where a `javac` exists
        # (cp-kafka:7.5.0) and runs the class under the 4.3.1 client jars.
        "jvm_acceptance_durability": [
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        # A pinned full Linux image holds the local-driver tmpfs volume open
        # while the packaged broker mounts and exhausts it.
        "jbod_enospc": ["apache_kafka_4_3_1"],
        "jvm_acceptance_freeze": ["cp_kafka_7_5_0"],
        "jvm_acceptance_legacy": [
            "cp_kafka_3_1_2",
            "cp_kafka_6_1_1",
        ],
        "jvm_acceptance_quotas": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        # The 4.3.1 image twice over: the `--generate` and election-selector
        # cases run its tools against krabka and against a stock broker of the
        # same release, the way `unavailable_partitions_jvm` does.
        "jvm_acceptance_reassign": [
            "apache_kafka_4_3_1",
            "cp_kafka_7_5_0",
        ],
        # As above, for the `kafka-acls` shorthands: the oracle half is a
        # 4.3.1 broker with `StandardAuthorizer` turned on.
        "jvm_acceptance_sasl": [
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_acceptance_tiered": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_8_8",
            "minio",
            "minio_mc",
        ],
        "jvm_acceptance_tls": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_barrier_markers": ["cp_kafka_7_5_0"],
        "jvm_bootstrap_controller": ["apache_kafka_4_3_1"],
        # KIP-412 dynamic log levels. The 4.3.1 tool because its non-`--all`
        # describe asks `DescribeCluster` whether the broker exists before it
        # prints anything, which no older tool does.
        "jvm_broker_loggers": ["apache_kafka_4_3_1"],
        # A stock `connect-distributed` worker (the Apache image carries both
        # `connect-distributed.sh` and the FileStream connector jar) plus the
        # Confluent tools this suite reads the internal topic configs with.
        "jvm_connect_distributed": [
            "apache_kafka_4_3_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_consumer_group_next_gen": [
            "apache_kafka_4_0_0",
            "cp_kafka_7_4_0",
        ],
        # Kafka's own `__consumer_offsets` formatters, out of the 4.3.1 tools
        # jar, over the topic krabka writes. The 4.0.0 image is the KIP-848
        # client that puts the later key versions in front of them, the same
        # client `jvm_consumer_group_next_gen` uses.
        "jvm_consumer_offsets_formatter": [
            "apache_kafka_4_0_0",
            "apache_kafka_4_3_1",
        ],
        # The probe compiles a Java helper in-container, so it needs the image
        # that ships a JDK with `javac` alongside the Kafka client jars.
        "jvm_deliver_at_time": ["cp_kafka_7_5_0"],
        "jvm_features": ["apache_kafka_4_3_1"],
        "jvm_kip320_divergence": [
            "apache_kafka_4_0_0",
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_role_separated_admin": ["apache_kafka_4_3_1"],
        "jvm_share_groups": ["apache_kafka_4_1_0"],
        "jvm_static_quorum_spike": ["apache_kafka_4_0_0"],
        # The compiled `KafkaStreams` topology: `cp-kafka:7.5.0` ships the
        # `javac` that builds it, and the Apache image the KIP-1071
        # `group.protocol=streams` run needs.
        "jvm_streams_app": [
            "apache_kafka_4_3_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_streams_groups": ["apache_kafka_4_1_0"],
        "kraft_checkpoint_jvm": ["apache_kafka_4_0_0"],
        # Two kcats: the 2021 published one, whose librdkafka predates KIP-848
        # and KIP-714, and the one assembled here against librdkafka 2.15.0,
        # which reaches both. Neither is a substitute for the other -- the row
        # the older one holds is that a client from before those KIPs still
        # talks to krabka.
        "librdkafka_conformance": [
            "kcat_1_7_1",
            "kcat_librdkafka_2x",
        ],
        # MirrorMaker 2 out of the same image, mirroring a source cluster of
        # that release onto krabka: `connect-mirror-maker.sh` and the stock
        # broker it replicates from are both in it, so the migration path is
        # one image.
        "mirror_maker2": ["apache_kafka_4_3_1"],
        # `kaf`, a Go CLI on sarama: the one client in this tree that is
        # neither librdkafka nor the JVM, so its decoder agrees with neither
        # by construction.
        "sarama_conformance": ["kaf_sarama"],
        # One image, used twice: as the `kafka-topics` client that reads
        # krabka's answer and as the Kafka broker the same command is run
        # against for the differential.
        "unavailable_partitions_jvm": ["apache_kafka_4_3_1"],
        # Same image set as `jvm_acceptance_tiered`: the suite reuses that
        # harness's producer, consumer and topic-create helpers, and adds an
        # Object-Lock bucket that `mc` creates and then fails to empty.
        "worm_object_lock": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_8_8",
            "minio",
            "minio_mc",
        ],
    },
    # `cli_smoke` boots the real binary and finds it through the variable Cargo
    # exports for a `[[bin]]` in the same package. Bazel exports no such thing,
    # so the same name is set here from the binary's own target.
    env = {"CARGO_BIN_EXE_krabka-broker": "$(rootpath :krabka-broker)"},
    # The suites that run brokers as real processes out of //packaging's image
    # rather than as in-process handles. For `process_kill_durability` that is
    # what makes a `docker kill -s KILL` a kill of the thing that holds the log;
    # for `soak` it is what makes a resident set and a descriptor count readable
    # per broker from `/proc`. Neither needs a Kafka image, so neither names a
    # `docker` entry: //bazel/defs.bzl gives them the Docker wrapper on the
    # strength of this list alone.
    #
    # `soak` runs for four hours and is scheduled-only. Its `#[ignore]` keeps it
    # out of `cargo test`, the `docker` tag keeps it out of `bazel test //...`,
    # and `.aspect/container_suites.axl` drops it from every `docker`-matrix
    # selection -- the `soak` job in `.github/workflows/ci.yml` is the one place
    # that names it, and it passes a `--test_timeout` because Bazel's longest
    # built-in timeout is an hour.
    krabka_image = [
        "jbod_enospc",
        "process_kill_durability",
        "soak",
    ],
    lib = "broker",
    # Suites whose `#[ignore]`d cases drive real containers, and the images
    # each one starts. //bazel/images pins those by digest and //bazel/defs.bzl
    # loads them before the suite runs, so nothing is pulled mid-test.
    # `describe_groups_jvm` records a real-Kafka fixture into `tests/fixtures/`
    # rather than reading one, so it is a recording tool and not a test: a Bazel
    # test cannot write to the source tree, and should not want to. It still
    # runs under Cargo, which is where fixtures get regenerated.
    # `gssapi_e2e` cannot use the digest-pinned lane: its locally built KDC
    # fixture writes keytabs into the fixture directory and must be
    # Docker-Compose-managed.
    manual = [
        "describe_groups_jvm",
        "gssapi_e2e",
    ],
    # 212k lines: a full sweep is nightly-sized even sharded this far.
    mutants_shards = 32,
    # Every mutant rebuilds 212k lines, so a shard is dominated by rustc, not by
    # the 20.5s test baseline: a full sweep is hours of work however it is split.
    # This is the one crate that needs the longer per-shard bound.
    mutants_timeout = "eternal",
    # The digest //MODULE.bazel pins for each container image, as compile-time
    # environment. `src/codes/tests/kafka_error_table.rs` is a checked-in copy of
    # Kafka's `Errors` enum and records which image it was extracted from; the
    # guard beside it compares that record with the live pin, so bumping the
    # image fails the guard until the table is re-derived. `build.rs` emits the
    # same variables under Cargo.
    unit_rustc_env_files = ["//bazel/images:pinned_digests"],
    # The unit target runs four exhaustive stateright models at once --
    # `classic_wide` (~483k states) and the three `data_path_model` configs --
    # each CPU-bound for a minute or more. Sharing the four cores with three
    # other test actions pushed the target past its 300s bound, with all four
    # still running when it timed out. `cpu:4` reserves the cores; it is not
    # `timing-sensitive`, so the target stays in the main test lane and keeps
    # contributing coverage.
    unit_tags = ["cpu:4"],
)
