"""Select the container suites a change must run."""

load("./changes.axl", "run", "valid_base")

_BROKER_PACKAGE = "//crates/broker"
_BROKER_TARGET_PREFIX = _BROKER_PACKAGE + ":"
_DOCKER_TEST_SUFFIX = "_docker_test"

# The suites live under `//crates`, all but one: the container image and the
# suite that loads it and runs every operator binary it carries are assembled in
# `//packaging`. Scoping the queries to the crates alone would never select it.
_SUITE_SCOPE = "//crates/... + //packaging/..."

_IMAGE_SUITE_TARGET = "//packaging:image_docker_test"

# A change to either selects every broker suite: this is where a dependency the
# whole crate re-links against comes from.
_BROKER_MANIFEST_PATHS = ["crates/broker/BUILD.bazel", "crates/broker/Cargo.toml"]

# Nothing under `//crates` reaches the image's layer list, so no broker feature
# rule selects the image suite and rdeps cannot help either: most files under
# `packaging/` are inputs to an apko or rules_img rule rather than Bazel targets,
# and one that is not a target fails the whole `set(...)` query. Match the
# directory instead -- everything in it either changes what the image carries or
# changes what the suite asserts about it.
_IMAGE_PATH_PREFIXES = ["packaging/"]

# The broker suites that run brokers as processes out of that same image, and so
# have to be selected by a `packaging/` change for the same reason the image
# suite is. `//crates/broker:BUILD.bazel` names them in `krabka_image`; they are
# named here too because the rdeps query cannot see the image's layer list from
# a broker source file any better than it can from `packaging/`.
_IMAGE_SUITES = ["jbod_enospc", "process_kill_durability"]

# Suites that are not `jvm_acceptance_*` but are built out of that harness --
# they `mod jvm_acceptance` for `start_host_broker` and `broker0_advertised` --
# so a change under `crates/broker/tests/jvm_acceptance/` reaches them too. The
# path rule below cannot see that: it maps a touched path to the suite of the
# same name, and these suites' names are not the harness's.
_HARNESS_BORROWERS = [
    "librdkafka_conformance",
    "sarama_conformance",
    "worm_object_lock",
]

# Container suites that must never enter this matrix, whatever a change
# touches. `soak` runs a three-broker cluster under continuous load for four
# hours: no pull request can wait for it, and putting it in the nightly's
# twelve-way shard would put four hours on the critical path of a job that
# otherwise finishes in one. It has a scheduled lane of its own in
# `.github/workflows/ci.yml`, which names
# `//crates/broker:soak_docker_test` directly.
#
# This is the only reason a suite belongs here. A suite that is merely slow
# still runs in the matrix; a suite whose own job already runs it does not.
_OWN_LANE_SUITES = ["soak"]

# Rust is one Bazel target at crate granularity, so rdeps turns every broker
# source change into every broker container suite. These are the narrower
# feature contracts worth gating on a PR; the complete matrix remains nightly.
_FEATURE_RULES = [
    ([
        "crates/broker/src/authorizer",
        "crates/broker/src/oauth_",
        "crates/broker/src/audit_authorizer",
        "crates/broker/src/network/auth",
        "crates/broker/src/network/dispatch/sasl",
        "crates/broker/src/raft_handshake/sasl",
        "crates/broker/src/raft_handshake/authorization",
        "crates/broker/src/handlers/create_acls",
        "crates/broker/src/handlers/delete_acls",
        "crates/broker/src/handlers/describe_acls",
        "crates/broker/src/handlers/acl_",
    ], ["jvm_acceptance_sasl"]),
    ([
        "crates/broker/src/tls_reload",
        "crates/broker/src/network/tls",
        "crates/broker/src/network/ktls",
        "crates/broker/src/config/tls",
        "crates/broker/src/config/listeners",
    ], ["jvm_acceptance_tls"]),
    ([
        "crates/broker/src/quota",
        "crates/broker/src/throttle",
        "crates/broker/src/handlers/alter_client_quotas",
        "crates/broker/src/handlers/describe_client_quotas",
        "crates/broker/src/handlers/alter_user_scram_credentials",
        "crates/broker/src/handlers/describe_user_scram_credentials",
        "crates/broker/src/config/quota",
        "crates/broker/src/config/throttle",
    ], ["jvm_acceptance_quotas"]),
    ([
        "crates/broker/src/reassignment",
        "crates/broker/src/future_log",
        "crates/broker/src/leader_election",
        "crates/broker/src/handlers/alter_partition_reassignments",
        "crates/broker/src/handlers/list_partition_reassignments",
        "crates/broker/src/handlers/elect_leaders",
    ], ["jvm_acceptance_reassign"]),
    ([
        "crates/broker/src/remote_log_manager",
        "crates/broker/src/remote_reader",
        "crates/broker/src/broker/remote_storage",
        "crates/broker/src/config/tiered_storage",
        "crates/broker/src/config/broker_config/remote_storage",
        "crates/broker/src/file_config/remote_storage",
    ], ["jvm_acceptance_tiered", "worm_object_lock"]),
    ([
        "crates/broker/src/freeze",
        "crates/broker/src/break_glass",
        "crates/broker/src/operator_keys",
        "crates/broker/src/config/freeze",
        "crates/broker/src/config/break_glass",
        "crates/broker/src/handlers/describe_configs/resources/write_freeze",
    ], ["jvm_acceptance_freeze"]),
    (["crates/broker/src/barrier"], ["jvm_barrier_markers"]),
    ([
        "crates/broker/src/delivery",
        "crates/broker/src/config_keys/delivery",
        "crates/broker/src/handlers/produce/delivery",
        "crates/broker/src/share_partition/state/deferral",
    ], ["jvm_deliver_at_time"]),
    ([
        "crates/broker/src/share_coordinator",
        "crates/broker/src/share_partition",
        "crates/broker/src/broker/handle/share_state",
        "crates/broker/src/handlers/share_",
        "crates/broker/src/handlers/alter_share",
        "crates/broker/src/handlers/delete_share",
        "crates/broker/src/handlers/describe_share",
    ], ["jvm_share_groups"]),
    ([
        "crates/broker/src/coordinator/unified/streams",
        "crates/broker/src/coordinator/unified/replay_streams",
        "crates/broker/src/coordinator/unified/streams_conversion",
        "crates/broker/src/handlers/streams_group",
    ], ["jvm_streams_groups", "jvm_streams_app"]),
    # A distributed Kafka Connect worker backs its config, offset and status
    # stores with `KafkaBasedLog`: three compacted topics it creates, the end
    # offsets it reads before it will serve, and the replay from the beginning
    # that follows. Those two are the broker surfaces the worker will not boot
    # without, so they are what selects the suite.
    ([
        "crates/broker/src/cleaner",
        "crates/broker/src/handlers/list_offsets",
    ], ["jvm_connect_distributed"]),
    ([
        "crates/broker/src/features.rs",
        "crates/broker/src/handlers/update_features",
        "crates/broker/src/handlers/api_versions/feature_keys",
        "crates/broker/src/config/feature_flags",
    ], ["jvm_features"]),
    ([
        "crates/broker/src/replicator",
        "crates/broker/src/replicator_supervisor",
        "crates/broker/src/future_log",
        "crates/broker/src/handlers/offset_for_leader_epoch",
    ], ["jvm_kip320_divergence"]),
    ([
        "crates/broker/src/raft_handshake",
        "crates/broker/src/wal/quorum",
    ], ["jvm_static_quorum_spike"]),
    # What survives a kill is decided in the log crate: the fsync policy, the
    # segment write path and the open-time tail recovery that reads back what
    # the write path left. `process_kill_durability` is the only suite that
    # exercises any of the three against a process that really died.
    ([
        "crates/log/src/config.rs",
        "crates/log/src/recovery.rs",
        "crates/log/src/segment",
        "crates/log/src/log/open.rs",
    ], ["process_kill_durability"]),
    ([
        "crates/broker/src/handlers/describe_configs/resources/broker_logger",
        "crates/broker/src/handlers/incremental_alter_configs/broker_logger_scope",
        "crates/broker/src/handlers/describe_cluster",
    ], ["jvm_broker_loggers"]),
    ([
        "crates/broker/src/heartbeat",
        "crates/broker/src/broker/registration",
        "crates/broker/src/broker/liveness",
        "crates/broker/src/controller_admin",
        "crates/broker/src/metadata_source/quorum_forwarder.rs",
        "crates/broker/src/metadata_source/observer_source.rs",
        "crates/broker/src/handlers/incremental_alter_configs.rs",
    ], ["jvm_role_separated_admin"]),
    ([
        "crates/broker/src/txn",
        "crates/broker/src/producer_state",
        "crates/broker/src/partition_writer",
        "crates/broker/src/broker/replication",
        # The produce handler is the caller of the three above: it is what a
        # JVM producer's acks=all write runs through, so the durability suite
        # is the container gate on it. Without this entry the writer and the
        # dedup tracker were gated while the handler that drives them was not,
        # and a change to the handler alone selected no container suite. The
        # `handlers/produce/delivery` subtree keeps its own KFC-1 suite and
        # now selects both.
        "crates/broker/src/handlers/produce",
    ], ["jvm_acceptance_durability"]),
    ([
        "crates/broker/src/legacy_fetch",
        "crates/broker/src/handlers/offset_fetch/legacy",
    ], ["jvm_acceptance_legacy"]),
    # The leader/ISR projection `kafka-topics --describe
    # --unavailable-partitions` reads. The tool keys on
    # `!hasLeader() || !live.contains(leader.id())`, so the suite has to follow
    # whatever answers those two columns, not just the offline-replica list.
    ([
        "crates/broker/src/handlers/offline_replicas",
        "crates/broker/src/handlers/metadata",
        "crates/broker/src/handlers/describe_topic_partitions",
        # The differential waits on the state these produce before it reads the
        # leader and ISR columns: a regression here makes the suite time out or
        # disagree with Kafka, not merely render a wrong column.
        "crates/broker/src/handlers/broker_heartbeat",
        "crates/broker/src/log_dir",
        "crates/broker/src/handlers/describe_log_dirs",
    ], ["unavailable_partitions_jvm"]),
    # The packaged-process acceptance boundary for a real ENOSPC: the writer
    # marks the directory, heartbeat publishes it, election moves the leader,
    # and restart materializes the replica on the recovered directory.
    ([
        "crates/broker/src/partition_writer",
        "crates/broker/src/heartbeat",
        "crates/broker/src/log_dir",
        "crates/broker/src/leader_election",
        "crates/broker/src/replicator_supervisor",
    ], ["jbod_enospc"]),
    # `kafka-configs --describe --all` renders the synonym chain, the config
    # source and the config type; all three come out of the DescribeConfigs
    # entry builder.
    ([
        "crates/broker/src/handlers/describe_configs",
        # `--describe --all` renders defaults, types and the synonym chain out
        # of the key registry, so a provenance change there is exactly what the
        # rendered-string assertions catch.
        "crates/broker/src/config_keys",
        # The suite's create/describe/delete lifecycle: the successful delete
        # case is the one production path it protects.
        "crates/broker/src/handlers/delete_topics",
        "crates/broker/src/handlers/create_topics",
        "crates/broker/src/handlers/create_partitions",
    ], ["jvm_acceptance_cli"]),
    # The `__consumer_offsets` wire bytes. Burrow and the other lag monitors
    # decode them with Kafka's internal schemas rather than asking the broker,
    # so a divergence in this codec is invisible to every other suite: the
    # broker still answers `OffsetFetch` correctly. Kafka's own formatters run
    # over the topic in this one, so the codec selects it.
    ([
        "crates/broker/src/coordinator/unified/persistence",
    ], ["jvm_consumer_offsets_formatter"]),
    # Every tool that speaks `--bootstrap-controller` reaches the broker through
    # this router's SUPPORTED_APIS.
    ([
        "crates/broker/src/controller_admin",
    ], ["jvm_bootstrap_controller"]),
]

_UNIFIED_PREFIX = "crates/broker/src/coordinator/unified/"
_UNIFIED_EXCLUSIONS = [
    _UNIFIED_PREFIX + "streams/",
    _UNIFIED_PREFIX + "streams_",
    _UNIFIED_PREFIX + "replay_streams",
    _UNIFIED_PREFIX + "share/",
]

def _starts_with_any(value, prefixes):
    for prefix in prefixes:
        if value.startswith(prefix):
            return True
    return False

def _target(suite):
    return _BROKER_TARGET_PREFIX + suite + _DOCKER_TEST_SUFFIX

def _without_own_lane(targets):
    """`targets` minus the suites that have a scheduled lane of their own.

    Applied to the raw `bazel query` answer as well as inside `_select`,
    because the full-matrix run -- a schedule or a dispatch, where there is no
    merge base to narrow by -- takes every docker-tagged target verbatim and
    never reaches the path-based selection at all.
    """
    kept = []
    for label in targets:
        if label in [_target(suite) for suite in _OWN_LANE_SUITES]:
            continue
        kept.append(label)
    return kept

def _broker_suites(available_targets):
    suites = {}
    for label in available_targets:
        if label.startswith(_BROKER_TARGET_PREFIX) and label.endswith(_DOCKER_TEST_SUFFIX):
            suite = label[len(_BROKER_TARGET_PREFIX):-len(_DOCKER_TEST_SUFFIX)]
            if suite not in _OWN_LANE_SUITES:
                suites[suite] = True
    return suites

def _mapped_suites():
    suites = {"jvm_consumer_group_next_gen": True}
    for suite in _IMAGE_SUITES:
        suites[suite] = True
    for _, selected in _FEATURE_RULES:
        for suite in selected:
            suites[suite] = True
    return suites

def _select(paths, available_targets):
    broker_suites = _broker_suites(available_targets)
    missing = []
    for suite in _mapped_suites().keys():
        if suite not in broker_suites:
            missing.append(suite)
    if missing:
        fail("unknown broker container suites: " + ", ".join(sorted(missing)))
    if _IMAGE_SUITE_TARGET not in available_targets:
        fail("unknown container suite: " + _IMAGE_SUITE_TARGET)

    acceptance_suites = {}
    for suite in broker_suites.keys():
        if suite.startswith("jvm_acceptance_") or suite in _HARNESS_BORROWERS:
            acceptance_suites[suite] = True

    suites = {}
    image = False
    for raw_path in paths:
        path = raw_path.strip().replace("\\", "/")
        if path:
            if _starts_with_any(path, _IMAGE_PATH_PREFIXES):
                image = True
                for suite in _IMAGE_SUITES:
                    suites[suite] = True

            if path in _BROKER_MANIFEST_PATHS:
                # The image suite is the only one that runs the broker and the
                # operator tools under the apko base's own loader and libc, and a
                # manifest is where a new dynamic dependency enters. A `.rs` edit
                # cannot add one, so broker sources keep going through the
                # feature map alone rather than building an image every PR.
                image = True
                for suite in broker_suites.keys():
                    suites[suite] = True
            elif _starts_with_any(path, ["crates/broker/tests/support/", "crates/broker/tests/fixtures/"]):
                for suite in broker_suites.keys():
                    suites[suite] = True
            elif path.startswith("crates/broker/tests/jvm_acceptance/"):
                for suite in acceptance_suites.keys():
                    suites[suite] = True
            elif path.startswith("crates/broker/tests/"):
                relative = path[len("crates/broker/tests/"):]
                root = relative.split("/")[0]
                suite = root[:-3] if root.endswith(".rs") else root
                if suite in broker_suites:
                    suites[suite] = True

            for prefixes, selected in _FEATURE_RULES:
                if _starts_with_any(path, prefixes):
                    for suite in selected:
                        suites[suite] = True

            if path.startswith(_UNIFIED_PREFIX) and not _starts_with_any(path, _UNIFIED_EXCLUSIONS):
                suites["jvm_consumer_group_next_gen"] = True

    targets = [_target(suite) for suite in suites.keys()]
    if image:
        targets.append(_IMAGE_SUITE_TARGET)
    return sorted(targets)

# How many matrix entries the selection is allowed to become. GitHub runs at
# most twenty jobs from one workflow at a time, and the container suites are
# both the slowest thing on a PR and the widest: with one entry per target the
# matrix stopped fitting, and the jobs past the cap did not start until the
# first of the earlier twenty had finished. That puts a second suite's runtime
# on the critical path for no extra parallelism, and it does so silently -- the
# matrix still says every suite ran. A dozen groups fit in one wave with room
# for the rest of the workflow's jobs beside them, and a group of two suites
# costs the sum of two suites rather than a wave.
_MAX_JOBS = 12

def _suite_name(label):
    """The short, human-facing name of a container suite target."""
    name = label.split(":")[1]
    if name.endswith(_DOCKER_TEST_SUFFIX):
        name = name[:-len(_DOCKER_TEST_SUFFIX)]
    return name

def _package(label):
    """The Bazel package half of a label: everything before the colon."""
    return label.split(":")[0]

def _packages(targets):
    """The sorted target list bucketed by package, as `[package, members]`.

    One pass, because a sorted label list already has each package's targets
    contiguous: they share the whole `//path:` prefix, and no label from
    another package can sort between two that do.
    """
    buckets = []
    for label in targets:
        package = _package(label)
        if buckets and buckets[-1][0] == package:
            buckets[-1][1].append(label)
        else:
            buckets.append([package, [label]])
    return buckets

def _chunks(items, count):
    """`items` split into `count` contiguous chunks, as evenly as possible.

    Contiguous rather than dealt round-robin, and that is the whole point of
    this function. Neighbours in a sorted label list are the targets with the
    most to share -- the same crate, the same fixture image, the same analysis
    -- and a group is one `bazel test` invocation, so putting neighbours in one
    group is what makes a group cheaper than the suites in it run separately.
    Dealing them out instead maximally scatters exactly the targets that would
    otherwise have shared a compile.

    The first `len(items) % count` chunks take one extra member, so no chunk is
    more than one target larger than another. The caller never passes a `count`
    above `len(items)`: an empty `targets` string would run `bazel test` with
    no argument, which tests nothing and passes.
    """
    size = len(items) // count
    wide = len(items) % count
    chunks = []
    start = 0
    for index in range(count):
        length = size + 1 if index < wide else size
        chunks.append(items[start:start + length])
        start += length
    return chunks

def _capacity(members):
    """How many groups a package's targets can usefully be split across.

    One per container suite it holds. A package's other docker-tagged targets
    are the layers of a fixture image -- `base`, `base_oci`, `image_load` --
    and those are one build however many labels it takes to spell it: splitting
    them across jobs does not halve anything, it makes two runners build the
    same image. So a package with no suite in it is worth exactly one group,
    and the seats its target count would otherwise have won go to a package
    that can spend them on an actual second suite.
    """
    suites = 0
    for label in members:
        if label.endswith(_DOCKER_TEST_SUFFIX):
            suites += 1
    return suites if suites else 1

def _total(values):
    running = 0
    for value in values:
        running += value
    return running

def _allocate(counts, capacities, budget):
    """How many groups each package gets out of `budget`, by largest remainder.

    Every package gets one group before anything else is shared out. A group
    that straddled two packages would put two unrelated crates' compiles on one
    runner, which is the cost this grouping exists to avoid, so the budget buys
    subdivision within a package and never a merge across one.

    What is left is shared out in proportion to how many targets each package
    holds: floor every exact share, then hand the seats that flooring lost to
    the packages whose dropped fractions were largest. Remainders are compared
    as the integer numerators `spare * count - share * total` rather than as
    fractions, because integers make the ordering exact and Starlark has no
    reason to introduce a float here. Ties go to the larger package and then to
    the earlier one, so the allocation is a function of the sorted input alone
    and a re-run of the same commit produces the same matrix.

    `capacities` caps what a package can hold, so the deal is by target count
    but never buys a group that would run nothing new. The cap strands seats --
    a package of one cannot use the second group its fraction won -- so the
    strays are dealt round by round, in the same remainder order, to whoever
    can still hold one. The loop is bounded by the budget because each pass
    spends at least one seat or ends the deal.
    """
    total = _total(counts)
    spare = budget - len(counts)

    allocation = []
    remainders = []
    for index, count in enumerate(counts):
        share = (spare * count) // total
        capacity = capacities[index]
        allocation.append(1 + share if 1 + share < capacity else capacity)
        remainders.append(spare * count - share * total)

    order = sorted(
        [index for index in range(len(counts))],
        key = lambda index: (-remainders[index], -counts[index], index),
    )
    for _ in range(budget):
        stray = budget - _total(allocation)
        if stray <= 0:
            break
        spent = 0
        for index in order:
            if spent < stray and allocation[index] < capacities[index]:
                allocation[index] += 1
                spent += 1
        if spent == 0:
            break
    return allocation

def _group_name(members):
    """What a matrix entry calls itself, and so what a red check is named.

    A container suite's own name when the group runs one -- that is the string
    a reviewer greps the logs for. A group that runs none is the fixture-image
    package, whose targets are `base`, `image_load` and the like: names that
    say nothing on their own, so it is named for the package that holds them.
    The `+N` counts the members behind the first, because the full list does
    not fit in a check name and a count is enough to find the job.
    """
    name = ""
    for label in members:
        if label.endswith(_DOCKER_TEST_SUFFIX):
            name = _suite_name(label)
            break
    if not name:
        name = _package(members[0]).rsplit("/", 1)[-1]
    if len(members) > 1:
        name += "+" + str(len(members) - 1)
    return name

def _entry(members):
    return {"name": _group_name(members), "targets": " ".join(members)}

def _group(targets):
    """`targets` binned into at most `_MAX_JOBS` matrix entries.

    Package first, then contiguous chunks within a package: a group is one
    `bazel test` invocation, so its members should be the targets that share an
    analysis and a compile. Grouping across packages would hand one runner two
    unrelated crates to build, and dealing within one would hand two runners
    the same fixture to build twice.

    When there are more packages than the budget the constraint has to give
    somewhere, and it gives on the package boundary rather than on the budget:
    the sorted list is chunked whole, which still keeps each package's targets
    together and still lands inside the concurrency cap.
    """
    if not targets:
        return []

    packages = _packages(targets)
    if len(packages) > _MAX_JOBS:
        return [_entry(members) for members in _chunks(targets, _MAX_JOBS)]

    allocation = _allocate(
        [len(bucket[1]) for bucket in packages],
        [_capacity(bucket[1]) for bucket in packages],
        _MAX_JOBS,
    )

    groups = []
    for index, bucket in enumerate(packages):
        for members in _chunks(bucket[1], allocation[index]):
            groups.append(_entry(members))
    return groups

def _check(condition, message):
    if not condition:
        fail(message)

def _self_test():
    available = [_target(suite) for suite in _mapped_suites().keys()] + [_IMAGE_SUITE_TARGET]

    _check(
        _non_broker_packages([
            "crates/verified/src/composition/tests/epoch_replay.rs",
            "crates/verified/proptest-regressions/composition/tests/epoch_replay.txt",
            "crates/verified/proptest-regressions/composition/tests/stable_fetch.txt",
            "crates/raft/BUILD.bazel",
            "crates/raft/examples/quorum_state.rs",
            "crates/raft/README.md",
            "crates/broker/src/handlers/fetch.rs",
            "docs/KIP_MATRIX.md",
        ]) == ["//crates/raft:all", "//crates/verified:all"],
        "non-broker changes query each owning crate once, including undeclared regression inputs",
    )
    _check(
        _non_broker_packages(["crates/verified/README.md", "crates/broker/Cargo.toml"]) == [],
        "crate documentation and broker feature changes stay out of the non-broker rdeps query",
    )
    _check(
        _requires_full_matrix(
            ["crates/removed/BUILD.bazel", "crates/removed/README.md"],
            ["crates/removed/BUILD.bazel", "crates/removed/README.md"],
        ),
        "a removed crate selects the full matrix before querying its nonexistent package",
    )
    _check(
        _requires_full_matrix(["crates/removed/src/lib.rs"], ["crates/removed/src/lib.rs"]),
        "deleted Rust sources retain the conservative full-matrix fallback",
    )
    _check(
        not _requires_full_matrix(
            ["crates/verified/proptest-regressions/stale.txt"],
            ["crates/verified/proptest-regressions/stale.txt"],
        ),
        "deleting a regression input still queries its existing owning package",
    )

    # The soak lane is scheduled-only. Neither its own sources, nor the crate
    # manifest that selects every other suite, nor the raw query answer the
    # full-matrix run uses may put it in the `docker` matrix -- a four-hour
    # suite in a twelve-way shard would hold the whole nightly open.
    with_soak = available + [_target("soak")]
    _check(
        _select(["crates/broker/tests/soak.rs"], with_soak) == [],
        "the soak suite must not be selected by its own sources",
    )
    _check(
        _select(["crates/broker/tests/soak/drift.rs"], with_soak) == [],
        "the soak suite must not be selected by its helper modules",
    )
    _check(
        _target("soak") not in _select(["crates/broker/BUILD.bazel"], with_soak),
        "the crate manifest selects every suite but the soak one",
    )
    _check(
        _without_own_lane([_target("soak"), _target("jvm_features")]) == [_target("jvm_features")],
        "the full-matrix target list drops the soak suite",
    )
    _check(
        _select(["crates/broker/src/features.rs"], with_soak) == [_target("jvm_features")],
        "excluding the soak suite leaves every other selection alone",
    )
    _check(
        _select(["crates/broker/src/delivery/scheduler.rs"], available) == [_target("jvm_deliver_at_time")],
        "delivery source must select deliver-at-time",
    )
    _check(
        _select(["crates/broker/src/share_partition/state.rs"], available) == [_target("jvm_share_groups")],
        "share source must select share groups",
    )

    # Both streams suites, and neither consumer-group one: the compiled
    # `KafkaStreams` topology and the `StreamsGroupHeartbeat` admin case read
    # the same broker surface, so a change to it has to run both.
    streams_suites = sorted([_target("jvm_streams_app"), _target("jvm_streams_groups")])
    _check(
        _select(["crates/broker/src/coordinator/unified/streams/metadata.rs"], available) == streams_suites,
        "streams source must select both streams suites and not consumer group next-gen",
    )
    _check(
        _select(["crates/broker/src/coordinator/unified/replay_streams.rs"], available) == streams_suites,
        "streams replay source must select both streams suites and not consumer group next-gen",
    )
    _check(
        _select(["crates/broker/src/coordinator/unified/group.rs"], available) == [_target("jvm_consumer_group_next_gen")],
        "unified coordinator source must select consumer group next-gen",
    )
    _check(
        _select(["crates/broker/tests/jvm_acceptance_sasl/plain.rs"], available) == [_target("jvm_acceptance_sasl")],
        "suite test source must select its suite",
    )
    _check(
        _select(["crates/broker/src/handlers/describe_cluster.rs"], available) == [_target("jvm_broker_loggers")],
        "describe-cluster source must select the broker-logger suite, whose non---all describe reads it",
    )
    _check(
        _select(["crates/broker/src/heartbeat/client.rs"], available) ==
        sorted([_target("jbod_enospc"), _target("jvm_role_separated_admin")]),
        "heartbeat source must select the role-separated and real-ENOSPC suites",
    )
    _check(
        _select(["crates/broker/src/metadata_source/quorum_forwarder.rs"], available) == [_target("jvm_role_separated_admin")],
        "the quorum forwarder must select the role-separated suite",
    )
    _check(
        _select(["crates/broker/src/metadata_source/observer_source.rs"], available) == [_target("jvm_role_separated_admin")],
        "the observer metadata source must select the role-separated suite",
    )
    _check(
        _select(["crates/broker/src/handlers/incremental_alter_configs.rs"], available) == [_target("jvm_role_separated_admin")],
        "the incremental config handler must select the role-separated suite",
    )
    _check(
        _select(["crates/broker/src/handlers/produce/append.rs"], available) == [_target("jvm_acceptance_durability")],
        "produce handler source must select the durability suite its appends drive",
    )
    _check(
        sorted(_select(["crates/broker/src/handlers/produce/delivery/gate.rs"], available)) ==
        sorted([_target("jvm_acceptance_durability"), _target("jvm_deliver_at_time")]),
        "the produce delivery gate must keep its own suite and gain the durability one",
    )
    _check(
        _select(["crates/broker/src/handlers/offline_replicas.rs"], available) == [_target("unavailable_partitions_jvm")],
        "the offline-replica projection must select the unavailable-partitions differential",
    )
    _check(
        _select(["crates/broker/src/handlers/describe_topic_partitions.rs"], available) == [_target("unavailable_partitions_jvm")],
        "the DescribeTopicPartitions projection must select the unavailable-partitions differential",
    )
    _check(
        _select(["crates/broker/src/handlers/describe_configs/entry.rs"], available) == [_target("jvm_acceptance_cli")],
        "the DescribeConfigs entry builder must select the CLI suite that reads its synonyms",
    )
    _check(
        _target("jvm_bootstrap_controller") in _select(["crates/broker/src/controller_admin.rs"], available),
        "the controller admin router must select the bootstrap-controller suite",
    )
    _check(
        _target("jvm_acceptance_cli") in _select(["crates/broker/src/handlers/delete_topics.rs"], available),
        "the DeleteTopics handler must select the CLI suite whose delete case covers it",
    )
    _check(
        _target("jvm_acceptance_cli") in _select(["crates/broker/src/config_keys/registry.rs"], available),
        "the config-key registry must select the CLI suite that renders its defaults and types",
    )
    _check(
        _target("unavailable_partitions_jvm") in _select(["crates/broker/src/handlers/broker_heartbeat/failover.rs"], available),
        "the offline-dir failover path must select the unavailable-partitions differential",
    )
    _check(
        _select(["packaging/BUILD.bazel"], available) ==
        sorted([_IMAGE_SUITE_TARGET, _target("jbod_enospc"), _target("process_kill_durability")]),
        "a change to the image's layer list must select the image suite and the suites that run it",
    )
    _check(
        _select(["packaging/image_binaries_test.sh"], available) ==
        sorted([_IMAGE_SUITE_TARGET, _target("jbod_enospc"), _target("process_kill_durability")]),
        "a change to what the image asserts must select the image suite and the suites that run it",
    )
    _check(
        sorted(_select(["packaging/base.apko.yaml", "crates/broker/src/barrier/cut.rs"], available)) ==
        sorted([
            _IMAGE_SUITE_TARGET,
            _target("jbod_enospc"),
            _target("process_kill_durability"),
            _target("jvm_barrier_markers"),
        ]),
        "a change to both must select both",
    )
    _check(
        _select(["crates/broker/tests/process_kill_durability.rs"], available) == [_target("process_kill_durability")],
        "the kill suite's own source must select it, and nothing else",
    )
    _check(
        _select(["crates/broker/tests/jbod_enospc.rs"], available) == [_target("jbod_enospc")],
        "the real-ENOSPC suite's own source must select it, and nothing else",
    )
    _check(
        _target("jbod_enospc") in _select(["crates/broker/src/partition_writer/produce.rs"], available),
        "the storage-failure write path must select the real-ENOSPC suite",
    )
    _check(
        _target("process_kill_durability") in _select(["crates/log/src/recovery.rs"], available),
        "open-time tail recovery must select the suite that kills a broker and reopens its log",
    )
    _check(
        _IMAGE_SUITE_TARGET not in _select(["crates/log/src/recovery.rs"], available),
        "a log source edit must not build an image; it cannot change what the image carries",
    )
    _check(_select(["crates/broker/src/codes.rs"], available) == [], "unmapped broker source must select nothing")
    _check(
        _IMAGE_SUITE_TARGET not in _select(["crates/broker/src/barrier/cut.rs"], available),
        "a broker source edit must not build an image; it cannot add a dynamic dependency",
    )
    _check(
        _IMAGE_SUITE_TARGET in _select(["crates/broker/Cargo.toml"], available),
        "the broker manifest must select the image suite, which links against the base's libc",
    )
    _check(
        len(_select(["crates/broker/Cargo.toml"], available)) == len(available),
        "broker manifest must select every suite",
    )

    _group_self_test()

def _padded(index):
    """`index` as at least two digits, so the names sort the way they count."""
    text = str(index)
    return text if len(text) > 1 else "0" + text

def _synthetic_name(index):
    return "suite_" + _padded(index)

def _synthetic_targets(package, count):
    """`count` container suites in `package`, named so their sorted order shows."""
    return [
        package + ":" + _synthetic_name(index) + _DOCKER_TEST_SUFFIX
        for index in range(count)
    ]

def _members(groups):
    """Every label the groups carry, in the order the grouping put them."""
    labels = []
    for group in groups:
        for label in group["targets"].split(" "):
            labels.append(label)
    return labels

def _sizes(groups):
    return [len(group["targets"].split(" ")) for group in groups]

def _group_self_test():
    _check(_group([]) == [], "an empty selection must produce no matrix entries at all")
    _check(
        _group([_target("jvm_features")]) ==
        [{"name": "jvm_features", "targets": _target("jvm_features")}],
        "a lone target must be its own group under its own suite name",
    )

    # Below the cap nothing is grouped: a target per entry is what makes a red
    # check name exactly one suite, and it is worth keeping wherever it fits.
    few = _synthetic_targets(_BROKER_PACKAGE, 3)
    _check(
        _group(few) == [
            {"name": _synthetic_name(index), "targets": few[index]}
            for index in range(3)
        ],
        "a selection below the cap must stay one target per entry",
    )

    exactly = _synthetic_targets(_BROKER_PACKAGE, _MAX_JOBS)
    _check(
        [group["targets"] for group in _group(exactly)] == exactly,
        "a selection at the cap must fill it exactly, one target per entry",
    )
    _check(
        [group["name"] for group in _group(exactly)] == [_synthetic_name(i) for i in range(_MAX_JOBS)],
        "at the cap every group must still be named for the one suite it runs",
    )

    _the_sorted_list_buckets_by_package()
    _one_package_is_chunked_contiguously()
    _packages_get_the_budget_in_proportion()
    _a_fixture_package_is_never_subdivided()
    _more_packages_than_the_budget_share_groups()
    _a_group_without_a_suite_is_named_for_its_package()

def _the_sorted_list_buckets_by_package():
    # `//crates/broker/tests/...` sorts before `//crates/broker:...`, because
    # `/` is below `:`. The bucketing relies on nothing but each package's
    # labels being contiguous, which a sorted list guarantees whatever order
    # the packages themselves come out in.
    fixture = "//crates/broker/tests/fixtures/security/kdc"
    targets = sorted(
        _synthetic_targets(_BROKER_PACKAGE, 2) + [fixture + ":base", fixture + ":image"],
    )
    _check(
        _packages(targets) == [
            [fixture, [fixture + ":base", fixture + ":image"]],
            [_BROKER_PACKAGE, _synthetic_targets(_BROKER_PACKAGE, 2)],
        ],
        "the bucketing must split the sorted list at its package boundaries",
    )

def _one_package_is_chunked_contiguously():
    # Two full chunks and one over, so the first group takes three targets and
    # the rest take two. What matters is that each group's members are
    # neighbours: they are the targets that share a crate, and a group is one
    # `bazel test` invocation, so neighbours are what a group is for.
    many = _synthetic_targets(_BROKER_PACKAGE, _MAX_JOBS * 2 + 1)
    groups = _group(many)
    _check(len(groups) == _MAX_JOBS, "no selection may produce more entries than the concurrency cap")
    _check(len(_members(groups)) == len(many), "no target may be put in two groups")
    _check(sorted(_members(groups)) == many, "every selected target must appear in exactly one group")
    _check(_members(groups) == many, "a package's targets must be chunked in order, not dealt out")
    _check(_sizes(groups) == [3] + [2] * (_MAX_JOBS - 1), "chunks must differ by at most one target")
    _check(
        groups[0]["targets"] == " ".join(many[0:3]),
        "a group's members must be contiguous in the sorted list",
    )
    _check(
        groups[0]["name"] == _synthetic_name(0) + "+2",
        "a group of three must name its first suite and count the two behind it",
    )
    _check(
        groups[1]["name"] == _synthetic_name(3) + "+1",
        "a group of two must name its first suite and count the one behind it",
    )

def _packages_get_the_budget_in_proportion():
    # The shape of the real selection: one large package beside several small
    # ones. Each small package must keep a group of its own -- grouping across
    # packages is what hands one runner two unrelated crates to build -- and
    # the large one must take everything the small ones leave.
    big = _synthetic_targets(_BROKER_PACKAGE, 24)
    small = [
        "//crates/log:integration" + _DOCKER_TEST_SUFFIX,
        "//crates/raft:kraft" + _DOCKER_TEST_SUFFIX,
        "//packaging:image" + _DOCKER_TEST_SUFFIX,
    ]
    groups = _group(sorted(big + small))
    _check(len(groups) == _MAX_JOBS, "the budget must be spent, not exceeded")
    _check(sorted(_members(groups)) == sorted(big + small), "every target must survive the allocation")
    for group in groups:
        packages = {_package(label): True for label in group["targets"].split(" ")}
        _check(len(packages) == 1, "no group may straddle two packages while the budget allows")
    _check(
        _sizes(groups) == [3, 3, 3, 3, 3, 3, 2, 2, 2, 1, 1, 1],
        "the large package must take every group the small ones cannot use",
    )

def _a_fixture_package_is_never_subdivided():
    # The real selection's shape. The fixture package's five targets are the
    # layers of one image and not five suites, so however many seats its target
    # count wins it takes one group: splitting it is what had five runners each
    # building a piece of the same KDC image. The seats it cannot spend go to
    # the package that can.
    fixture = "//crates/broker/tests/fixtures/security/kdc"
    layers = [fixture + ":" + name for name in ["base", "base_oci", "image", "image_load", "seed_layer"]]
    suites = _synthetic_targets(_BROKER_PACKAGE, 25)
    singles = [
        "//crates/log:integration" + _DOCKER_TEST_SUFFIX,
        "//crates/raft:kraft" + _DOCKER_TEST_SUFFIX,
        "//crates/remote-storage:tiered" + _DOCKER_TEST_SUFFIX,
        "//packaging:image" + _DOCKER_TEST_SUFFIX,
    ]
    groups = _group(sorted(layers + suites + singles))
    _check(len(groups) == _MAX_JOBS, "the whole-repository selection must fit the budget exactly")
    _check(
        sorted(_members(groups)) == sorted(layers + suites + singles),
        "every target must survive the whole-repository grouping",
    )
    _check(
        groups[0] == {"name": "kdc+4", "targets": " ".join(layers)},
        "a package of image layers must stay one group whatever the budget allows",
    )
    _check(
        _sizes(groups) == [5, 4, 4, 4, 4, 3, 3, 3, 1, 1, 1, 1],
        "the seats the fixture cannot spend must go to the package that can",
    )

def _more_packages_than_the_budget_share_groups():
    # Thirteen packages, twelve groups. The package boundary is what gives, not
    # the concurrency cap: a matrix over the cap does not run wider, it runs in
    # two waves, which is the failure this whole grouping exists to avoid.
    targets = sorted([
        "//crates/pkg" + _padded(index) + ":suite" + _DOCKER_TEST_SUFFIX
        for index in range(_MAX_JOBS + 1)
    ])
    groups = _group(targets)
    _check(len(groups) == _MAX_JOBS, "more packages than the budget must still fit inside it")
    _check(sorted(_members(groups)) == targets, "sharing a group must not drop a target")
    _check(_members(groups) == targets, "a shared group's members must be contiguous in the sorted list")
    _check(_sizes(groups) == [2] + [1] * (_MAX_JOBS - 1), "only as many groups as needed may share")

def _a_group_without_a_suite_is_named_for_its_package():
    # The fixture-image package: its targets are the layers of one image, named
    # `base` and `image_load`, which say nothing on their own. A check named
    # for the package is what tells a reviewer which fixture went red.
    fixture = "//crates/broker/tests/fixtures/security/kdc"
    layers = [fixture + ":" + name for name in ["base", "base_oci", "image", "image_load", "seed_layer"]]
    _check(
        _group(layers) == [{"name": "kdc+4", "targets": " ".join(layers)}],
        "a package with no container suite in it must be named for the package",
    )
    _check(
        _group([fixture + ":base"]) == [{"name": "kdc", "targets": fixture + ":base"}],
        "a lone non-suite target must be named for its package, with no count",
    )
    _check(
        _group_name([fixture + ":base", _target("jvm_features")]) == "jvm_features+1",
        "a group holding a container suite must be named for the suite, not the package",
    )

def _is_build_wide(path):
    return path in ["MODULE.bazel", ".bazelrc", "Cargo.lock", "Cargo.toml"] or path.startswith("bazel/")

def _is_deleted_source(path):
    return path.startswith("crates/") and (
        path.endswith(".rs") or
        path.endswith("/Cargo.toml") or
        path.endswith("/BUILD.bazel")
    )

def _requires_full_matrix(changed, deleted):
    for path in changed:
        if _is_build_wide(path):
            return True
    for path in deleted:
        if _is_deleted_source(path):
            return True
    return False

def _non_broker_packages(paths):
    """Owning crate target patterns for non-broker changes.

    Rust targets are defined at crate granularity. Not every on-disk input is
    also a declared Bazel source target: proptest regression files, for
    example, need not be exported by BUILD.bazel. Querying their paths directly
    aborts selection. The owning package's rules are stable query roots and
    conservatively include every container suite affected by the crate.
    """
    packages = {}
    for path in paths:
        if (
            path.startswith("crates/") and
            not path.startswith("crates/broker/") and
            not path.endswith(".md")
        ):
            parts = path.split("/")
            if len(parts) >= 3:
                packages["//crates/" + parts[1] + ":all"] = True
    return sorted(packages.keys())

def _affected_targets(ctx, base):
    all_targets = _without_own_lane(sorted(run(ctx, "bazel", ["query", "attr(tags, 'docker', " + _SUITE_SCOPE + ")"])))
    if not valid_base(ctx, base):
        return all_targets

    comparison = base + "...HEAD"
    changed = run(ctx, "git", ["diff", "--name-only", comparison])
    deleted = run(ctx, "git", ["diff", "--diff-filter=D", "--name-only", comparison])
    if _requires_full_matrix(changed, deleted):
        return all_targets

    targets = {}
    for label in _select(changed, all_targets):
        targets[label] = True

    # Non-broker crates go through rdeps. Six of them build a binary the image
    # carries, so the scope is what makes a change to `krabka-format` or
    # `krabka-restore` select the image suite as well as the JVM ones.
    packages = _non_broker_packages(changed)
    if packages:
        expression = "attr(tags, 'docker', rdeps(" + _SUITE_SCOPE + ", set(" + " ".join(packages) + ")))"
        for label in _without_own_lane(run(ctx, "bazel", ["query", expression])):
            targets[label] = True

    return sorted(targets.keys())

def _emit(ctx, targets):
    # `targets` is a space-separated string rather than a list because the
    # workflow hands it straight to one `bazel test` invocation: a group of
    # suites is one Bazel command, which shares the analysis phase and the
    # runner's warm cache across the suites in it instead of paying for both
    # once per suite.
    encoded = json.encode(_group(targets))
    github_output = ctx.std.env.var("GITHUB_OUTPUT")
    if github_output:
        record = "suites=" + encoded + "\nany=" + ("true" if targets else "false") + "\n"
        if not ctx.std.fs.try_append(github_output, record):
            fail("could not append container suites to GITHUB_OUTPUT")
    print("Selected: " + encoded)

def _impl(ctx: TaskContext) -> int:
    _self_test()
    if not ctx.args.self_test:
        _emit(ctx, _affected_targets(ctx, ctx.args.base))
    return 0

container_suites = task(
    summary = "Select the affected container suites; without --base, select all.",
    implementation = _impl,
    args = {
        "base": args.string(
            default = "",
            description = "Git commit to compare with HEAD.",
        ),
        "self_test": args.boolean(
            default = False,
            description = "Run the selector's embedded tests without querying Bazel or Git.",
        ),
    },
)
