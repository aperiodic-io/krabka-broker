"""Reject Rust duplicates with pinned jscpd on the complete Git inventory."""

MINIMUM_TOKENS = 47
MINIMUM_LINES = 5

def rust_paths(nul_separated):
    return sorted({path: True for path in nul_separated.split("\x00") if path.endswith(".rs")})

def _capture(ctx, argv, root):
    result = ctx.std.process.command(argv[0]).args(argv[1:]).current_dir(root).stdout("piped").stderr("piped").spawn().wait_with_output()
    if result.status.code != 0:
        fail("%s failed:\n%s" % (" ".join(argv), result.stderr))
    return result.stdout

def _run(ctx, argv, root):
    return ctx.std.process.command(argv[0]).args(argv[1:]).current_dir(root).spawn().wait().code

def _must(ctx, argv, root):
    if _run(ctx, argv, root) != 0:
        fail("command failed: %s" % " ".join(argv))

def snapshot_sources(ctx, work, root):
    candidate = work + "/sources"
    ctx.std.fs.create_dir_all(candidate)
    tracked = _capture(ctx, ["git", "ls-files", "--stage", "-z", "--", "*.rs"], root)
    if any([entry.startswith("120000 ") for entry in tracked.split("\x00") if entry]):
        fail("Rust symlinks are unsupported; CPD must read every source file")
    paths = rust_paths(_capture(ctx, ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "*.rs"], root))
    deleted = rust_paths(_capture(ctx, ["git", "diff", "--name-only", "--diff-filter=D", "-z", "HEAD", "--", "*.rs"], root))
    copied = []
    for path in paths:
        source = root + "/" + path
        if not ctx.std.fs.exists(source):
            if path not in deleted:
                fail("missing Rust source: %s (sparse checkouts are unsupported)" % path)
            continue
        if _run(ctx, ["test", "-L", source], root) == 0 or not ctx.std.fs.metadata(source).is_file:
            fail("unsupported candidate Rust source: %s" % path)
        destination = candidate + "/" + path
        ctx.std.fs.create_dir_all(destination.rsplit("/", 1)[0])
        ctx.std.fs.copy(source, destination)
        copied.append(path)
    if not copied:
        fail("no Rust sources in the Git inventory")
    return candidate, copied

def detector_args(config, source, output, minimum_tokens = MINIMUM_TOKENS):
    return [
        "--config",
        config,
        "--format",
        "rust",
        "--mode",
        "weak",
        "--min-tokens",
        str(minimum_tokens),
        "--min-lines",
        str(MINIMUM_LINES),
        "--max-size",
        "100mb",
        "--max-lines",
        "1000000",
        "--no-gitignore",
        "--fail-on-empty",
        "--exit-code",
        "1",
        "--reporters",
        "console,json",
        "--output",
        output,
        source,
    ]

def repository_report(report, sources, root):
    """Keep JSON locations usable after the temporary snapshot is removed."""
    for clone in report.get("duplicates", []):
        for field in ["firstFile", "secondFile"]:
            location = clone[field]
            name = location["name"]
            prefix = sources + "/"
            if name.startswith(prefix):
                location["name"] = root + "/" + name[len(prefix):]
    return report

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.bazel_root_dir()
    work = ctx.std.fs.mkdtemp(prefix = "krabka-jscpd-")
    ctx.defer(ctx.std.fs.remove_dir_all, work)
    sources, paths = snapshot_sources(ctx, work, root)
    output = ctx.args.output if ctx.args.output.startswith("/") else root + "/" + ctx.args.output
    ctx.std.fs.create_dir_all(output)
    ctx.std.fs.write(output + "/source-inventory.json", json.encode(paths) + "\n")
    detector, config = prepare_detector(ctx, work, root)
    path = output + "/jscpd-report.json"
    if ctx.std.fs.exists(path):
        ctx.std.fs.remove_file(path)
    status = _run(ctx, detector + detector_args(config, sources, output), root)
    if ctx.std.fs.exists(path):
        report = repository_report(json.decode(ctx.std.fs.read_to_string(path)), sources, root)
        ctx.std.fs.write(path, json.encode(report) + "\n")
    return status

def prepare_detector(ctx, work, root):
    # npm ci verifies every artifact against the committed lockfile integrity.
    for name in ["package.json", "package-lock.json"]:
        ctx.std.fs.copy(root + "/tools/cpd/" + name, work + "/" + name)
    _must(ctx, ["npm", "ci", "--no-audit", "--no-fund", "--ignore-scripts", "--prefix", work], root)

    # An explicit empty config prevents a local .jscpd.json from relaxing CI.
    config = work + "/config.json"
    ctx.std.fs.write(config, "{}\n")
    return ["node", work + "/node_modules/jscpd/run-jscpd.js"], config

check_cpd = task(
    summary = "Reject Rust duplicates with pinned jscpd",
    implementation = _impl,
    args = {
        "output": args.string(default = ".cpd", description = "Directory for jscpd reports and the Rust source inventory."),
    },
)
