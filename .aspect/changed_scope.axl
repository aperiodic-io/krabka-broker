"""Decide whether a change reaches the Rust build or its test inputs.

CI uses this decision to skip coverage on documentation-only pull requests.
Build, Clippy and daemon-free tests still run. A KFC, style guide, README or
workflow change usually cannot move the coverage numbers; source, build rules
and test fixtures can.

This task asks whether anything in the diff reaches the Rust build.
`container-suites` separately answers which container suites a change needs.
A wrong answer here could omit a useful coverage run, so the rules are
deliberately generous: a file counts
if it plausibly reaches a compiler, a linker, a Bazel rule or a test fixture,
and only a `.md` under `crates/` is carved back out.

It fails open. An unresolvable `--base` -- an empty one, a shallow clone that
does not reach the merge base, a branch force-pushed out from under the runner
-- means the diff is unknown, and an unknown diff runs coverage. The cost of
being wrong in that direction is one slower pull request; the other direction
can hide a coverage regression.

    aspect changed-scope --base origin/main
"""

load("./changes.axl", "run", "valid_base")
load("./repo.axl", "starts_with_any")

# Root files that redefine the build for every crate at once: the workspace
# manifest and its lock, the Bazel module the `@crates` repo is generated from
# and its resolved graph, the flags every `bazel` invocation inherits, the two
# pinned toolchains, the lint and format configuration those toolchains read,
# and the coverage upload's own settings. None of these is a `.rs` file and
# every one of them can change what a Rust job produces or where its result
# goes.
BUILD_FILES = [
    ".bazelrc",
    ".bazelversion",
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "clippy.toml",
    "codecov.yml",
    "rust-toolchain.toml",
    "rustfmt.toml",
]

# Directories that feed the build without being crates. `bazel/` holds the rule
# definitions every `BUILD.bazel` calls, `packaging/` builds the image the
# container suites load, and `tools/` holds the lint aspects and the toolchains
# the actions run under. An edit in any of them changes what a Rust job does
# without touching a `.rs` file.
BUILD_PREFIXES = ["bazel/", "packaging/", "tools/"]

# Generated artifacts and example configs that live under `docs/` but are Rust
# test inputs. `crates/broker/BUILD.bazel` names every one of them in the
# `data` of its test targets, where `config_reference`, `docgen_contract`,
# `example_broker_toml` and `metrics_contract` read them back and compare or
# parse them against what the code produces.
#
# They have to be listed because the `crates/` rule below cannot see them, and
# the `.md` carve-out would drop `config-reference.md` even if it could.
# These inputs can change test behavior and coverage, so they need the same
# scope decision as source changes. The `ci` job's daemon-free tests run their
# Rust contract checks even when coverage is skipped. Regenerating the
# reference *from* the schema alone does not compare it against `FileConfig`.
#
# The two directories are whole prefixes rather than the seven exact files, so
# that a file added to one of those `data` attributes is covered before anyone
# remembers this list exists.
# `bench/scenarios/` is the same kind of input from outside `docs/`:
# `crates/bench-driver/BUILD.bazel` names `//bench:scenarios` in the `data` of
# its test targets, and `scenario_files` loads every one of those YAML files
# through the driver's own `Scenario` type. A scenario edited alone must
# therefore qualify for coverage just as a test-source change does.
DATA_FILES = ["docs/config-reference.md", "docs/config-schema.json"]
DATA_PREFIXES = ["bench/scenarios/", "docs/examples/", "docs/operations/"]

# Where the code is. Everything under it counts except documentation: a crate's
# README and changelog are checked by their own tasks, which do not need a
# compiler.
SOURCE_PREFIX = "crates/"
DOC_SUFFIX = ".md"

def touches_rust(paths):
    """Whether any of `paths` can change what the Rust build or its tests do."""
    for raw_path in paths:
        path = raw_path.strip().replace("\\", "/")
        if not path:
            continue
        if path in BUILD_FILES or path in DATA_FILES:
            return True
        if starts_with_any(path, BUILD_PREFIXES) or starts_with_any(path, DATA_PREFIXES):
            return True
        if path.startswith(SOURCE_PREFIX) and not path.endswith(DOC_SUFFIX):
            return True
    return False

def decide(base_resolved, paths):
    """Whether coverage should run, given a diff that may not exist.

    `base_resolved` is whether Git could turn the `--base` this task was handed
    into a commit. When it could not, `paths` says nothing about the change and
    the conservative answer is to run coverage: this is the fail-open case, and it
    is a branch of its own rather than an empty list flowing through
    `touches_rust`, because an empty diff and an unknown diff are opposite
    answers.
    """
    if not base_resolved:
        return True
    return touches_rust(paths)

def _changed(ctx, base):
    """`(base resolved, changed paths)` for the diff against `base`.

    The comparison is `base...HEAD`, the same one `container-suites` uses, so
    the two tasks are never gating on different sets of files: it is the diff
    from the merge base, which is what the pull request actually proposes
    rather than everything that has landed on the target branch since.
    """
    if not valid_base(ctx, base):
        return False, []
    return True, run(ctx, "git", ["diff", "--name-only", base + "...HEAD"])

def _impl(ctx: TaskContext) -> int:
    resolved, paths = _changed(ctx, ctx.args.base)
    value = "true" if decide(resolved, paths) else "false"

    github_output = ctx.std.env.var("GITHUB_OUTPUT")
    if github_output:
        if not ctx.std.fs.try_append(github_output, "rust=" + value + "\n"):
            fail("could not append the changed scope to GITHUB_OUTPUT")

    # The reason, not just the verdict: a job that was skipped is invisible in
    # the run summary, so the log of the step that skipped it is the only place
    # anyone can find out why.
    reason = "the diff reaches the Rust build" if value == "true" else "nothing in the diff reaches the Rust build"
    if not resolved:
        reason = "no resolvable --base, so the diff is unknown"
    ctx.std.io.stdout.write("rust=%s (%s)\n" % (value, reason))
    return 0

changed_scope = task(
    summary = "Decide whether a change needs the Rust build and test jobs",
    implementation = _impl,
    args = {
        "base": args.string(
            default = "",
            description = "Git commit to compare with HEAD.",
        ),
    },
)
